  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Opciones m\xE1s neutras / informativas\n\n\u201CAs\xED van reaccionando
    tus grupos\u2026\u201D\n\u201CEstas son las consecuencias de tus elecciones hasta
    ahora\u201D\n\u201CMira c\xF3mo han respondido tus contactos\u201D\n\u201CTus
    decisiones est\xE1n dejando huella\u2026\u201D\n\nOpciones con tono de juego
    / reto\n\n\u201C\xA1Tus elecciones ya est\xE1n moviendo la balanza!\u201D\n\u201CCada
    reacci\xF3n cuenta\u2026 as\xED vas acumulando influencia\u201D\n\u201CTu red
    ya empieza a mostrar su confianza (o desconfianza)\u201D\n\u201CLos grupos hablan:
    este es tu impacto por ahora\u201D\n\nOpciones m\xE1s motivadoras / reflexivas\n\n\u201CTus
    mensajes generan confianza\u2026 o dudas. As\xED vas hasta ahora.\u201D\n\u201CLa
    influencia es fr\xE1gil, f\xEDjate en c\xF3mo cambia con cada noticia.\u201D\n\u201CCada
    click tiene consecuencias. Este es tu balance por ahora.\u201D\n\u201CMira lo
    que has conseguido\u2026 \xBFqu\xE9 har\xE1s en la pr\xF3xima jugada?\u201D"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
