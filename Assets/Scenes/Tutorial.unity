  m_Script: {fileID: 11500000, guid: f9790f57c6ee0314d86e48878f161e27, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  DEBUGGING_TUTORIAL: 0
  STARTING_STEP: 7
  _waitFactor: 0.01
  _articlePrefab: {fileID: 2886181202921935733, guid: da99b3262ab2bf44998fb26cd407e53d, type: 3}
  _chat: {fileID: 0}
  _messageToUser: {fileID: 1615427032}
  _fader: {fileID: 90100630}
  _nextStepButton: {fileID: 955982174}
  _backStepButton: {fileID: 0}
  _data: {fileID: 11400000, guid: 6981ef247a64e6447ae303da26cfc956, type: 2}
  _scrollRect: {fileID: 614484551}
  OnTutorialEnd:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 326032685}
        m_TargetAssemblyTypeName: PlayButton, Assembly-CSharp
        m_MethodName: goGeneralScene
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: ChatDemo
          m_BoolArgument: 0
        m_CallState: 2
  _messageSteps:
  - messages:
    - "\xA1Te damos la bienvenida a Level Up!"
    - "En esta secci\xF3n, te daremos las INSTRUCCIONES de c\xF3mo jugar"
    - "Te ense\xF1aremos la Zona de Art\xEDculos. Ah\xED podr\xE1s enterarte de las
      nuevas noticias"
    nextStepCondition:
      targetObject: {fileID: 326032684}
      methodName: DontStopStep
      parameters: []
    onMessagesStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1865468024}
          m_TargetAssemblyTypeName: ArticleDataSetter, Assembly-CSharp
          m_MethodName: SetUpButtons
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    onMessagesEnd:
      m_PersistentCalls:
        m_Calls: []
  - messages:
    - "Aqu\xED puedes ver m\xFAltiples art\xEDculos de peri\xF3dico"
    - "Puedes ver el t\xEDtulo y una imagen relacionada."
    - "Tambi\xE9n, utilizando tu dedo, puedes moverte por esta pantalla"
    - "Si lo deslizas hacia arriba, ver\xE1s m\xE1s art\xEDculos en la parte inferior"
    - "Si deslizas el dedo hacia abajo, volver\xE1s a los art\xEDculos anteriores"
    - "\xA1Pru\xE9balo!"
    nextStepCondition:
      targetObject: {fileID: 326032684}
      methodName: HasMovedScrollRect
      parameters: []
    onMessagesStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 326032684}
          m_TargetAssemblyTypeName: TutorialController, Assembly-CSharp
          m_MethodName: FadeIn
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    onMessagesEnd:
      m_PersistentCalls:
        m_Calls: []
  - messages:
    - Ahora te mostramos los botones de los articulos
    - "De momento no puedes pulsarlos, pero poco a poco te los iremos ense\xF1ando"
    nextStepCondition:
      targetObject: {fileID: 326032684}
      methodName: DontStopStep
      parameters: []
    onMessagesStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 326032684}
          m_TargetAssemblyTypeName: TutorialController, Assembly-CSharp
          m_MethodName: FadeOut
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
        - m_Target: {fileID: 326032684}
          m_TargetAssemblyTypeName: TutorialController, Assembly-CSharp
          m_MethodName: ShowArticleButtonsDisabled
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    onMessagesEnd:
      m_PersistentCalls:
        m_Calls: []
  - messages:
    - "El primero de todos es el de arriba a la derecha, el bot\xF3n \"Saltar\""
    - "Con esto bot\xF3n nos dices que el art\xEDculo NO te interesa, as\xED que
      desaparecer\xE1 de aqu\xED"
    - "\xA1Prueba a pulsarlo!"
    nextStepCondition:
      targetObject: {fileID: 326032684}
      methodName: HasSkippedArticle
      parameters: []
    onMessagesStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 326032684}
          m_TargetAssemblyTypeName: TutorialController, Assembly-CSharp
          m_MethodName: HighlightSkipButtons
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    onMessagesEnd:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 326032684}
          m_TargetAssemblyTypeName: TutorialController, Assembly-CSharp
          m_MethodName: FadeIn
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
        - m_Target: {fileID: 326032684}
          m_TargetAssemblyTypeName: TutorialController, Assembly-CSharp
