          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - messages:
    - "El siguiente es el bot\xF3n \"LEER\""
    - "Al pulsar este bot\xF3n, se ver\xE1 m\xE1s informaci\xF3n acerca del art\xEDculo"
    - "Podr\xE1s leerla para informarte bien de qu\xE9 dice y de d\xF3nde saca su
      informaci\xF3n"
    - "\xA1Pru\xE9balo!"
    nextStepCondition:
      targetObject: {fileID: 326032684}
      methodName: HasReadArticle
      parameters: []
    onMessagesStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 326032684}
