            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - messages:
    - "\xA1Genial!"
    - "Ahora que has le\xEDdo el art\xEDculo ya sabes realmente qu\xE9 trata."
    - Probaremos entonces a compartirlo con tus grupos cercanos.
    - Estos grupos NO SON REALES.
    - Son parte del juego, donde tratamos de simular el uso de redes sociales como
      WhatsApp.
    - "El tercer y \xFAltimo bot\xF3n que tenemos disponible es el de \"Compartir\""
    nextStepCondition:
      targetObject: {fileID: 326032684}
      methodName: DontStopStep
