            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
        - m_Target: {fileID: 326032684}
          m_TargetAssemblyTypeName: TutorialController, Assembly-CSharp
          m_MethodName: UnhighlightSkipButtons
