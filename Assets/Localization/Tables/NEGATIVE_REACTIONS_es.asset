  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: NEGATIVE_REACTIONS_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 6f40342b7faca6a41985092112ffbc7d, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16778715136
    m_Localized: "\xBFTe crees estas cosas?"
    m_Metadata:
      m_Items: []
  - m_Id: 16803880960
    m_Localized: "Esto no tiene sentido, \xBFlo has le\xEDdo?"
    m_Metadata:
      m_Items: []
  - m_Id: 16803880961
    m_Localized: No mandes estas cosas, por favor.
    m_Metadata:
      m_Items: []
  - m_Id: 16803880962
    m_Localized: 'No entiendo esto, no me mandes estas cosas. '
    m_Metadata:
      m_Items: []
  - m_Id: 16808075264
    m_Localized: 'No me lo creo. '
    m_Metadata:
      m_Items: []
  - m_Id: 16808075265
    m_Localized: 'Esto es una basura. '
    m_Metadata:
      m_Items: []
  - m_Id: 16808075266
    m_Localized: Mentira. Es mentira. No compartas esto.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075267
    m_Localized: Estas noticias me molestan, no creo que sea verdad.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075268
    m_Localized: No me gusta leer noticias de este tipo.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075269
    m_Localized: "Esto est\xE1 mal. Yo no lo veo as\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075270
    m_Localized: No nos mandes esto, no nos gusta.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075271
    m_Localized: "No estoy de acuerdo. Esto est\xE1 mal."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075272
    m_Localized: No, no, y no.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075273
    m_Localized: Me desagrada leer estas cosas.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075274
    m_Localized: 'Nooo, no compartas esto, por favor. '
    m_Metadata:
      m_Items: []
  - m_Id: 16808075275
    m_Localized: Creo que esto es un fake. No es verdad.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075276
    m_Localized: Ya he recibido esto y creo que es mentira.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075277
    m_Localized: "Esta informaci\xF3n es sesgada. Creo que no voy a leerlo."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075278
    m_Localized: "\xA1Vaya trola de art\xEDculo!"
    m_Metadata:
      m_Items: []
  - m_Id: 16808075279
    m_Localized: "Esto es una tonter\xEDa, no hace falta m\xE1s que ver el titular."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075280
    m_Localized: "\xBFDe verdad lees estas cosas? Tienes que tener m\xE1s cuidado."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075281
    m_Localized: "Se ha demostrado que esto es falso, por favor no lo compartas m\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075282
    m_Localized: "\xA1Esto es pura manipulaci\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 16808075283
    m_Localized: Las cosas que se inventa la gente para que se hagan virales... No
      te lo creas.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075284
    m_Localized: Estas noticias me dejan mal cuerpo.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075285
    m_Localized: "Este art\xEDculo no me gusta nada."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075286
    m_Localized: "\xBFPor qu\xE9 nos mandas esto?"
    m_Metadata:
      m_Items: []
  - m_Id: 16808075287
    m_Localized: "Ya no s\xE9 qu\xE9 creerme y qu\xE9 no."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075288
    m_Localized: "\xBFEn qu\xE9 mundo vivimos?"
    m_Metadata:
      m_Items: []
  - m_Id: 16808075289
    m_Localized: Esto es preocupante.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075290
    m_Localized: "\xA1Qu\xE9 miedo da todo!"
    m_Metadata:
      m_Items: []
  - m_Id: 16808075291
    m_Localized: "Ya no s\xE9 qu\xE9 pensar, de verdad."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075292
    m_Localized: No me convence esto.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075293
    m_Localized: No lo tengo muy claro.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
