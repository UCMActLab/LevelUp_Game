%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TUTORIAL_STEPS_cs
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: cs
  m_SharedData: {fileID: 11400000, guid: 22cb33751284c934dbba25f1e0393930, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 11980431360
    m_Localized: "Nau\u010D\xEDme se, jak tento program pou\u017E\xEDvat."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597184
    m_Localized: "Pod\xEDv\xE1me se na prvn\xED \u010Dl\xE1nek. Tady je titulek."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597185
    m_Localized: "Pro v\xEDce informac\xED si p\u0159e\u010Dt\u011Bte \u010Dl\xE1nek"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597186
    m_Localized: "A to m\u016F\u017Eeme ud\u011Blat jedn\xEDm tla\u010D\xEDtkem..."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597187
    m_Localized: "Klikn\u011Bte na tla\u010D\xEDtko \u201E\u010C\xEDst\u201C a p\u0159e\u010Dt\u011Bte
      si \u010Dl\xE1nek."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597188
    m_Localized: "Jak se v\xE1m \u010Dl\xE1nek l\xEDbil?"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597189
    m_Localized: "Vyberte si mo\u017Enost stisknut\xEDm po\u017Eadovan\xE9ho tla\u010D\xEDtka."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597190
    m_Localized: "Tento \u010Dl\xE1nek je \u201Ehoaxem\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597191
    m_Localized: Jsou formou dezinformace.
    m_Metadata:
      m_Items: []
  - m_Id: 11282912289460224
    m_Localized: "V\xFDborn\u011B! P\u0159e\u010Detl(a) jste si \u010Dl\xE1nek a
      ozna\u010Dil(a) jste jej jako \u201Ehoax\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820352
    m_Localized: "Hmm... Jak jste to v\u011Bd\u011Bl(a), ani\u017E byste si p\u0159e\u010Detl(a)
      \u010Dl\xE1nek?"
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820353
    m_Localized: "Je d\u016Fle\u017Eit\xE9 si nejprve p\u0159e\u010D\xEDst a informovat
      se, ne\u017E se rozhodnete, co je to \u201Ehoax\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820354
    m_Localized: "No... nalet\u011Bl jsi na fale\u0161nou zpr\xE1vu!"
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820355
    m_Localized: "Ch\xE1pu, \u017Ee v\xE1s zaujal n\xE1zev, ale..."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820356
    m_Localized: "Kdybyste si text pro\u0161el(a), vypl\xFDv\xE1 z n\u011Bj, \u017Ee
      jde o hoax."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820357
    m_Localized: "Nebojte se, vysv\u011Btl\xEDme v\xE1m, co \u017Ee jste si to pr\xE1v\u011B
      p\u0159e\u010Detli."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820358
    m_Localized: "Je p\u0159irozen\xE9, \u017Ee si je\u0161t\u011B nejste jist\xFD/\xE1,
      co si o tom myslet. \u010Cl\xE1nek jste si zat\xEDm nep\u0159e\u010Detli."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820359
    m_Localized: "Ne\u017E budeme pokra\u010Dovat, p\u0159e\u010Dt\u011Bme si \u010Dl\xE1nek..."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208886239232
    m_Localized: "Pokud se pod\xEDv\xE1te pozorn\u011B, neuv\xE1d\u011Bj\xED se jm\xE9na
      instituc\xED, osob ani zdroj\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208940765184
    m_Localized: "T\xF3n \u010Dl\xE1nku je provokativn\xED, aby vzbudil va\u0161e
      rozho\u0159\u010Den\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208940765185
    m_Localized: "Pamatujte, \u017Ee mnoho dezinformac\xED je vytvo\u0159eno proto,
      aby n\xE1s rozd\u011Blovalo."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208940765186
    m_Localized: "D\u016Fle\u017Eit\xE9: Pros\xEDm v\u0161imn\u011Bte si, \u017Ee
      text nen\xED naps\xE1n \xFApln\u011B dob\u0159e."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208940765187
    m_Localized: "A\u010Dkoli existuj\xED i \u010Dl\xE1nky, kter\xE9 jsou dob\u0159e
      napsan\xE9, mohou b\xFDt p\u0159esto nepravdiv\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208940765188
    m_Localized: "Mus\xEDme se zam\u011B\u0159it na to, zda se \u010Dl\xE1nek sna\u017E\xED
      vyvolat emocion\xE1ln\xED reakci."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959488
    m_Localized: "Je to pro v\xE1s srozumiteln\xE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959489
    m_Localized: "Skv\u011Bl\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959490
    m_Localized: "Pokra\u010Dujeme ve va\u0161em tr\xE9ninku"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959491
    m_Localized: "Za\u0161leme v\xE1m dal\u0161\xED \u010Dl\xE1nek. Klikn\u011Bte
      na \u201E\u010C\xEDst\u201C nebo \u201EP\u0159esko\u010Dit\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959492
    m_Localized: "Zd\xE1 se, \u017Ee jste op\u011Bt p\u0159esko\u010Dil/a \u010Dl\xE1nek,
      ani\u017E byste si jej nejprve p\u0159e\u010Detli\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959493
    m_Localized: "Je u\u017Eite\u010Dn\xE9 vytvo\u0159it si n\xE1vyk \u010Dl\xE1nky
      opravdu \u010D\xEDst, ne\u017E si na n\u011B vytvo\u0159\xEDte n\xE1zor."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959494
    m_Localized: "Je to d\u016Fle\u017Eit\xE9, aby bylo mo\u017En\xE9 utvo\u0159it
      si vlastn\xED n\xE1zor."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959495
    m_Localized: "Ne\u017E budeme pokra\u010Dovat, bylo by dobr\xE9 si \u010Dl\xE1nek
      nejprve p\u0159e\u010D\xEDst\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959496
    m_Localized: "Nyn\xED, kdy\u017E jste si \u010Dl\xE1nek p\u0159e\u010Detli\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 11999923470569472
    m_Localized: "Domn\xEDv\xE1te se, \u017Ee by ten \u010Dl\xE1nek mohl b\xFDt nepravdiv\xFD?"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959497
    m_Localized: "Tak\u2026 tento byl skute\u010Dn\u011B pravdiv\xFD!"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959498
    m_Localized: "Odvedl/a jste skv\u011Blou pr\xE1ci!"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959499
    m_Localized: "Zp\u016Fsob, jak\xFDm je \u010Dl\xE1nek naps\xE1n, jej prozrazuje."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959500
    m_Localized: "Jsou v n\u011Bm citov\xE1ny ofici\xE1ln\xED zdroje a instituce."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959501
    m_Localized: "Nav\xEDc poch\xE1z\xED z v\xFDznamn\xE9ho m\xE9dia, kter\xE9mu
      se obvykle d\xE1 v\u011B\u0159it."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959502
    m_Localized: "Jako \u010Dlen/ka S.M.P.D.S je va\u0161\xEDm \xFAkolem informace
      t\u0159\xEDdit a ov\u011B\u0159ovat."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959503
    m_Localized: "M\u011Bl/a byste se sv\xFDmi bl\xEDzk\xFDmi sd\xEDlet jen ty zpr\xE1vy,
      kter\xE9 pova\u017Eujete za pravdiv\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959504
    m_Localized: "Nap\u0159\xEDklad tu, kterou jsme si pr\xE1v\u011B p\u0159e\u010Detli."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959505
    m_Localized: "Nau\u010D\xEDme se, jak SD\xCDLET \u010Dl\xE1nky."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959506
    m_Localized: "Kliknete-li na tla\u010D\xEDtko \u201ESD\xCDLET\u201C, zobraz\xED
      se V\xE1m t\u0159i mo\u017Enosti."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959507
    m_Localized: "O kter\xE9 z nich byste se cht\u011Bl/a dozv\u011Bd\u011Bt v\xEDce?"
    m_Metadata:
      m_Items: []
  - m_Id: 11998802274390016
    m_Localized: "Mo\u017Enost P\u0158\xC1TEL\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693184
    m_Localized: "Jsou to lid\xE9, s nimi\u017E m\xE1te dlouhodob\xE9 p\u0159\xE1telsk\xE9
      vztahy."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693185
    m_Localized: "M\xEDvaj\xED pevn\u011B ust\xE1len\xE9 n\xE1zory a postoje."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693186
    m_Localized: "N\u011Bkdy mohou p\u016Fsobit, jako by byli na sv\u011Bt kolem
      sebe trochu rozzloben\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693187
    m_Localized: "Mo\u017Enost RODINA"
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693188
    m_Localized: "Va\u0161e d\u011Bti a vnou\u010Data, kte\u0159\xED V\xE1m pomohli
      s nov\xFDmi technologiemi."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693189
    m_Localized: "V\u017Edy jsou v obraze a velmi dob\u0159e informovan\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693190
    m_Localized: "S nejv\u011Bt\u0161\xED pravd\u011Bpodobnost\xED nenalet\xED \u017E\xE1dn\xE9mu
      klamu \u010Di f\xE1my."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693191
    m_Localized: "Mo\u017Enost SOUSED\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693192
    m_Localized: "Jsou to lid\xE9, s nimi\u017E jste mnoho let \u017Eili vedle sebe."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693193
    m_Localized: "Najdete mezi nimi v\u0161echny typy lid\xED, kter\xE9 si dok\xE1\u017Eete
      p\u0159edstavit."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693194
    m_Localized: "Na zpr\xE1vy mohou reagovat velmi rozd\xEDln\xFDmi zp\u016Fsoby."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959508
    m_Localized: "Nyn\xED, kdy\u017E u\u017E zn\xE1te jednotliv\xE9 skupiny\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959509
    m_Localized: "Klikn\u011Bte na tla\u010D\xEDtko \u201ESd\xEDlet\u201C a zkuste
      si to."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959510
    m_Localized: "U\u017E jste se nau\u010Dil/a v\u0161e, co pot\u0159ebujete!"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959511
    m_Localized: "Pamatujte: \u010Dl\xE1nky si pe\u010Dliv\u011B p\u0159e\u010Dt\u011Bte."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959512
    m_Localized: "A sd\xEDlejte pouze ty, kter\xE9 pova\u017Eujete za pravdiv\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959513
    m_Localized: "Jen tak d\xE1l!"
    m_Metadata:
      m_Items: []
  - m_Id: 15301839948582912
    m_Localized: "Abyste mohli \u010Dl\xE1nek dob\u0159e \u010D\xEDst, mus\xEDte
      um\u011Bt posouvat obrazovku."
    m_Metadata:
      m_Items: []
  - m_Id: 15301840036663296
    m_Localized: "Pou\u017Eijte prst k posunut\xED nahoru nebo dol\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 15301840036663297
    m_Localized: "Skv\u011Bl\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 34909988326182912
    m_Localized: "A p\u0159\xEDmo nad n\xEDm m\u016F\u017Eete vid\u011Bt font\xE1nu."
    m_Metadata:
      m_Items: []
  - m_Id: 34909988405874688
    m_Localized: "V tomto p\u0159\xEDpad\u011B je uvedeno \u201ESOCI\xC1LN\xCD S\xCDT\u011A\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 34909988405874689
    m_Localized: "To znamen\xE1, \u017Ee tento \u010Dl\xE1nek poch\xE1z\xED odtud."
    m_Metadata:
      m_Items: []
  - m_Id: 34909988405874690
    m_Localized: "Pokud zad\xE1te \u201ENOVINY\u201C, znamen\xE1 to, \u017Ee poch\xE1z\xED
      z novin."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
