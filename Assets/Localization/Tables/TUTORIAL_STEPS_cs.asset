--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TUTORIAL_STEPS_cs
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: cs
  m_SharedData: {fileID: 11400000, guid: 22cb33751284c934dbba25f1e0393930, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 11980431360
    m_Localized: "V\xEDtejte na tr\xE9ninku!"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597184
    m_Localized: "Pod\xEDv\xE1me se na prvn\xED \u010Dl\xE1nek."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597185
    m_Localized: "Je na v\xE1s, jestli si to p\u0159e\u010Dtete..."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597186
    m_Localized: "Nebo pokud to chcete p\u0159esko\u010Dit..."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597187
    m_Localized: "Vyzkou\u0161ejte to! Klikn\u011Bte na \u201E\u010C\xEDst\u201C
      nebo \u201EP\u0159esko\u010Dit\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597188
    m_Localized: "Jak se v\xE1m \u010Dl\xE1nek l\xEDbil?"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597189
    m_Localized: "Vyberte tla\u010D\xEDtko a sd\u011Blte n\xE1m to!"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597190
    m_Localized: "Tento \u010Dl\xE1nek je \u201Ehoaxem\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597191
    m_Localized: Jsou formou dezinformace.
    m_Metadata:
      m_Items: []
  - m_Id: 11282912289460224
    m_Localized: "V\xFDborn\u011B! P\u0159e\u010Detl jste si \u010Dl\xE1nek a ozna\u010Dil
      jste ho jako \u201Ehoax\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820352
    m_Localized: "Hmm... Jak jsi to v\u011Bd\u011Bl, ani\u017E by sis p\u0159e\u010Detl
      \u010Dl\xE1nek?"
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820353
    m_Localized: "Je d\u016Fle\u017Eit\xE9 si nejprve p\u0159e\u010D\xEDst a informovat
      se, ne\u017E se rozhodnete, co je to \u201Ehoax\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820354
    m_Localized: "No... nalet\u011Bl jsi na fale\u0161nou zpr\xE1vu!"
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820355
    m_Localized: "Ch\xE1pu, \u017Ee t\u011B zaujal n\xE1zev, ale..."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820356
    m_Localized: "Kdybys to \u010Detl, uv\u011Bdomil by sis, \u017Ee se jedn\xE1
      o \u201Ehoax\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820357
    m_Localized: "Nebojte se, vysv\u011Btl\xEDme v\xE1m, co jste pr\xE1v\u011B p\u0159e\u010Detli."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820358
    m_Localized: "Je norm\xE1ln\xED, \u017Ee nev\xED\u0161, co si m\xE1\u0161 myslet.
      Ne\u010Detl jsi ten \u010Dl\xE1nek!"
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820359
    m_Localized: "Ne\u017E budeme pokra\u010Dovat, p\u0159e\u010Dt\u011Bme si \u010Dl\xE1nek..."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208886239232
    m_Localized: "Pokud se pod\xEDv\xE1te pozorn\u011B, neuv\xE1d\u011Bj\xED se jm\xE9na
      instituc\xED, osob ani zdroj\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208940765184
    m_Localized: "T\xF3n \u010Dl\xE1nku je provokativn\xED, aby vzbudil va\u0161e
      rozho\u0159\u010Den\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208940765185
    m_Localized: "Pamatujte, \u017Ee mnoho dezinformac\xED m\xE1 za c\xEDl n\xE1s
      rozd\u011Blit."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208940765186
    m_Localized: "D\u016Fle\u017Eit\xE9: Uv\u011Bdomte si, \u017Ee to nen\xED naps\xE1no
      p\u0159\xEDli\u0161 dob\u0159e."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208940765187
    m_Localized: "A\u010Dkoli existuj\xED n\u011Bkter\xE9 dob\u0159e napsan\xE9 \u010Dl\xE1nky,
      jsou tak\xE9 fale\u0161n\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208940765188
    m_Localized: "Mus\xEDme se zam\u011B\u0159it na to, zda se \u010Dl\xE1nek sna\u017E\xED
      vyvolat emocion\xE1ln\xED reakci."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959488
    m_Localized: "Rozum\xED\u0161 tomu?"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959489
    m_Localized: "Skv\u011Bl\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959490
    m_Localized: "Pokra\u010Dujeme ve va\u0161em tr\xE9ninku"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959491
    m_Localized: "Za\u0161leme v\xE1m dal\u0161\xED \u010Dl\xE1nek. Klikn\u011Bte
      na \u201E\u010C\xEDst\u201C nebo \u201EP\u0159esko\u010Dit\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959492
    m_Localized: "Zase jsi ten \u010Dl\xE1nek p\u0159esko\u010Dil, ani\u017E bys
      ho \u010Detl..."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959493
    m_Localized: "Mus\xEDte si zvyknout ho \u010D\xEDst!"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959494
    m_Localized: "Je velmi d\u016Fle\u017Eit\xE9, aby bylo mo\u017En\xE9 si utvo\u0159it
      n\xE1zor."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959495
    m_Localized: "Ne\u017E budeme pokra\u010Dovat, p\u0159e\u010Dt\u011Bme si \u010Dl\xE1nek..."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959496
    m_Localized: "Te\u010F, kdy\u017E jste si p\u0159e\u010Detli \u010Dl\xE1nek..."
    m_Metadata:
      m_Items: []
  - m_Id: 11999923470569472
    m_Localized: "Mysl\xED\u0161, \u017Ee je to fale\u0161n\xE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959497
    m_Localized: "No... Tenhle byl prav\xFD!"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959498
    m_Localized: "Dobr\xE1 pr\xE1ce!"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959499
    m_Localized: "Zp\u016Fsob, jak\xFDm je to naps\xE1no, ho prozrazuje."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959500
    m_Localized: "Jsou citov\xE1ny ofici\xE1ln\xED zdroje a instituce."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959501
    m_Localized: "Krom\u011B toho, \u017Ee vych\xE1z\xED velk\xFD den\xEDk, na kter\xFD
      se obvykle m\u016F\u017Eeme spolehnout."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959502
    m_Localized: "Jako \u010Dlen S.M.P.D.S je tv\xFDm \xFAkolem filtrovat informace."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959503
    m_Localized: "Mus\xEDte sv\xFDm bl\xEDzk\xFDm sd\u011Blit ty zpr\xE1vy, kter\xE9
      pova\u017Eujete za PRAVDIV\xC9."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959504
    m_Localized: "Nap\u0159\xEDklad ten, kter\xFD jsme pr\xE1v\u011B \u010Detli."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959505
    m_Localized: "Nau\u010D\xEDme se SD\xCDLET \u010Dl\xE1nky"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959506
    m_Localized: "Pokud kliknete na tla\u010D\xEDtko \u201ESD\xCDLET\u201C, zobraz\xED
      se v\xE1m 3 mo\u017Enosti."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959507
    m_Localized: "O \u010Dem se chce\u0161 dozv\u011Bd\u011Bt v\xEDce?"
    m_Metadata:
      m_Items: []
  - m_Id: 11998802274390016
    m_Localized: "Mo\u017Enost P\u0158\xC1TEL\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693184
    m_Localized: "Jsou to tvoje p\u0159\xE1telsk\xE9 vazby. Lid\xE9, se kter\xFDmi
      jsi se st\xFDkal."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693185
    m_Localized: "Maj\xED pevn\xE9 n\xE1zory a ji\u017E utvo\u0159en\xE9 postoje."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693186
    m_Localized: "Vypadaj\xED, \u017Ee jsou trochu na\u0161tvan\xED na sv\u011Bt..."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693187
    m_Localized: "Mo\u017Enost RODINA"
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693188
    m_Localized: "Va\u0161e d\u011Bti a vnou\u010Data, kte\u0159\xED v\xE1m pomohli
      s nov\xFDmi technologiemi"
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693189
    m_Localized: "V\u017Edy jsou v obraze a velmi dob\u0159e informovan\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693190
    m_Localized: "Nikdy nenalet\xED na \u017E\xE1dn\xE9 f\xE1my."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693191
    m_Localized: "Mo\u017Enost SOUSED\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693192
    m_Localized: "Jsou to lid\xE9, se kter\xFDmi jsi \u017Eil mnoho let."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693193
    m_Localized: "Jsou zde v\u0161echny profily, kter\xE9 si dok\xE1\u017Eete p\u0159edstavit."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693194
    m_Localized: "Budou reagovat na zpr\xE1vy velmi odli\u0161n\xFDm zp\u016Fsobem."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959508
    m_Localized: "Nyn\xED, kdy\u017E u\u017E zn\xE1te skupiny..."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959509
    m_Localized: "Klikn\u011Bte na tla\u010D\xEDtko \u201ESd\xEDlet\u201C a vyzkou\u0161ejte
      to."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959510
    m_Localized: "U\u017E jste se nau\u010Dili v\u0161e, co pot\u0159ebujete!"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959511
    m_Localized: "Pamatujte: \u010Cl\xE1nky si pe\u010Dliv\u011B p\u0159e\u010Dt\u011Bte."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959512
    m_Localized: "A sd\xEDlejte pouze ty, kter\xE9 pova\u017Eujete za pravdiv\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959513
    m_Localized: "Hlavu vzh\u016Fru!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
