  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TUTORIAL_STEPS_cs
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: cs
  m_SharedData: {fileID: 11400000, guid: 22cb33751284c934dbba25f1e0393930, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 11980431360
    m_Localized: "V\xEDtejte v Level Up!"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597184
    m_Localized: "V t\xE9to sekci v\xE1m poskytneme N\xC1VOD, jak hr\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597185
    m_Localized: "Uk\xE1\u017Eeme v\xE1m sekci \u010Cl\xE1nky. Tam se dozv\xEDte
      nejnov\u011Bj\u0161\xED zpr\xE1vy."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597186
    m_Localized: "Zde si m\u016F\u017Eete prohl\xE9dnout \u0159adu novinov\xFDch
      \u010Dl\xE1nk\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597187
    m_Localized: "M\u016F\u017Eete vid\u011Bt n\xE1zev a souvisej\xEDc\xED obr\xE1zek."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597188
    m_Localized: "Tak\xE9 pomoc\xED prstu se m\u016F\u017Eete pohybovat po t\xE9to
      obrazovce."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597189
    m_Localized: "Pokud jej posunete nahoru, uvid\xEDte dal\u0161\xED \u010Dl\xE1nky
      v doln\xED \u010D\xE1sti."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597190
    m_Localized: "Pokud p\u0159ejedete prstem dol\u016F, vr\xE1t\xEDte se k p\u0159edchoz\xEDm
      \u010Dl\xE1nk\u016Fm."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597191
    m_Localized: "Vyzkou\u0161ejte to!"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597192
    m_Localized: "Nyn\xED v\xE1m uk\xE1\u017Eeme tla\u010D\xEDtka u jednotliv\xFDch
      polo\u017Eek."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597193
    m_Localized: "Moment\xE1ln\u011B je nelze kliknout, ale postupn\u011B v\xE1m
      je budeme ukazovat."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597194
    m_Localized: "Prvn\xED z nich je vpravo naho\u0159e, tla\u010D\xEDtko \u201EP\u0159esko\u010Dit\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597195
    m_Localized: "T\xEDmto tla\u010D\xEDtkem n\xE1m sd\u011Blujete, \u017Ee v\xE1s
      tento \u010Dl\xE1nek NEZAJ\xCDM\xC1, a proto odtud zmiz\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597196
    m_Localized: Zkuste to stisknout!
    m_Metadata:
      m_Items: []
  - m_Id: 12005597197
    m_Localized: "N\xE1sleduje tla\u010D\xEDtko \u201E\u010C\xCDST\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597198
    m_Localized: "Po stisknut\xED tohoto tla\u010D\xEDtka se zobraz\xED dal\u0161\xED
      informace o \u010Dl\xE1nku."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597199
    m_Localized: "M\u016F\u017Eete si ji p\u0159e\u010D\xEDst, abyste se dob\u0159e
      informovali o tom, co \u0159\xEDk\xE1 a odkud \u010Derp\xE1 sv\xE9 informace."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597200
    m_Localized: "Vyzkou\u0161ejte to!"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597201
    m_Localized: "Skv\u011Bl\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597202
    m_Localized: "Te\u010F, kdy\u017E jste si \u010Dl\xE1nek p\u0159e\u010Detli,
      u\u017E v\xEDte, o \u010Dem vlastn\u011B je."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597203
    m_Localized: "Zkus\xEDme to tedy sd\xEDlet s va\u0161imi bl\xEDzk\xFDmi skupinami."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597204
    m_Localized: "Tyto skupiny NEJSOU SKUTE\u010CN\xC9."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791488
    m_Localized: "Jsou sou\u010D\xE1st\xED hry, ve kter\xE9 se sna\u017E\xEDme simulovat
      pou\u017E\xEDv\xE1n\xED soci\xE1ln\xEDch s\xEDt\xED, jako je WhatsApp."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791489
    m_Localized: "T\u0159et\xED a posledn\xED tla\u010D\xEDtko, kter\xE9 m\xE1me
      k dispozici, je tla\u010D\xEDtko \u201ESd\xEDlet\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791490
    m_Localized: "Pomoc\xED tohoto tla\u010D\xEDtka m\u016F\u017Eete sd\xEDlet \u010Dl\xE1nky,
      kter\xE9 pova\u017Eujete za relevantn\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791491
    m_Localized: "Je d\u016Fle\u017Eit\xE9, abys sd\xEDlel ty, kter\xE9 t\u011B zaujaly
      nebo t\u011B zaj\xEDmaj\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791492
    m_Localized: "K tomu mus\xEDte kliknout na ozna\u010Den\xE9 tla\u010D\xEDtko
      \u201ESd\xEDlet\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791493
    m_Localized: "Vyzkou\u0161ejte to!"
    m_Metadata:
      m_Items: []
  - m_Id: 12009791494
    m_Localized: "Skv\u011Bl\xE9! U\u017E to zvl\xE1d\xE1\u0161 perfektn\u011B."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791495
    m_Localized: "Vid\u011Bl jsi r\u016Fzn\xE9 funkce, kter\xE9 m\xE1me k dispozici:"
    m_Metadata:
      m_Items: []
  - m_Id: 12009791496
    m_Localized: "\u010C\xCDST \u010Dl\xE1nky"
    m_Metadata:
      m_Items: []
  - m_Id: 12009791497
    m_Localized: "P\u0158ESKO\u010CIT \u010Dl\xE1nky, kter\xE9 v\xE1s NEZAJ\xCDMAJ\xCD"
    m_Metadata:
      m_Items: []
  - m_Id: 12009791498
    m_Localized: "a SD\xCDLET \u010Dl\xE1nky se sv\xFDmi bl\xEDzk\xFDmi kruhy"
    m_Metadata:
      m_Items: []
  - m_Id: 12009791499
    m_Localized: "Ne\u017E se rozlou\u010D\xEDme, poj\u010Fme si je\u0161t\u011B
      jednou zopakovat funkce tla\u010D\xEDtek."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791500
    m_Localized: "Po stisknut\xED spr\xE1vn\xE9ho tla\u010D\xEDtka se tla\u010D\xEDtko
      \u201EDAL\u0160\xCD\u201C dole znovu aktivuje."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791501
    m_Localized: "Stiskn\u011Bte tla\u010D\xEDtko pro P\u0158ESKO\u010CEN\xCD polo\u017Eek."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791502
    m_Localized: "Dobr\xE1 pr\xE1ce!"
    m_Metadata:
      m_Items: []
  - m_Id: 12009791503
    m_Localized: "Nyn\xED stiskn\u011Bte tla\u010D\xEDtko pro \u010CTEN\xCD \u010Dl\xE1nk\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791504
    m_Localized: "Skv\u011Bl\xE9! A te\u010F posledn\xED..."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791505
    m_Localized: "Klikn\u011Bte na tla\u010D\xEDtko pro sd\xEDlen\xED \u010Dl\xE1nk\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791506
    m_Localized: "Skv\u011Bl\xE9! Vypad\xE1 to, \u017Ee m\xE1\u0161 v\u0161echno
      jasn\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791507
    m_Localized: "A te\u010F u\u017E v\xE1s nech\xE1me hr\xE1t..."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791508
    m_Localized: "Nezapome\u0148te, \u017Ee jak\xE9koli technick\xE9 probl\xE9my
      m\u016F\u017Eete nahl\xE1sit."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791509
    m_Localized: "Hlavu vzh\u016Fru a u\u017Eijte si to!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
