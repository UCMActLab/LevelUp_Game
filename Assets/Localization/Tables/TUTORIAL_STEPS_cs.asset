%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TUTORIAL_STEPS_cs
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: cs
  m_SharedData: {fileID: 11400000, guid: 22cb33751284c934dbba25f1e0393930, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 11980431360
    m_Localized: "Poj\u010Fme se pod\xEDvat, jak to funguje."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597184
    m_Localized: "Pod\xEDv\xE1me se na prvn\xED p\u0159\xEDklad. Tady je titulek."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597185
    m_Localized: "Pro v\xEDce informac\xED si p\u0159e\u010Dt\u011Bte cel\xFD text."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597186
    m_Localized: "A to m\u016F\u017Eeme ud\u011Blat jedn\xEDm tla\u010D\xEDtkem..."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597187
    m_Localized: "Klikn\u011Bte na tla\u010D\xEDtko \u201EP\u0159e\u010D\xEDst\"."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597188
    m_Localized: "Co si o tom mysl\xEDte?"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597189
    m_Localized: "Vyberte si mo\u017Enost stisknut\xEDm po\u017Eadovan\xE9ho tla\u010D\xEDtka."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597190
    m_Localized: "Tento text poch\xE1z\xED z ned\u016Fv\u011Bryhodn\xE9ho zdroje."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597191
    m_Localized: Jsou formou manipulace.
    m_Metadata:
      m_Items: []
  - m_Id: 11282912289460224
    m_Localized: "V\xFDborn\u011B! P\u0159e\u010Detli jste si text a spr\xE1vn\u011B
      jste vyhodnotili, \u017Ee nen\xED d\u016Fv\u011Bryhodn\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820352
    m_Localized: "Hmm... Jak jste to poznali, ani\u017E byste si text p\u0159e\u010Detli?"
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820353
    m_Localized: "Je dobr\xE9 si text nejprve p\u0159e\u010D\xEDst, ne\u017E ho vyhodnot\xEDte."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820354
    m_Localized: "Pozor! Tento text m\u011Bl znaky ned\u016Fv\u011Bryhodn\xE9ho zdroje."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820355
    m_Localized: "Ch\xE1pu, \u017Ee v\xE1s titulek zaujal, ale..."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820356
    m_Localized: "Kdybyste si text p\u0159e\u010Detli, v\u0161imli byste si n\u011Bkolika
      podez\u0159el\xFDch znak\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820357
    m_Localized: "Nevad\xED, poj\u010Fme se na to pod\xEDvat spole\u010Dn\u011B."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820358
    m_Localized: "Zkuste si text nejprve p\u0159e\u010D\xEDst. Pak se v\xE1m bude
      rozhodovat sn\xE1z."
    m_Metadata:
      m_Items: []
  - m_Id: 11282912318820359
    m_Localized: "Ne\u017E budeme pokra\u010Dovat, p\u0159e\u010Dt\u011Bme si ten
      text..."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208886239232
    m_Localized: "V\u0161imn\u011Bte si: neuv\xE1d\u011Bj\xED se jm\xE9na instituc\xED,
      osob ani zdroj\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208940765184
    m_Localized: "T\xF3n textu je provokativn\xED, aby vzbudil va\u0161e rozho\u0159\u010Den\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208940765185
    m_Localized: "Pamatujte, \u017Ee c\xEDlem takov\xE9ho obsahu je z\xEDskat va\u0161i
      d\u016Fv\u011Bru a pak ji zneu\u017E\xEDt."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208940765186
    m_Localized: "V\u0161imn\u011Bte si tak\xE9, \u017Ee text nen\xED naps\xE1n p\u0159\xEDli\u0161
      profesion\xE1ln\u011B."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208940765187
    m_Localized: "Ale pozor: i dob\u0159e napsan\xFD text m\u016F\u017Ee b\xFDt ned\u016Fv\u011Bryhodn\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208940765188
    m_Localized: "V\u017Edy si v\u0161\xEDmejte, zda se text sna\u017E\xED vyvolat
      silnou emocion\xE1ln\xED reakci."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959488
    m_Localized: "Je to pro v\xE1s srozumiteln\xE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959489
    m_Localized: "Skv\u011Bl\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959490
    m_Localized: "Pokra\u010Dujeme."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959491
    m_Localized: "Pod\xEDv\xE1me se na dal\u0161\xED p\u0159\xEDklad."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959492
    m_Localized: "Zd\xE1 se, \u017Ee jste op\u011Bt p\u0159esko\u010Dili text, ani\u017E
      byste si jej nejprve p\u0159e\u010Detli..."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959493
    m_Localized: "Je dobr\xE9 si text nejprve p\u0159e\u010D\xEDst, ne\u017E si na
      n\u011Bj vytvo\u0159\xEDte n\xE1zor."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959494
    m_Localized: "Pom\u016F\u017Ee v\xE1m to l\xE9pe posoudit, jestli je obsah d\u016Fv\u011Bryhodn\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959495
    m_Localized: "Ne\u017E budeme pokra\u010Dovat, p\u0159e\u010Dt\u011Bte si pros\xEDm
      text."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959496
    m_Localized: "Nyn\xED, kdy\u017E jste si text p\u0159e\u010Detli..."
    m_Metadata:
      m_Items: []
  - m_Id: 11999923470569472
    m_Localized: "Domn\xEDv\xE1te se, \u017Ee je tento obsah d\u016Fv\u011Bryhodn\xFD?"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959497
    m_Localized: "Tak... tento obsah byl skute\u010Dn\u011B d\u016Fv\u011Bryhodn\xFD!"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959498
    m_Localized: "Odvedl/a jste skv\u011Blou pr\xE1ci!"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959499
    m_Localized: "Zp\u016Fsob, jak\xFDm je text naps\xE1n, m\u016F\u017Ee hodn\u011B
      prozradit."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959500
    m_Localized: "Jsou v n\u011Bm citov\xE1ny ofici\xE1ln\xED zdroje a instituce."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959501
    m_Localized: "Nav\xEDc poch\xE1z\xED ze zdroje, kter\xE9mu se obvykle d\xE1 v\u011B\u0159it."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959502
    m_Localized: "Va\u0161\xEDm \xFAkolem je pomoct bl\xEDzk\xFDm zorientovat se
      v informac\xEDch."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959503
    m_Localized: "Sv\xFDm bl\xEDzk\xFDm doporu\u010Dujte jen obsah, kter\xE9mu d\u016Fv\u011B\u0159ujete.
      Ostatn\xED klidn\u011B zaho\u010Fte."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959504
    m_Localized: "T\u0159eba ten, kter\xFD jsme si pr\xE1v\u011B p\u0159e\u010Detli."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959505
    m_Localized: "Nau\u010D\xEDme se, jak obsah DOPORU\u010CIT."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959506
    m_Localized: "Kliknete-li na tla\u010D\xEDtko \u201EDoporu\u010Dit\", zobraz\xED
      se v\xE1m t\u0159i skupiny lid\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959507
    m_Localized: "O kter\xE9 z nich byste se cht\u011Bli dozv\u011Bd\u011Bt v\xEDce?"
    m_Metadata:
      m_Items: []
  - m_Id: 11998802274390016
    m_Localized: "Skupina P\u0158\xC1TEL\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693184
    m_Localized: "Jsou to lid\xE9, s nimi\u017E m\xE1te dlouhodob\xE9 p\u0159\xE1telsk\xE9
      vztahy."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693185
    m_Localized: "M\xEDvaj\xED pevn\u011B ust\xE1len\xE9 n\xE1zory a postoje."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693186
    m_Localized: "N\u011Bkdy mohou p\u016Fsobit, jako by byli na sv\u011Bt kolem
      sebe trochu rozzloben\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693187
    m_Localized: Skupina RODINA
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693188
    m_Localized: "Va\u0161e d\u011Bti a vnou\u010Data, kte\u0159\xED v\xE1m pomohli
      s nov\xFDmi technologiemi."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693189
    m_Localized: "V\u017Edy jsou v obraze a velmi dob\u0159e informovan\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693190
    m_Localized: "S nejv\u011Bt\u0161\xED pravd\u011Bpodobnost\xED nenalet\xED \u017E\xE1dn\xE9mu
      klamu \u010Di f\xE1m\u011B."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693191
    m_Localized: "Skupina SOUSED\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693192
    m_Localized: "Jsou to lid\xE9, s nimi\u017E jste mnoho let \u017Eili vedle sebe."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693193
    m_Localized: "Najdete mezi nimi v\u0161echny typy lid\xED, kter\xE9 si dok\xE1\u017Eete
      p\u0159edstavit."
    m_Metadata:
      m_Items: []
  - m_Id: 11998802345693194
    m_Localized: "Na zpr\xE1vy mohou reagovat velmi rozd\xEDln\xFDmi zp\u016Fsoby."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959508
    m_Localized: "Nyn\xED, kdy\u017E u\u017E zn\xE1te jednotliv\xE9 skupiny..."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959509
    m_Localized: "Klikn\u011Bte na tla\u010D\xEDtko \u201EDoporu\u010Dit\" a zkuste
      si to."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959510
    m_Localized: "U\u017E jste se nau\u010Dili v\u0161e, co pot\u0159ebujete!"
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959511
    m_Localized: "Pamatujte: obsah si pe\u010Dliv\u011B p\u0159e\u010Dt\u011Bte."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959512
    m_Localized: "Doporu\u010Dte bl\xEDzk\xFDm jen to, \u010Demu d\u016Fv\u011B\u0159ujete."
    m_Metadata:
      m_Items: []
  - m_Id: 11464208944959513
    m_Localized: "Proto\u017Ee va\u0161\xEDm \xFAkolem je pomoct jim zorientovat
      se."
    m_Metadata:
      m_Items: []
  - m_Id: 15301839948582912
    m_Localized: "Abyste mohli \u010Dl\xE1nek dob\u0159e \u010D\xEDst, mus\xEDte
      um\u011Bt posouvat obrazovku."
    m_Metadata:
      m_Items: []
  - m_Id: 15301840036663296
    m_Localized: "Pou\u017Eijte prst k posunut\xED nahoru nebo dol\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 15301840036663297
    m_Localized: "Skv\u011Bl\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 34909988326182912
    m_Localized: "A hned nad n\xEDm vid\xEDte zdroj."
    m_Metadata:
      m_Items: []
  - m_Id: 34909988405874688
    m_Localized: "V tomto p\u0159\xEDpad\u011B je uvedeno \u201ESOCI\xC1LN\xCD M\xC9DIA\"."
    m_Metadata:
      m_Items: []
  - m_Id: 34909988405874689
    m_Localized: "To znamen\xE1, \u017Ee tento obsah poch\xE1z\xED odtud."
    m_Metadata:
      m_Items: []
  - m_Id: 34909988405874690
    m_Localized: "Pokud je u zdroje uvedeno \u201ENOVINY\", znamen\xE1 to, \u017Ee
      poch\xE1z\xED z novin."
    m_Metadata:
      m_Items: []
  - m_Id: 53487226259689472
    m_Localized: "A p\u0159edat jim jen to, co za to stoj\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 53487226301632512
    m_Localized: "Tak\u017Ee: doporu\u010Dte, pokud obsahu d\u016Fv\u011B\u0159ujete!"
    m_Metadata:
      m_Items: []
  - m_Id: 53487226301632513
    m_Localized: "A zaho\u010Fte, pokud ne!"
    m_Metadata:
      m_Items: []
  - m_Id: 53487226301632514
    m_Localized: "Poj\u010Fme na to!"
    m_Metadata:
      m_Items: []
  - m_Id: 53758172430258176
    m_Localized: "Klikn\u011Bte na P\u0158E\u010C\xCDST (p\u0159e\u010D\xEDst text)
      nebo ZAHODIT (text p\u0159esko\u010Dit)."
    m_Metadata:
      m_Items: []
  - m_Id: 65271361259843584
    m_Localized: "V\xEDtejte! Va\u0161\xEDm \xFAkolem bude posoudit r\u016Fzn\xE9
      \u010Dl\xE1nky a p\u0159\xEDsp\u011Bvky."
    m_Metadata:
      m_Items: []
  - m_Id: 65271361285009408
    m_Localized: "Va\u0161\xEDm \xFAkolem je posoudit, kter\xE9 \u010Dl\xE1nky byste
      doporu\u010Dili sv\xFDm bl\xEDzk\xFDm a kter\xE9 rad\u011Bji zahod\xEDte."
    m_Metadata:
      m_Items: []
  - m_Id: 65271361285009409
    m_Localized: "Nyn\xED v\xE1m p\u0159edstav\xEDme n\u011Bkolik \u010Dl\xE1nk\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 65271361285009410
    m_Localized: "Body z\xEDsk\xE1te za spr\xE1vn\xE1 rozhodnut\xED: za doporu\u010Den\xED
      d\u016Fv\u011Bryhodn\xFDch \u010Dl\xE1nk\u016F a za zahozen\xED ned\u016Fv\u011Bryhodn\xFDch."
    m_Metadata:
      m_Items: []
  - m_Id: 65271361285009411
    m_Localized: "Abychom v\xE1m \xFAkol usnadnili, m\u016F\u017Eete se pod\xEDvat
      na zdroj, tedy na to, kde byl \u010Dl\xE1nek publikov\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 65271361285009412
    m_Localized: "Zdroj naleznete v horn\xED \u010D\xE1sti \u010Dl\xE1nku."
    m_Metadata:
      m_Items: []
  - m_Id: 65271361285009413
    m_Localized: "M\u016F\u017Eete si tak\xE9 p\u0159e\u010D\xEDst cel\xFD \u010Dl\xE1nek,
      abyste se l\xE9pe informovali (b\xEDl\xE9 tla\u010D\xEDtko P\u0158E\u010C\xCDST)."
    m_Metadata:
      m_Items: []
  - m_Id: 65271361285009414
    m_Localized: "P\u0159i \u010Dten\xED si v\u0161\xEDmejte kvality textu, jazyka
      a toho, zda cituje ofici\xE1ln\xED zdroje."
    m_Metadata:
      m_Items: []
  - m_Id: 65271361285009415
    m_Localized: "Pokud si mysl\xEDte, \u017Ee obsah NEN\xCD d\u016Fv\u011Bryhodn\xFD,
      klikn\u011Bte na \u010Derven\xE9 tla\u010D\xEDtko ZAHODIT."
    m_Metadata:
      m_Items: []
  - m_Id: 66356381454053376
    m_Localized: "Pokud si mysl\xEDte, \u017Ee obsah JE d\u016Fv\u011Bryhodn\xFD,
      klikn\u011Bte na modr\xE9 tla\u010D\xEDtko DOPORU\u010CIT."
    m_Metadata:
      m_Items: []
  - m_Id: 66356381475024896
    m_Localized: "Poj\u010Fme na to! Hodn\u011B zdaru!"
    m_Metadata:
      m_Items: []
  - m_Id: 65960544282488832
    m_Localized: "Skv\u011Ble! Tohle v\xE1m jde dob\u0159e."
    m_Metadata:
      m_Items: []
  - m_Id: 65960544307654656
    m_Localized: "Jdeme na druhou \xFArove\u0148!"
    m_Metadata:
      m_Items: []
  - m_Id: 65960544307654657
    m_Localized: "Va\u0161\xEDm c\xEDlem je spr\xE1vn\u011B vyhodnotit alespo\u0148
      2 \u010Dl\xE1nky."
    m_Metadata:
      m_Items: []
  - m_Id: 65960544307654658
    m_Localized: "Te\u010F p\u0159ibude n\u011Bco nov\xE9ho: m\u016F\u017Eete obsah
      doporu\u010Dit sv\xFDm bl\xEDzk\xFDm a uvid\xEDte, jak na to zareaguj\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 65960544307654659
    m_Localized: "Zkus\xEDme doporu\u010Dit obsah va\u0161im skupin\xE1m!"
    m_Metadata:
      m_Items: []
  - m_Id: 65960544307654660
    m_Localized: "Nyn\xED po kliknut\xED na tla\u010D\xEDtko Doporu\u010Dit uvid\xEDte
      dostupn\xE9 skupiny."
    m_Metadata:
      m_Items: []
  - m_Id: 65960544307654661
    m_Localized: "Moment\xE1ln\u011B m\xE1te pouze jednu skupinu: Rodina."
    m_Metadata:
      m_Items: []
  - m_Id: 65960544307654662
    m_Localized: "Doporu\u010Dte sv\xFDm bl\xEDzk\xFDm \u010Dl\xE1nky, kter\xFDm
      d\u016Fv\u011B\u0159ujete, a sledujte jejich reakce."
    m_Metadata:
      m_Items: []
  - m_Id: 65960544307654663
    m_Localized: "Va\u0161\xEDm c\xEDlem v t\xE9to \xFArovni je spr\xE1vn\u011B vyhodnotit
      alespo\u0148 3 \u010Dl\xE1nky."
    m_Metadata:
      m_Items: []
  - m_Id: 66060669341585408
    m_Localized: "Z\xEDsk\xE1te extra body, pokud spr\xE1vn\u011B doporu\u010D\xEDte
      alespo\u0148 1 \u010Dl\xE1nek sv\xE9 skupin\u011B \u201ERodina\"."
    m_Metadata:
      m_Items: []
  - m_Id: 66060669400305664
    m_Localized: "Pamatujte! Pokud si pot\u0159ebujete znovu prohl\xE9dnout sv\xE9
      c\xEDle, klikn\u011Bte na ikonu \u017E\xE1rovky."
    m_Metadata:
      m_Items: []
  - m_Id: 66060669408694272
    m_Localized: "Gratulujeme! Postupujete do \u010Dtvrt\xE9 \xFArovn\u011B."
    m_Metadata:
      m_Items: []
  - m_Id: 66060669408694273
    m_Localized: "Nyn\xED m\xE1te 2 skupiny."
    m_Metadata:
      m_Items: []
  - m_Id: 66060669408694274
    m_Localized: "Va\u0161\xEDm c\xEDlem je spr\xE1vn\u011B vyhodnotit alespo\u0148
      3 \u010Dl\xE1nky."
    m_Metadata:
      m_Items: []
  - m_Id: 66060669408694275
    m_Localized: "Nav\xEDc z\xEDsk\xE1te v\xEDce bod\u016F za doporu\u010Den\xED
      d\u016Fv\u011Bryhodn\xFDch \u010Dl\xE1nk\u016F konkr\xE9tn\xEDm skupin\xE1m."
    m_Metadata:
      m_Items: []
  - m_Id: 66060669408694276
    m_Localized: "Hodn\u011B zdaru!"
    m_Metadata:
      m_Items: []
  - m_Id: 66060669408694279
    m_Localized: "Dost\xE1v\xE1te se do fin\xE1le!"
    m_Metadata:
      m_Items: []
  - m_Id: 66060669408694280
    m_Localized: "Tentokr\xE1t p\u0159ibude je\u0161t\u011B jedna novinka."
    m_Metadata:
      m_Items: []
  - m_Id: 66060669408694281
    m_Localized: "Va\u0161\xEDm c\xEDlem je op\u011Bt spr\xE1vn\u011B vyhodnotit
      alespo\u0148 3 \u010Dl\xE1nky."
    m_Metadata:
      m_Items: []
  - m_Id: 66060669408694282
    m_Localized: "Nav\xEDc m\xE1 ka\u017Ed\xE1 skupina jin\xE9 z\xE1jmy. Klikn\u011Bte
      na \u017E\xE1rovku a uvid\xEDte, co koho zaj\xEDm\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 66060669408694283
    m_Localized: "Kdy\u017E d\u016Fv\u011Bryhodn\xFD \u010Dl\xE1nek doporu\u010D\xEDte
      skupin\u011B, jej\xED\u017E t\xE9ma odpov\xEDd\xE1, z\xEDsk\xE1te body nav\xEDc."
    m_Metadata:
      m_Items: []
  - m_Id: 66060669408694284
    m_Localized: "Hlavn\xED \xFAkol ale z\u016Fst\xE1v\xE1 stejn\xFD: rozli\u0161it
      d\u016Fv\u011Bryhodn\xE9 od ned\u016Fv\u011Bryhodn\xE9ho."
    m_Metadata:
      m_Items: []
  - m_Id: 66060669408694285
    m_Localized: "Poj\u010Fme na to!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
