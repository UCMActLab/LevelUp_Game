  m_TableData:
  - m_Id: 48323334144
    m_Localized: "\u010Cl\xE1nek byl ov\u011B\u0159en webem Demagog.cz"
    m_Metadata:
      m_Items: []
  - m_Id: 48394637312
    m_Localized: "O tomto t\xE9matu najdete \u010Dl\xE1nky i ve v\xFDznamn\xFDch
      den\xEDc\xEDch."
    m_Metadata:
      m_Items: []
  - m_Id: 48394637313
    m_Localized: "Tato zpr\xE1va cituje ofici\xE1ln\xED zdroje."
    m_Metadata:
      m_Items: []
  - m_Id: 48394637314
    m_Localized: "Zdroje uveden\xE9 v \u010Dl\xE1nku neexistuj\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 48398831616
    m_Localized: "O tom p\xED\u0161\xED jen jak\xE9si nezn\xE1m\xE9 noviny."
    m_Metadata:
      m_Items: []
  - m_Id: 48398831617
    m_Localized: "Zdroj t\u011Bchto \xFAdaj\u016F z\u0159ejm\u011B neexistuje."
    m_Metadata:
      m_Items: []
