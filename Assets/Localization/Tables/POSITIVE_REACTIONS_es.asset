  m_Name: POSITIVE_REACTIONS_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 43fb5ec62adf86d46892bb303e4d54a3, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 20960436224
    m_Localized: "\xA1Mira qu\xE9 interesante!"
    m_Metadata:
      m_Items: []
  - m_Id: 20989796352
    m_Localized: Muchas gracias por compartirlo, hay que estar atento a estas cosas.
    m_Metadata:
      m_Items: []
  - m_Id: 20989796353
    m_Localized: "\xA1Qu\xE9 interesante! Siempre est\xE1s al corriente."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796354
    m_Localized: "Gracias por enviarlo, no ten\xEDa ni idea."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796355
    m_Localized: "Ah, esto es lo que quiero ver. \xA1Gracias!"
    m_Metadata:
      m_Items: []
  - m_Id: 20989796356
    m_Localized: "Ya lo hab\xEDa visto, pero gracias de todas maneras."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796357
    m_Localized: "As\xED me gusta, gente que piensa como yo."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796358
    m_Localized: Eso, la verdad que se sepa.
    m_Metadata:
      m_Items: []
  - m_Id: 20989796359
    m_Localized: Esto confirma lo que ya sospechaba.
    m_Metadata:
      m_Items: []
  - m_Id: 20989796360
    m_Localized: "Gracias por enviar esto, m\xE1ndanos m\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796361
    m_Localized: "No sab\xEDa de esto, pero est\xE1 bien estar informado."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796362
    m_Localized: "Gracias por compartir, lo tendr\xE9 en cuenta."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796363
    m_Localized: Gracias por mantenernos informados, da gusto contigo.
    m_Metadata:
      m_Items: []
  - m_Id: 20989796364
    m_Localized: "Bien, me gusta que hay m\xE1s gente que ve las cosas como yo."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796365
    m_Localized: "S\xED, gracias."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796366
    m_Localized: "Me alegra ver que est\xE1s al d\xEDa con las noticias."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796367
    m_Localized: "Lo hab\xEDa visto ya, pero no est\xE1 mal que se siga compartiendo."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796368
    m_Localized: "Hab\xEDa visto algo parecido, gracias por record\xE1rmelo."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796369
    m_Localized: "Mis amigos lo hab\xEDan mencionado, este art\xEDculo lo confirma."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796370
    m_Localized: Gracias por compartir. Da gusto ver que te preocupas por las noticias.
    m_Metadata:
      m_Items: []
  - m_Id: 20989796371
    m_Localized: Genial, gracias.
    m_Metadata:
      m_Items: []
  - m_Id: 20989796372
    m_Localized: Gracias por mantenernos informados.
    m_Metadata:
      m_Items: []
  - m_Id: 20989796373
    m_Localized: "Lo he le\xEDdo ya, pero est\xE1 bien que se siga difundiendo."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796374
    m_Localized: "Gracias por la informaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796375
    m_Localized: "\xA1Muchas gracias!"
    m_Metadata:
      m_Items: []
  - m_Id: 20989796376
    m_Localized: "\xA1Qu\xE9 interesante! Gracias."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796377
    m_Localized: "Anda, no sab\xEDa esto."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796378
    m_Localized: Me lo guardo para luego.
    m_Metadata:
      m_Items: []
  - m_Id: 20989796379
    m_Localized: "Mira, quer\xEDa infomarme m\xE1s de esto, gracias."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796380
    m_Localized: "S\xED, algo hab\xEDa o\xEDdo de esto."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796381
    m_Localized: Gracias por compartir.
    m_Metadata:
      m_Items: []
  - m_Id: 20989796382
    m_Localized: Bien, gracias.
    m_Metadata:
      m_Items: []
  - m_Id: 20989796383
    m_Localized: "\xA1Mira qu\xE9 cosas! Gracias."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796384
    m_Localized: "Esto da qu\xE9 pensar, te lo agradezco."
    m_Metadata:
      m_Items: []
  references:
