  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: ASSISTANT_ADVICES_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: a2386069f033e25449721c41e84cb377, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 106963898368
    m_Localized: I think you're not paying close attention to what you're reading.
    m_Metadata:
      m_Items: []
  - m_Id: 107031007232
    m_Localized: You have shared some hoaxes, despite having read the articles.
    m_Metadata:
      m_Items: []
  - m_Id: 107031007233
    m_Localized: "Intenta fijarte m\xE1s en si apelan a tus emociones"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007234
    m_Localized: Or if the wording seems professional
    m_Metadata:
      m_Items: []
  - m_Id: 107031007235
    m_Localized: And don't forget to check the source!
    m_Metadata:
      m_Items: []
  - m_Id: 107031007236
    m_Localized: You're not reading things before sharing them...
    m_Metadata:
      m_Items: []
  - m_Id: 107031007237
    m_Localized: That makes you spread more rumors.
    m_Metadata:
      m_Items: []
  - m_Id: 107031007238
    m_Localized: You need to read more articles.
    m_Metadata:
      m_Items: []
  - m_Id: 107031007239
    m_Localized: You're not reading things before sharing them...
    m_Metadata:
      m_Items: []
  - m_Id: 107035201536
    m_Localized: You're lucky that some of them are true.
    m_Metadata:
      m_Items: []
  - m_Id: 107035201537
    m_Localized: But this is not always the case.
    m_Metadata:
      m_Items: []
  - m_Id: 107035201538
    m_Localized: You need to read more articles.
    m_Metadata:
      m_Items: []
  - m_Id: 107035201539
    m_Localized: You're not reading things before skipping them...
    m_Metadata:
      m_Items: []
  - m_Id: 107035201540
    m_Localized: You can't dismiss things so quickly just based on a headline.
    m_Metadata:
      m_Items: []
  - m_Id: 107035201541
    m_Localized: You should stop and read it and assess its veracity.
    m_Metadata:
      m_Items: []
  - m_Id: 18859510659207168
    m_Localized: You can SHARE the article o ignore it by pressing the "SKIP" button
    m_Metadata:
      m_Items: []
  - m_Id: 18859510810202112
    m_Localized: You can reed the article by pressing "READ". Or ignore it by pressing
      "SKIP"
    m_Metadata:
      m_Items: []
  - m_Id: 18859510810202113
    m_Localized: 'Reminder: You can scroll the screen using your finger'
    m_Metadata:
      m_Items: []
  - m_Id: 19133294825885696
    m_Localized: Welcome to the game!
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023040
    m_Localized: I'm your personal assistant
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023041
    m_Localized: If I see you getting stuck during the game, I will give you an advice
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023042
    m_Localized: Readme and press the "OK" button at the bottom of the screen to
      get rid of my message
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023043
    m_Localized: In the green face, in the upper right of the screen, you can see
      how I am
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023044
    m_Localized: If you see me turn yellow...
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605952
    m_Localized: That's because I have to give an advice!
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605957
    m_Localized: Let's try it
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605953
    m_Localized: Great!
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605954
    m_Localized: You have seen me worried and paid attention to me hehe
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605955
    m_Localized: When this happens during the game, I will give you advice
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605956
    m_Localized: Because you could improve your behaviour
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605958
    m_Localized: And now, I hope I don't annoy you anymore!
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605959
    m_Localized: That would mean you're doing just fine
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605960
    m_Localized: Have fun!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
