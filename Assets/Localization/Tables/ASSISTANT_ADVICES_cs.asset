  m_SharedData: {fileID: 11400000, guid: a2386069f033e25449721c41e84cb377, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 106963898368
    m_Localized: "Mysl\xEDm, \u017Ee si dob\u0159e nev\u0161\xEDm\xE1\u0161 toho,
      co \u010Dte\u0161."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007232
    m_Localized: "Sd\xEDlel jsi n\u011Bkter\xE9 f\xE1my, p\u0159esto\u017Ee jsi \u010Detl
      \u010Dl\xE1nky."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007233
    m_Localized: "Sna\u017E se v\xEDce vn\xEDmat, zda apeluj\xED na tv\xE9 emoce."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007234
    m_Localized: "Nebo zda text p\u016Fsob\xED profesion\xE1ln\u011B"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007235
    m_Localized: "A nezapome\u0148te zkontrolovat zdroj!"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007236
    m_Localized: "Ne\u010Dte\u0161 si v\u011Bci p\u0159edt\xEDm, ne\u017E je sd\xEDl\xED\u0161..."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007237
    m_Localized: "To t\u011B nut\xED \u0161\xED\u0159it dal\u0161\xED f\xE1my."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007238
    m_Localized: "Mus\xED\u0161 \u010D\xEDst v\xEDce \u010Dl\xE1nk\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007239
    m_Localized: "Ne\u010Dte\u0161 si v\u011Bci p\u0159edt\xEDm, ne\u017E je sd\xEDl\xED\u0161..."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201536
    m_Localized: "M\xE1\u0161 \u0161t\u011Bst\xED, \u017Ee n\u011Bkter\xE9 z nich
      jsou pravdiv\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201537
    m_Localized: "Ale nen\xED tomu tak v\u017Edy."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201538
    m_Localized: "Mus\xED\u0161 \u010D\xEDst v\xEDce \u010Dl\xE1nk\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201539
    m_Localized: "Ne\u010Dte\u0161 v\u011Bci, ne\u017E je p\u0159esko\u010D\xED\u0161..."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201540
    m_Localized: "Nem\u016F\u017Eete v\u011Bci tak rychle zavrhnout jen na z\xE1klad\u011B
      titulku."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201541
    m_Localized: "M\u011Bl byste se zastavit, p\u0159e\u010D\xEDst si to a posoudit
      jeho pravdivost."
    m_Metadata:
      m_Items: []
  references:
    version: 2
