  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: ASSISTANT_ADVICES_cs
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: cs
  m_SharedData: {fileID: 11400000, guid: a2386069f033e25449721c41e84cb377, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 106963898368
    m_Localized: "N\u011Bkter\xE9 \u010Dl\xE1nky, kter\xE9 jste doporu\u010Dili,
      m\u011Bly znaky ned\u016Fv\u011Bryhodn\xE9ho zdroje."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007232
    m_Localized: "Nebo zda text p\u016Fsob\xED profesion\xE1ln\u011B"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007236
    m_Localized: "N\u011Bkter\xE9 \u010Dl\xE1nky jste doporu\u010Dili, ani\u017E
      byste je \u010Detli."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007237
    m_Localized: "Samotn\xFD titulek m\u016F\u017Ee b\xFDt zav\xE1d\u011Bj\xEDc\xED.
      Zkuste si p\u0159\xED\u0161t\u011B \u010Dl\xE1nek aspo\u0148 otev\u0159\xEDt."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007239
    m_Localized: "Ne\u010Dte\u0161 si v\u011Bci p\u0159edt\xEDm, ne\u017E je sd\xEDl\xED\u0161..."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201536
    m_Localized: "Ale nen\xED tomu tak v\u017Edy."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201539
    m_Localized: "Ne\u010Dte\u0161 v\u011Bci, ne\u017E je p\u0159esko\u010D\xED\u0161..."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201540
    m_Localized: "Nem\u016F\u017Eete v\u011Bci tak rychle zavrhnout jen na z\xE1klad\u011B
      titulku."
    m_Metadata:
      m_Items: []
  - m_Id: 18859510659207168
    m_Localized: "Nyn\xED m\u016F\u017Ee\u0161 \u010Dl\xE1nek sd\xEDlet nebo jej
      p\u0159esko\u010Dit kliknut\xEDm na tla\u010D\xEDtko \u201EP\u0159esko\u010Dit\u201C"
    m_Metadata:
      m_Items: []
  - m_Id: 18859510810202112
    m_Localized: "\u010Cl\xE1nek si m\u016F\u017Eete p\u0159e\u010D\xEDst kliknut\xEDm
      na tla\u010D\xEDtko \u201E\u010C\xEDst\u201C. Nebo jej m\u016F\u017Eete p\u0159esko\u010Dit
      kliknut\xEDm na tla\u010D\xEDtko \u201EP\u0159esko\u010Dit\u201C"
    m_Metadata:
      m_Items: []
  - m_Id: 18859510810202113
    m_Localized: "Nezapome\u0148! M\u016F\u017Ee\u0161 prstem posouvat obrazovku"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294825885696
    m_Localized: "V\xEDtej ve h\u0159e!"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023040
    m_Localized: "Jsem tv\u016Fj osobn\xED asistent."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023041
    m_Localized: "Pokud uvid\xEDm, \u017Ee se zasekne\u0161, porad\xEDm ti, jak d\xE1l."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023042
    m_Localized: "P\u0159e\u010Dti si m\u011B a klikni na tla\u010D\xEDtko \u201EOK\u201C,
      na kter\xE9 pr\xE1v\u011B klik\xE1\u0161, abys tuto zpr\xE1vu zav\u0159el."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023043
    m_Localized: "Na zelen\xE9 tv\xE1\u0159i\u010Dce vpravo naho\u0159e m\u016F\u017Ee\u0161
      vid\u011Bt, jak se m\xE1m."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023044
    m_Localized: "Pokud m\u011B n\u011Bkdy uvid\xED\u0161 \u017Elut\xE9ho..."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605952
    m_Localized: "Znamen\xE1 to, \u017Ee ti mus\xEDm d\xE1t n\u011Bjakou radu!"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605957
    m_Localized: "Poj\u010Fme to vyzkou\u0161et."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605953
    m_Localized: "Skv\u011Bl\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605954
    m_Localized: "Vid\u011Bl jsi, \u017Ee se o tebe boj\xEDm, a poslechl jsi m\u011B,
      hehe."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605955
    m_Localized: "Kdy\u017E se to stane ve h\u0159e, d\xE1m ti n\u011Bjakou radu."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605956
    m_Localized: "Proto\u017Ee ur\u010Dit\u011B je tu n\u011Bco, co bys mohl vylep\u0161it."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605958
    m_Localized: "To jsem cht\u011Bl \u0159\xEDct, douf\xE1m, \u017Ee u\u017E t\u011B
      nebudu otravovat!"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605959
    m_Localized: "Proto\u017Ee to bude znamenat, \u017Ee to d\u011Bl\xE1\u0161 dob\u0159e."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605960
    m_Localized: "Hodn\u011B \u0161t\u011Bst\xED ve h\u0159e!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
