MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: ASSISTANT_ADVICES_cs
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: cs
  m_SharedData: {fileID: 11400000, guid: a2386069f033e25449721c41e84cb377, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 106963898368
    m_Localized: "N\u011Bkter\xE9 \u010Dl\xE1nky, kter\xE9 jste doporu\u010Dili,
      m\u011Bly znaky ned\u016Fv\u011Bryhodn\xE9ho zdroje."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007232
    m_Localized: "Zkuste si p\u0159\xED\u0161t\u011B v\u0161\xEDmat: vyvol\xE1v\xE1
      ve mn\u011B obsah siln\xE9 emoce? To m\u016F\u017Ee b\xFDt z\xE1m\u011Br."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007236
    m_Localized: "N\u011Bkter\xE9 \u010Dl\xE1nky jste doporu\u010Dili, ani\u017E
      byste je \u010Detli."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007237
    m_Localized: "Samotn\xFD titulek m\u016F\u017Ee b\xFDt zav\xE1d\u011Bj\xEDc\xED.
      Zkuste si p\u0159\xED\u0161t\u011B \u010Dl\xE1nek aspo\u0148 otev\u0159\xEDt."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007239
    m_Localized: "N\u011Bkter\xE9 \u010Dl\xE1nky jste doporu\u010Dili, ani\u017E
      byste je \u010Detli. Tentokr\xE1t to vy\u0161lo."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201536
    m_Localized: "Ale p\u0159\xED\u0161t\u011B to tak dopadnout nemus\xED. Zkuste
      si obsah nejprve p\u0159e\u010D\xEDst."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201539
    m_Localized: "Zahazujete obsah, ani\u017E byste si jej p\u0159e\u010Detli."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201540
    m_Localized: "Zahodit je v po\u0159\xE1dku. Ale zkuste se aspo\u0148 pod\xEDvat
      na zdroj."
    m_Metadata:
      m_Items: []
  - m_Id: 18859510659207168
    m_Localized: "Nyn\xED m\u016F\u017Eete obsah doporu\u010Dit, nebo ho zahodit
      kliknut\xEDm na tla\u010D\xEDtko \u201EZahodit\"."
    m_Metadata:
      m_Items: []
  - m_Id: 18859510810202112
    m_Localized: "Obsah si m\u016F\u017Eete p\u0159e\u010D\xEDst kliknut\xEDm na
      tla\u010D\xEDtko \u201EP\u0159e\u010D\xEDst\". Nebo ho m\u016F\u017Eete zahodit
      kliknut\xEDm na tla\u010D\xEDtko \u201EZahodit\"."
    m_Metadata:
      m_Items: []
  - m_Id: 18859510810202113
    m_Localized: "Nezapome\u0148te! M\u016F\u017Eete prstem posouvat obrazovku."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294825885696
    m_Localized: "V\xEDtejte ve h\u0159e!"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023040
    m_Localized: "Jsem v\xE1\u0161 osobn\xED pr\u016Fvodce."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023041
    m_Localized: "Pokud uvid\xEDm, \u017Ee pot\u0159ebujete poradit, nab\xEDdnu v\xE1m
      tip."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023042
    m_Localized: "P\u0159e\u010Dt\u011Bte si, co v\xE1m \u0159\xEDk\xE1m, a klikn\u011Bte
      na tla\u010D\xEDtko OK v doln\xED \u010D\xE1sti obrazovky."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023043
    m_Localized: "Na zelen\xE9 ikon\u011B vpravo naho\u0159e uvid\xEDte, jak si vedete."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023044
    m_Localized: "Pokud m\u011B uvid\xEDte \u017Elut\xE9ho..."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605952
    m_Localized: "Znamen\xE1 to, \u017Ee pro v\xE1s m\xE1m radu!"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605957
    m_Localized: "Poj\u010Fme to vyzkou\u0161et."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605953
    m_Localized: "Skv\u011Bl\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605954
    m_Localized: "V\u0161imli jste si, \u017Ee jsem zm\u011Bnil barvu? V\xFDborn\u011B!"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605955
    m_Localized: "Kdy\u017E se to stane ve h\u0159e, nab\xEDdnu v\xE1m radu."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605956
    m_Localized: "Proto\u017Ee v\xE1m chci pomoct se v tom l\xE9pe zorientovat."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605958
    m_Localized: "To je ode m\u011B v\u0161e. Douf\xE1m, \u017Ee v\xE1s nebudu moc
      zdr\u017Eovat!"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605959
    m_Localized: "Proto\u017Ee to bude znamenat, \u017Ee si vedete dob\u0159e."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605960
    m_Localized: "Hodn\u011B zdaru!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
