      \u0438 \u043D\u0438\u0432\u043E\u0442\u043E \u043D\u0430 \u0434\u0435\u0442\u0430\u0439\u043B\u043D\u043E\u0441\u0442
      \u043D\u0430 \u0432\u0441\u044F\u043A\u0430 \u0438\u0441\u0442\u043E\u0440\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140050
    m_Localized: "\u0410\u043A\u043E \u0440\u0430\u0437\u0431\u0435\u0440\u0430,
      \u0447\u0435 \u0431\u043B\u0438\u0437\u044A\u043A \u0447\u043E\u0432\u0435\u043A
      \u043C\u0438 \u0435 \u0438\u0437\u043F\u0440\u0430\u0442\u0438\u043B \u043D\u0435\u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u0430
      \u043D\u043E\u0432\u0438\u043D\u0430, \u043F\u043E-\u0434\u043E\u0431\u0440\u0435
      \u0435 \u0434\u0430 \u043D\u0435 \u043C\u0443 \u043A\u0430\u0437\u0432\u0430\u043C
      \u043D\u0438\u0449\u043E, \u043E\u0442\u043A\u043E\u043B\u043A\u043E\u0442\u043E
      \u0434\u0430 \u0438\u0437\u0440\u0430\u0437\u044F \u043C\u043D\u0435\u043D\u0438\u0435\u0442\u043E
      \u0441\u0438. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140051
    m_Localized: "\u0410\u043A\u043E \u0447\u0443\u0432\u0430\u043C \u0434\u0430\u0434\u0435\u043D\u0430
      \u043D\u043E\u0432\u0438\u043D\u0430 \u043C\u043D\u043E\u0433\u043E \u0447\u0435\u0441\u0442\u043E
