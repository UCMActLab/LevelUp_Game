      \u0447\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430
      \u0435 \u0432\u044F\u0440\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552045854721
    m_Localized: "\u041C\u043D\u043E\u0433\u043E \u0434\u043E\u0431\u0440\u0435!
      \u0415\u0437\u0438\u043A\u044A\u0442 \u043C\u043E\u0436\u0435 \u0434\u0430
      \u0431\u044A\u0434\u0435 \u0434\u043E\u0431\u044A\u0440 \u0438\u043D\u0434\u0438\u043A\u0430\u0442\u043E\u0440.
      \u0414\u0435\u0437\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430
      \u043E\u0431\u0438\u043A\u043D\u043E\u0432\u0435\u043D\u043E \u0438\u0437\u043F\u043E\u043B\u0437\u0432\u0430
      \u043F\u043E-\u0435\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u0435\u043D,
      \u0430\u043B\u0430\u0440\u043C\u0438\u0441\u0442\u043A\u0438 \u0438\u043B\u0438
      \u0441\u0435\u043D\u0437\u0430\u0446\u0438\u043E\u043D\u0435\u043D \u0435\u0437\u0438\u043A. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552054243328
    m_Localized: "\u0412\u043D\u0438\u043C\u0430\u0432\u0430\u0439! \u0422\u043E\u0432\u0430
