      \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0432\u0430\u0449\u0438 \u043E\u0440\u0433\u0430\u043D\u0438. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552305901568
    m_Localized: "\u0422\u043E\u0447\u043D\u043E \u0442\u0430\u043A\u0430! \u041F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0438\u044F\u0442\u0430
      \u0435 \u0434\u043E\u043A\u0430\u0437\u0430\u043B\u0430, \u0447\u0435 \u043A\u043E\u0433\u0430\u0442\u043E
      \u0441\u043C\u0435 \u044F\u0434\u043E\u0441\u0430\u043D\u0438, \u0441\u043C\u0435
      \u043F\u043E-\u043F\u043E\u0434\u0430\u0442\u043B\u0438\u0432\u0438 \u043D\u0430
      \u0432\u043B\u0438\u044F\u043D\u0438\u0435, \u0443\u0431\u0435\u0436\u0434\u0430\u0432\u0430\u043D\u0435
      \u0438 \u0434\u0435\u0437\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F.
      \u0410\u043A\u043E \u0432\u0438\u0434\u0438\u0442\u0435, \u0447\u0435 \u0434\u0430\u0434\u0435\u043D\u0430
      \u043D\u043E\u0432\u0438\u043D\u0430 \u0432\u0438 \u044F\u0434\u043E\u0441\u0432\u0430
