      \u0441\u0440\u0430\u0432\u043D\u044F\u0432\u0430\u0442\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430,
      \u0437\u0430 \u0434\u0430 \u0432\u0438\u0434\u0438\u0442\u0435 \u0434\u0440\u0443\u0433\u0438
      \u0433\u043B\u0435\u0434\u043D\u0438 \u0442\u043E\u0447\u043A\u0438. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552452702208
    m_Localized: "\u0414\u0430, \u0442\u0430\u043A\u0430 \u0435. \u041D\u044F\u043A\u043E\u0438
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
      \u043C\u043E\u0433\u0430\u0442 \u0434\u0430 \u043D\u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u044F\u0442
      \u043F\u043E-\u043F\u043E\u0434\u0430\u0442\u043B\u0438\u0432\u0438 \u043D\u0430
      \u0434\u0435\u0437\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F.
      \u0417\u0430\u0442\u043E\u0432\u0430 \u0435 \u0432\u0430\u0436\u043D\u043E
      \u0434\u0430 \u0441\u0435 \u043F\u0440\u0435\u0434\u043F\u0430\u0437\u0432\u0430\u043C\u0435
      \u0438 \u0434\u0430 \u0441\u043B\u0435\u0434\u0432\u0430\u043C\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u0430
      \u0437\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442,
      \u043A\u0430\u0442\u043E \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 \u0434\u0430
      \u0447\u0435\u0442\u0435\u043C \u0446\u044F\u043B\u0430\u0442\u0430 \u043D\u043E\u0432\u0438\u043D\u0430
      \u0438\u043B\u0438 \u0434\u0430 \u0441\u0440\u0430\u0432\u043D\u044F\u0432\u0430\u043C\u0435
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552461090816
    m_Localized: "\u0412\u043D\u0438\u043C\u0430\u0432\u0430\u0439\u0442\u0435, \u0442\u043E\u0432\u0430
      \u0435 \u0432\u044F\u0440\u043D\u043E. \u041D\u044F\u043A\u043E\u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
      \u043C\u043E\u0433\u0430\u0442 \u0434\u0430 \u043D\u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u044F\u0442
      \u043F\u043E-\u043F\u043E\u0434\u0430\u0442\u043B\u0438\u0432\u0438 \u043D\u0430
      \u0434\u0435\u0437\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F.
      \u0417\u0430\u0442\u043E\u0432\u0430 \u0435 \u0432\u0430\u0436\u043D\u043E
