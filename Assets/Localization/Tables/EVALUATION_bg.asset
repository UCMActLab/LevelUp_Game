      \u0435\u0437\u0438\u043A. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552020688896
    m_Localized: "\u0412\u043D\u0438\u043C\u0430\u0432\u0430\u0439\u0442\u0435, \u0442\u043E\u0432\u0430
      \u0435 \u0438\u0441\u0442\u0438\u043D\u0430! \u0427\u0435\u0442\u0435\u043D\u0435\u0442\u043E
      \u043D\u0430 \u0446\u044F\u043B\u0430\u0442\u0430 \u043D\u043E\u0432\u0438\u043D\u0430
      \u043D\u0438 \u043F\u043E\u043C\u0430\u0433\u0430 \u0434\u0430 \u043E\u0446\u0435\u043D\u0438\u043C
      \u043D\u0435\u0439\u043D\u0430\u0442\u0430 \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u043E\u0441\u0442,
      \u0442\u044A\u0439 \u043A\u0430\u0442\u043E \u043C\u043E\u0436\u0435\u043C
