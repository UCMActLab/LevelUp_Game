      \u043C\u043E\u0433\u0430\u0442 \u0434\u0430 \u043D\u0438 \u043F\u043E\u043C\u043E\u0433\u043D\u0430\u0442
      \u0434\u0430 \u0440\u0430\u0437\u0431\u0435\u0440\u0435\u043C \u0434\u0430\u043B\u0438
      \u0434\u0430\u0434\u0435\u043D\u0430 \u043D\u043E\u0432\u0438\u043D\u0430 \u0435
      \u0430\u043A\u0442\u0443\u0430\u043B\u043D\u0430 \u0438\u043B\u0438 \u0435
      \u0438\u0437\u0432\u0430\u0434\u0435\u043D\u0430 \u043E\u0442 \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u0430. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552100380672
    m_Localized: "\u041E\u043F\u0430! \u0422\u043E\u0432\u0430 \u0435 \u0444\u0430\u043B\u0448\u0438\u0432\u0430
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F. \u0414\u0430\u0442\u0438\u0442\u0435
      \u043D\u0430 \u043F\u0443\u0431\u043B\u0438\u043A\u0443\u0432\u0430\u043D\u0435
      \u043C\u043E\u0433\u0430\u0442 \u0434\u0430 \u043D\u0438 \u043F\u043E\u043C\u043E\u0433\u043D\u0430\u0442
      \u0434\u0430 \u0440\u0430\u0437\u0431\u0435\u0440\u0435\u043C \u0434\u0430\u043B\u0438
      \u0434\u0430\u0434\u0435\u043D\u0430 \u043D\u043E\u0432\u0438\u043D\u0430 \u0435
      \u0430\u043A\u0442\u0443\u0430\u043B\u043D\u0430 \u0438\u043B\u0438 \u0435
      \u0438\u0437\u0432\u0430\u0434\u0435\u043D\u0430 \u043E\u0442 \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u0430. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552108769280
    m_Localized: "\u0414\u0430, \u0442\u043E\u0432\u0430 \u0435 \u0432\u044F\u0440\u043D\u043E.
      \u041D\u0430\u0434\u0435\u0436\u0434\u043D\u0438\u0442\u0435 \u043D\u043E\u0432\u0438\u043D\u0438
      \u043E\u0431\u0438\u043A\u043D\u043E\u0432\u0435\u043D\u043E \u0441\u0435 \u0441\u0442\u0440\u0435\u043C\u044F\u0442
      \u043A\u044A\u043C \u043E\u0431\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442
      \u0438 \u043D\u0435\u0443\u0442\u0440\u0430\u043B\u043D\u043E\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552112963584
    m_Localized: "\u0422\u043E\u0432\u0430 \u0435 \u043D\u0435\u0432\u044F\u0440\u043D\u043E.
      \u041D\u0430\u0434\u0435\u0436\u0434\u043D\u0438\u0442\u0435 \u043D\u043E\u0432\u0438\u043D\u0438
      \u043E\u0431\u0438\u043A\u043D\u043E\u0432\u0435\u043D\u043E \u0441\u0435 \u0441\u0442\u0440\u0435\u043C\u044F\u0442
      \u043A\u044A\u043C \u043E\u0431\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442
      \u0438 \u043D\u0435\u0443\u0442\u0440\u0430\u043B\u043D\u043E\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552117157888
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u043D\u043E!! \u041D\u0415
      \u0432\u0441\u0438\u0447\u043A\u043E, \u043A\u043E\u0435\u0442\u043E \u0441\u0435
      \u043F\u0443\u0431\u043B\u0438\u043A\u0443\u0432\u0430 \u0432 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442,
      \u0435 \u0432\u044F\u0440\u043D\u043E. \u041C\u043D\u043E\u0433\u043E \u0435
      \u0432\u0430\u0436\u043D\u043E \u0434\u0430 \u0441\u0435 \u043E\u0431\u0440\u044A\u0449\u0430\u0442\u0435
      \u043A\u044A\u043C \u043D\u0430\u0434\u0435\u0436\u0434\u043D\u0438 \u0438
      \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u043D\u0438 \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u0446\u0438,
      \u0437\u0430 \u0434\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u0435
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552121352192
    m_Localized: "\u0413\u0440\u0435\u0448\u0438\u0448, \u0442\u043E\u0432\u0430
      \u0435 \u043D\u0435\u0432\u044F\u0440\u043D\u043E. \u041D\u0415 \u0432\u0441\u0438\u0447\u043A\u043E,
      \u043A\u043E\u0435\u0442\u043E \u0441\u0435 \u043F\u0443\u0431\u043B\u0438\u043A\u0443\u0432\u0430
      \u0432 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442, \u0435 \u0432\u044F\u0440\u043D\u043E.
      \u041C\u043D\u043E\u0433\u043E \u0435 \u0432\u0430\u0436\u043D\u043E \u0434\u0430
      \u0441\u0435 \u043E\u0431\u0440\u044A\u0449\u0430\u0448 \u043A\u044A\u043C
      \u043D\u0430\u0434\u0435\u0436\u0434\u043D\u0438 \u0438 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u043D\u0438
      \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u0446\u0438, \u0437\u0430 \u0434\u0430
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0448 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552129740800
    m_Localized: "\u0422\u043E\u0447\u043D\u043E \u0442\u0430\u043A\u0430. \u0412\u0438\u043D\u0430\u0433\u0438
      \u0435 \u0432\u0430\u0436\u043D\u043E \u0434\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0432\u0430\u043C\u0435
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430. \u041F\u043E\u043D\u044F\u043A\u043E\u0433\u0430
      \u0445\u043E\u0440\u0430\u0442\u0430 \u043C\u043E\u0433\u0430\u0442 \u0434\u0430
      \u043D\u0438 \u0441\u043F\u043E\u0434\u0435\u043B\u044F\u0442 \u043D\u0435\u0432\u044F\u0440\u043D\u0430
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F, \u0431\u0435\u0437
      \u0434\u0430 \u0433\u043E \u043E\u0441\u044A\u0437\u043D\u0430\u0432\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552133935104
    m_Localized: "\u0412\u043D\u0438\u043C\u0430\u0432\u0430\u0439, \u0442\u043E\u0432\u0430
      \u0435 \u0444\u0430\u043B\u0448\u0438\u0432\u0430 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F.
      \u0412\u0438\u043D\u0430\u0433\u0438 \u0435 \u0432\u0430\u0436\u043D\u043E
      \u0434\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0432\u0430\u0448 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430.
      \u041F\u043E\u043D\u044F\u043A\u043E\u0433\u0430 \u0445\u043E\u0440\u0430\u0442\u0430
      \u043C\u043E\u0433\u0430\u0442 \u0434\u0430 \u0441\u043F\u043E\u0434\u0435\u043B\u044F\u0442
      \u0441 \u043D\u0430\u0441 \u043D\u0435\u0432\u044F\u0440\u043D\u0430 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F,
      \u0431\u0435\u0437 \u0434\u0430 \u0433\u043E \u043E\u0441\u044A\u0437\u043D\u0430\u0432\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552133935105
    m_Localized: "\u041C\u043D\u043E\u0433\u043E \u0434\u043E\u0431\u0440\u0435!
      \u041A\u043E\u0433\u0430\u0442\u043E \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u043A\u044A\u0442
