  - m_Id: 28213552414953472
    m_Localized: "\u041D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u043D\u043E! \u041D\u0435
      \u0437\u0430\u0431\u0440\u0430\u0432\u044F\u0439\u0442\u0435, \u0447\u0435
      \u0435\u043A\u0441\u043F\u0435\u0440\u0442\u043D\u0438\u0442\u0435 \u0438 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u043D\u0438\u0442\u0435
      \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u0446\u0438 \u043E\u0431\u0438\u043A\u043D\u043E\u0432\u0435\u043D\u043E
      \u0441\u0430 \u043D\u0430\u0439-\u043D\u0430\u0434\u0435\u0436\u0434\u043D\u0438. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552431730688
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u043D\u043E. \u0412\u0430\u0436\u043D\u043E
      \u0435 \u0434\u0430 \u0437\u0430\u043F\u0430\u0437\u0438\u0442\u0435 \u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0438\u0435
      \u0438 \u0434\u0430 \u043F\u043E\u0442\u0432\u044A\u0440\u0434\u0438\u0442\u0435,
      \u0447\u0435 \u0441\u0438\u0433\u043D\u0430\u043B\u044A\u0442 \u0435 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u0435\u043D.
      \u0420\u0430\u0437\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0432\u0430\u043D\u0435\u0442\u043E
      \u043D\u0430 \u0441\u0438\u0433\u043D\u0430\u043B \u0437\u0430 \u0441\u043F\u0435\u0448\u043D\u0430
      \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F \u0431\u0435\u0437 \u0434\u0430
      \u0433\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u0435 \u043F\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u043D\u043E
      \u043C\u043E\u0436\u0435 \u0434\u0430 \u0434\u043E\u0432\u0435\u0434\u0435
      \u0434\u043E \u0445\u0430\u043E\u0441. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552435924992
    m_Localized: "\u041D\u0435 \u0443\u0441\u043F\u044F. \u041D\u0435 \u0437\u0430\u0431\u0440\u0430\u0432\u044F\u0439,
      \u0447\u0435 \u0435 \u0432\u0430\u0436\u043D\u043E \u0434\u0430 \u0437\u0430\u043F\u0430\u0437\u0438\u0448
      \u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0438\u0435 \u0438 \u0434\u0430
      \u043F\u043E\u0442\u0432\u044A\u0440\u0434\u0438\u0448, \u0447\u0435 \u0441\u0438\u0433\u043D\u0430\u043B\u044A\u0442
      \u0435 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u0435\u043D. \u0420\u0430\u0437\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0432\u0430\u043D\u0435\u0442\u043E
      \u043D\u0430 \u0441\u0438\u0433\u043D\u0430\u043B \u0437\u0430 \u0441\u043F\u0435\u0448\u043D\u0430
      \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F, \u0431\u0435\u0437 \u0434\u0430
      \u0433\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0448 \u043F\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u043D\u043E,
      \u043C\u043E\u0436\u0435 \u0434\u0430 \u0434\u043E\u0432\u0435\u0434\u0435
      \u0434\u043E \u0445\u0430\u043E\u0441. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552440119296
    m_Localized: "\u041F\u0435\u0440\u0444\u0435\u043A\u0442\u043D\u043E! \u0414\u0430
      \u0441\u0440\u0430\u0432\u043D\u044F\u0432\u0430\u0448 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F,
      \u0437\u0430 \u0434\u0430 \u0432\u0438\u0434\u0438\u0448 \u0434\u0440\u0443\u0433\u0438
