  - m_Id: 7138285844140049
    m_Localized: "\u0412\u0441\u044F\u043A\u0430 \u043C\u0435\u0434\u0438\u044F \u0438\u043C\u0430
      \u043F\u043E\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043F\u0440\u0438\u0441\u0442\u0440\u0430\u0441\u0442\u0438\u044F,
      \u043A\u043E\u0438\u0442\u043E \u0432\u043B\u0438\u044F\u044F\u0442 \u043D\u0430
      \u043D\u0430\u0447\u0438\u043D\u0430, \u043F\u043E \u043A\u043E\u0439\u0442\u043E
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044F \u043D\u043E\u0432\u0438\u043D\u0438\u0442\u0435
      \u0438 \u043D\u0438\u0432\u043E\u0442\u043E \u043D\u0430 \u0434\u0435\u0442\u0430\u0439\u043B\u043D\u043E\u0441\u0442
      \u043D\u0430 \u0432\u0441\u044F\u043A\u0430 \u0438\u0441\u0442\u043E\u0440\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140050
    m_Localized: "\u0410\u043A\u043E \u0440\u0430\u0437\u0431\u0435\u0440\u0430,
      \u0447\u0435 \u0431\u043B\u0438\u0437\u044A\u043A \u0447\u043E\u0432\u0435\u043A
      \u043C\u0438 \u0435 \u0438\u0437\u043F\u0440\u0430\u0442\u0438\u043B \u0444\u0430\u043B\u0448\u0438\u0432\u0430
      \u043D\u043E\u0432\u0438\u043D\u0430, \u043F\u043E-\u0434\u043E\u0431\u0440\u0435
      \u0435 \u0434\u0430 \u043D\u0435 \u043C\u0443 \u043A\u0430\u0437\u0432\u0430\u043C
      \u043D\u0438\u0449\u043E, \u043E\u0442\u043A\u043E\u043B\u043A\u043E\u0442\u043E
      \u0434\u0430 \u0438\u0437\u0440\u0430\u0437\u044F \u043C\u043D\u0435\u043D\u0438\u0435\u0442\u043E
      \u0441\u0438. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140051
    m_Localized: "\u0410\u043A\u043E \u0447\u0443\u0432\u0430\u043C \u0434\u0430\u0434\u0435\u043D\u0430
      \u043D\u043E\u0432\u0438\u043D\u0430 \u043C\u043D\u043E\u0433\u043E \u0447\u0435\u0441\u0442\u043E
      \u0432 \u043C\u0435\u0434\u0438\u0438\u0442\u0435, \u0437\u043D\u0430\u0447\u0438
      \u0442\u044F \u0442\u0440\u044F\u0431\u0432\u0430 \u0434\u0430 \u0435 \u0438\u0441\u0442\u0438\u043D\u0441\u043A\u0430. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140052
    m_Localized: "\u041F\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u043E, \u043A\u043E\u0433\u0430\u0442\u043E
      \u043E\u0446\u0435\u043D\u044F\u0432\u0430\u043C\u0435 \u0438\u043D\u0442\u0435\u0440\u0432\u044E\u0442\u0430,
      \u043F\u043E-\u043D\u0430\u0434\u0435\u0436\u0434\u043D\u0438 \u0441\u0430
      \u0442\u0435\u0437\u0438, \u043A\u043E\u0438\u0442\u043E \u0438\u043D\u0442\u0435\u0440\u0432\u044E\u0438\u0440\u0430\u0442:"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140053
    m_Localized: "\u0415\u043A\u0441\u043F\u0435\u0440\u0442\u0438 / \u0443\u0447\u0435\u043D\u0438
      \u043F\u043E \u0442\u0435\u043C\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140054
    m_Localized: "\u0410\u043D\u043E\u043D\u0438\u043C\u043D\u043E \u0438\u043D\u0442\u0435\u0440\u0432\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140055
    m_Localized: "\u041E\u0431\u0449 \u043A\u043E\u043D\u0441\u0435\u043D\u0441\u0443\u0441
      (\u0430\u043D\u043A\u0435\u0442\u0438, \u043F\u0440\u043E\u0443\u0447\u0432\u0430\u043D\u0438\u044F)"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140056
    m_Localized: "\u041A\u043E\u0435 \u043E\u0442 \u0441\u043B\u0435\u0434\u043D\u0438\u0442\u0435
      \u0437\u0430\u0433\u043B\u0430\u0432\u0438\u044F \u0435 \u043F\u043E-\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E
      \u0434\u0430 \u0435 \u0438\u0441\u0442\u0438\u043D\u0441\u043A\u043E:"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140057
    m_Localized: "\u041D\u044F\u043C\u0430 \u0434\u0430 \u043F\u043E\u0432\u044F\u0440\u0432\u0430\u0442\u0435
      \u043A\u0430\u043A\u0432\u043E \u043D\u043E\u0432\u043E \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E
      \u0435 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0438\u043B\u0430 \u043D\u0430\u0443\u043A\u0430\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140058
    m_Localized: "\u041E\u0447\u0430\u043A\u0432\u0430 \u0441\u0435 \u0432\u044A\u0437\u043C\u043E\u0436\u043D\u043E
      \u043F\u043E\u0441\u043A\u044A\u043F\u0432\u0430\u043D\u0435 \u043D\u0430 \u0436\u0438\u043B\u0438\u0449\u0430\u0442\u0430
      \u043F\u043E\u0440\u0430\u0434\u0438 \u043D\u0435\u0434\u043E\u0441\u0442\u0438\u0433
      \u043D\u0430 \u0440\u0435\u0441\u0443\u0440\u0441\u0438, \u0438\u0434\u0432\u0430\u0449\u0438
      \u043E\u0442 \u0410\u0444\u0440\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140059
    m_Localized: "\u0412\u044F\u0440\u043D\u043E \u043B\u0438 \u0441\u0430 \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u044F\u0442\u0430?
      \u041D\u043E\u0432\u0438 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0441\u0442\u0432\u0430
      \u043F\u043E\u043A\u0430\u0437\u0432\u0430\u0442 \u0432\u0438\u043D\u0430\u0442\u0430
      \u043D\u0430 \u043D\u0435\u043B\u043E\u044F\u043B\u0435\u043D \u0438 \u043A\u043E\u0440\u0443\u043C\u043F\u0438\u0440\u0430\u043D
      \u043C\u0438\u043D\u0438\u0441\u0442\u044A\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334336
    m_Localized: "\u041A\u043E\u0433\u0430\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043C
      \u0441\u0438\u0433\u043D\u0430\u043B \u0437\u0430 \u0438\u0437\u0432\u044A\u043D\u0440\u0435\u0434\u043D\u0430
      \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F, \u0442\u0440\u044F\u0431\u0432\u0430
      \u0432\u0438\u043D\u0430\u0433\u0438 \u0434\u0430 \u0433\u043E \u0441\u043F\u043E\u0434\u0435\u043B\u044F\u043C\u0435
      \u0432\u0435\u0434\u043D\u0430\u0433\u0430, \u0431\u0435\u0437 \u0434\u0430
      \u0441\u0435 \u043A\u043E\u043B\u0435\u0431\u0430\u0435\u043C. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334337
    m_Localized: "\u041D\u0435 \u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u0434\u0430 \u0447\u0435\u0442\u0430 \u043D\u043E\u0432\u0438\u043D\u0438
      \u043E\u0442 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u0438 \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u0446\u0438,
      \u0430\u043A\u043E \u0442\u0435\u0437\u0438, \u043A\u043E\u0438\u0442\u043E
      \u0441\u043B\u0435\u0434\u044F, \u0441\u0430 \u043D\u0430\u0434\u0435\u0436\u0434\u043D\u0438. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334338
    m_Localized: "\u041D\u044F\u043A\u043E\u0438 \u0445\u043E\u0440\u0430 \u0441\u0430
      \u043F\u043E-\u0441\u043A\u043B\u043E\u043D\u043D\u0438 \u043E\u0442 \u0434\u0440\u0443\u0433\u0438
      \u0434\u0430 \u0440\u0430\u0437\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0432\u0430\u0442
      \u0444\u0430\u043B\u0448\u0438\u0432\u0438 \u043D\u043E\u0432\u0438\u043D\u0438. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334339
    m_Localized: "\u0412\u0430\u0436\u043D\u043E \u0435 \u0434\u0430 \u043F\u043E\u0437\u043D\u0430\u0432\u0430\u043C
      \u0440\u0435\u0434\u0430\u043A\u0446\u0438\u043E\u043D\u043D\u0430\u0442\u0430
      \u043B\u0438\u043D\u0438\u044F \u043D\u0430 \u043C\u0435\u0434\u0438\u0438\u0442\u0435,
      \u043E\u0442 \u043A\u043E\u0438\u0442\u043E \u0441\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0438\u0440\u0430\u043C. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334340
    m_Localized: "\u0410\u043A\u043E \u0432\u0435\u0447\u0435 \u0438\u043C\u0430\u043C
      \u0434\u043E\u0432\u0435\u0440\u0435\u043D\u0430 \u043C\u0435\u0434\u0438\u044F,
      \u043D\u044F\u043C\u0430 \u043D\u0443\u0436\u0434\u0430 \u0434\u0430 \u0447\u0435\u0442\u0430
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u043E\u0442 \u0434\u0440\u0443\u0433\u0438. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334341
    m_Localized: "\u0410\u043A\u043E \u0435\u0434\u043D\u0430 \u043D\u043E\u0432\u0438\u043D\u0430
      \u043E\u043F\u0438\u0441\u0432\u0430 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F,
      \u043A\u043E\u044F\u0442\u043E \u043C\u0435 \u0438\u0437\u043F\u044A\u043B\u0432\u0430
      \u0441 \u0433\u043E\u043B\u044F\u043C \u0433\u043D\u044F\u0432 \u0438\u043B\u0438
      \u0441\u0438\u043B\u043D\u043E \u043D\u0435\u0441\u044A\u0433\u043B\u0430\u0441\u0438\u0435,
      \u0432\u0430\u0436\u043D\u043E \u0435 \u0434\u0430 \u0441\u0435 \u0443\u0441\u043F\u043E\u043A\u043E\u044F
      \u043F\u0440\u0435\u0434\u0438 \u0434\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u044F
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334342
    m_Localized: "\u0412\u0430\u0436\u043D\u043E \u0435 \u0434\u0430 \u0441\u0440\u0430\u0432\u043D\u044F\u0432\u0430\u043C\u0435
      \u043D\u043E\u0432\u0438\u043D\u0438\u0442\u0435 \u0441 \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u0446\u0438,
      \u043A\u043E\u0438\u0442\u043E \u043D\u0435 \u0441\u043F\u043E\u0434\u0435\u043B\u044F\u0442
      \u0441\u044A\u0449\u0430\u0442\u0430 \u043F\u043E\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0430
      \u0438\u0434\u0435\u043E\u043B\u043E\u0433\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334343
    m_Localized: "\u0417\u0430 \u0434\u0430 \u043E\u0446\u0435\u043D\u0438\u043C
      \u043D\u0430\u0434\u0435\u0436\u0434\u043D\u043E\u0441\u0442\u0442\u0430 \u043D\u0430
      \u0434\u0430\u0434\u0435\u043D \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u043A
      \u043D\u0430 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F,
      \u0435 \u0432\u0430\u0436\u043D\u043E \u0434\u0430 \u0437\u043D\u0430\u0435\u043C
      \u043A\u043E\u0438 \u0441\u0430 \u043E\u0441\u043D\u043E\u0432\u043D\u0438\u0442\u0435
      \u043C\u0443 \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u0438 \u043F\u043E\u0434\u0434\u0440\u044A\u0436\u043D\u0438\u0446\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334344
    m_Localized: "\u041A\u043E\u0433\u0430\u0442\u043E \u0433\u043B\u0435\u0434\u0430\u043C\u0435
      \u0432\u0438\u0434\u0435\u0430 \u0438\u043B\u0438 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F
      \u043A\u044A\u043C \u0435\u0434\u043D\u0430 \u043D\u043E\u0432\u0438\u043D\u0430,
      \u0432\u0430\u0436\u043D\u043E \u0435 \u0434\u0430 \u0442\u044A\u0440\u0441\u0438\u043C
      \u0432\u043E\u0434\u043D\u0438 \u0437\u043D\u0430\u0446\u0438 \u0438\u043B\u0438
      \u0434\u0440\u0443\u0433\u0438 \u043F\u0440\u0438\u0437\u043D\u0430\u0446\u0438,
      \u0447\u0435 \u043C\u043E\u0436\u0435 \u0434\u0430 \u0441\u0430 \u0433\u0435\u043D\u0435\u0440\u0438\u0440\u0430\u043D\u0438
      \u0441 \u0438\u0437\u043A\u0443\u0441\u0442\u0432\u0435\u043D \u0438\u043D\u0442\u0435\u043B\u0435\u043A\u0442. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334345
    m_Localized: "\u0412\u044A\u0437\u043C\u043E\u0436\u043D\u0438\u0442\u0435 \u043F\u0440\u0438\u0447\u0438\u043D\u0438
      \u043D\u044F\u043A\u043E\u0439 \u0434\u0430 \u0441\u044A\u0437\u0434\u0430\u0434\u0435
      \u0444\u0430\u043B\u0448\u0438\u0432\u0430 \u043D\u043E\u0432\u0438\u043D\u0430
      \u0441\u0430:"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334346
    m_Localized: "\u041F\u043E\u043B\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334347
    m_Localized: "\u0418\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334348
    m_Localized: "\u041F\u043E\u0434\u0431\u0443\u0436\u0434\u0430\u043D\u0435 \u043A\u044A\u043C
      \u043E\u043C\u0440\u0430\u0437\u0430 \u2013 \u0435\u0434\u043D\u0430 \u043E\u0442
      \u0435\u043C\u043E\u0446\u0438\u0438\u0442\u0435, \u043A\u043E\u0438\u0442\u043E
      \u0441\u0435 \u0440\u0430\u0437\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0432\u0430\u0442
      \u043D\u0430\u0439-\u043B\u0435\u0441\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334349
    m_Localized: "\u041A\u043E\u043C\u0438\u0447\u043D\u0438 \u0438\u043B\u0438 \u043F\u043E\u0434\u0438\u0433\u0440\u0430\u0432\u0430\u0442\u0435\u043B\u043D\u0438
      \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334350
    m_Localized: "\u041F\u043E\u0440\u0430\u0434\u0438 \u0438\u0437\u043A\u0440\u0438\u0432\u0435\u043D\u043E
      \u0432\u044A\u0437\u043F\u0440\u0438\u044F\u0442\u0438\u0435 \u043D\u0430 \u0440\u0435\u0430\u043B\u043D\u043E\u0441\u0442\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334351
    m_Localized: "\u0417\u0430\u0449\u043E \u0444\u0430\u043B\u0448\u0438\u0432\u0438\u0442\u0435
      \u043D\u043E\u0432\u0438\u043D\u0438 \u0441\u0435 \u043E\u043F\u0438\u0442\u0432\u0430\u0442
      \u0434\u0430 \u043D\u0438 \u044F\u0434\u043E\u0441\u0430\u0442?"
    m_Metadata:
