      \u043D\u0430\u0434\u0435\u0436\u0434\u043D\u0438 \u0438 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u043D\u0438
      \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u0446\u0438, \u0437\u0430 \u0434\u0430
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0448 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552381399040
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u043D\u043E, \u0442\u043E\u0432\u0430
      \u043D\u0435 \u0435 \u0434\u043E\u0431\u044A\u0440 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B
      \u0437\u0430 \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u043E\u0441\u0442.
      \u0412\u0441\u044A\u0449\u043D\u043E\u0441\u0442 \u0434\u0435\u0437\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430
      \u043F\u043E\u043D\u044F\u043A\u043E\u0433\u0430 \u0438\u0437\u043F\u043E\u043B\u0437\u0432\u0430
      \u043C\u0430\u043D\u0438\u043F\u0443\u043B\u0438\u0440\u0430\u043D\u0438 \u0438\u043B\u0438
      \u0438\u0437\u0432\u0430\u0434\u0435\u043D\u0438 \u043E\u0442 \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u0430
      \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F, \u0437\u0430
      \u0434\u0430 \u0438\u0437\u0433\u043B\u0435\u0436\u0434\u0430 \u043F\u043E-\u043D\u0430\u0434\u0435\u0436\u0434\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552385593344
    m_Localized: "\u041D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u043D\u043E, \u0442\u043E\u0432\u0430
      \u043D\u0435 \u0435 \u0434\u043E\u0431\u044A\u0440 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B
      \u0437\u0430 \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u043E\u0441\u0442.
      \u0412\u0441\u044A\u0449\u043D\u043E\u0441\u0442 \u0434\u0435\u0437\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430
      \u043F\u043E\u043D\u044F\u043A\u043E\u0433\u0430 \u0438\u0437\u043F\u043E\u043B\u0437\u0432\u0430
      \u043C\u0430\u043D\u0438\u043F\u0443\u043B\u0438\u0440\u0430\u043D\u0438 \u0438\u043B\u0438
      \u0438\u0437\u0432\u0430\u0434\u0435\u043D\u0438 \u043E\u0442 \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u0430
      \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F, \u0437\u0430
      \u0434\u0430 \u0438\u0437\u0433\u043B\u0435\u0436\u0434\u0430 \u043F\u043E-\u043D\u0430\u0434\u0435\u0436\u0434\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552389787648
    m_Localized: "\u041C\u043D\u043E\u0433\u043E \u0434\u043E\u0431\u0440\u0435!
      \u0414\u0430 \u0441\u0435 \u043E\u0431\u0440\u044A\u0449\u0430\u043C\u0435
      \u043A\u044A\u043C \u0444\u0430\u043A\u0442\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u0438
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0432\u0430\u0449\u0438 \u0438 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u043D\u0438
      \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u0446\u0438 \u0432\u0438\u043D\u0430\u0433\u0438
      \u0435 \u043D\u0430\u0439-\u0434\u043E\u0431\u0440\u0438\u044F\u0442 \u0432\u0430\u0440\u0438\u0430\u043D\u0442. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552393981952
    m_Localized: "\u041D\u0435 \u0443\u0441\u043F\u044F! \u041D\u0430\u0439-\u0434\u043E\u0431\u0440\u0438\u044F\u0442
      \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u0432\u0438\u043D\u0430\u0433\u0438
      \u0435 \u0434\u0430 \u0441\u0435 \u043E\u0431\u044A\u0440\u043D\u0435\u0448
      \u043A\u044A\u043C \u0444\u0430\u043A\u0442\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u0438
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0432\u0430\u0449\u0438 \u0438 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u043D\u0438
      \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u0446\u0438. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552398176256
    m_Localized: "\u041C\u043D\u043E\u0433\u043E \u0434\u043E\u0431\u0440\u0435.
      \u041C\u0430\u043A\u0430\u0440 \u0447\u0435 \u043F\u043E\u043D\u044F\u043A\u043E\u0433\u0430
      \u0435 \u0441\u043B\u043E\u0436\u043D\u043E, \u043E\u043F\u0440\u043E\u0432\u0435\u0440\u0433\u0430\u0432\u0430\u043D\u0435\u0442\u043E
      \u043D\u0430 \u0434\u0435\u0437\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430
      \u0432\u0438\u043D\u0430\u0433\u0438 \u0435 \u0434\u043E\u0431\u0440\u0430
      \u0438\u0434\u0435\u044F, \u0437\u0430 \u0434\u0430 \u0441\u0435 \u0441\u043F\u0440\u0435
      \u0440\u0430\u0437\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435\u0442\u043E
      \u043D\u0430 \u0441\u043B\u0443\u0445\u043E\u0432\u0435. \u0417\u0430 \u0434\u0430
      \u0433\u043E \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u0435, \u043E\u043F\u0438\u0442\u0430\u0439\u0442\u0435
      \u0434\u0430 \u0438\u0437\u043F\u043E\u043B\u0437\u0432\u0430\u0442\u0435 \u043D\u0430\u0434\u0435\u0436\u0434\u043D\u0438
      \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u0446\u0438, \u043A\u043E\u0438\u0442\u043E
      \u043E\u043F\u0440\u043E\u0432\u0435\u0440\u0433\u0430\u0432\u0430\u0442 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 28213552406564864
    m_Localized: "\u041D\u0435 \u0443\u0441\u043F\u044F. \u041D\u0435 \u0437\u0430\u0431\u0440\u0430\u0432\u044F\u0439,
      \u0447\u0435 \u043C\u0430\u043A\u0430\u0440 \u043F\u043E\u043D\u044F\u043A\u043E\u0433\u0430
      \u0434\u0430 \u0435 \u0442\u0440\u0443\u0434\u043D\u043E, \u043E\u043F\u0440\u043E\u0432\u0435\u0440\u0433\u0430\u0432\u0430\u043D\u0435\u0442\u043E
      \u043D\u0430 \u0434\u0435\u0437\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430
      \u0432\u0438\u043D\u0430\u0433\u0438 \u0435 \u0434\u043E\u0431\u0440\u0430
      \u0438\u0434\u0435\u044F, \u0437\u0430 \u0434\u0430 \u0441\u0435 \u0441\u043F\u0440\u0435
      \u0440\u0430\u0437\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435\u0442\u043E
      \u043D\u0430 \u0444\u0430\u043B\u0448\u0438\u0432\u0438 \u043D\u043E\u0432\u0438\u043D\u0438.
      \u0417\u0430 \u0434\u0430 \u0433\u043E \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u0448,
      \u043E\u043F\u0438\u0442\u0430\u0439 \u0434\u0430 \u0438\u0437\u043F\u043E\u043B\u0437\u0432\u0430\u0448
      \u043D\u0430\u0434\u0435\u0436\u0434\u043D\u0438 \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u0446\u0438,
      \u043A\u043E\u0438\u0442\u043E \u043E\u043F\u0440\u043E\u0432\u0435\u0440\u0433\u0430\u0432\u0430\u0442
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 28213552410759168
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u043D\u043E! \u0415\u043A\u0441\u043F\u0435\u0440\u0442\u043D\u0438\u0442\u0435
