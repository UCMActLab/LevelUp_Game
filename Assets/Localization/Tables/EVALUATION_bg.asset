      \u0435 \u0432\u0438\u043D\u0430\u0433\u0438 \u0434\u0430 \u0441\u0435 \u043E\u0431\u0440\u044A\u0449\u0430\u043C\u0435
      \u043A\u044A\u043C \u043D\u0430\u0439-\u043E\u0444\u0438\u0446\u0438\u0430\u043B\u043D\u0438\u044F
      \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u043A \u2013 \u0431\u0430\u043D\u043A\u0430\u0442\u0430. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552171683840
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u043D\u043E! \u0412\u0438\u043D\u0430\u0433\u0438
