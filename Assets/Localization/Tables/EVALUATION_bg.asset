      \u043D\u0430\u0439-\u043B\u0435\u0441\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334349
    m_Localized: "\u041A\u043E\u043C\u0438\u0447\u043D\u0438 \u0438\u043B\u0438 \u043F\u043E\u0434\u0438\u0433\u0440\u0430\u0432\u0430\u0442\u0435\u043B\u043D\u0438
      \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334350
    m_Localized: "\u041F\u043E\u0440\u0430\u0434\u0438 \u0438\u0437\u043A\u0440\u0438\u0432\u0435\u043D\u043E
      \u0432\u044A\u0437\u043F\u0440\u0438\u044F\u0442\u0438\u0435 \u043D\u0430 \u0440\u0435\u0430\u043B\u043D\u043E\u0441\u0442\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 28213551790002176
    m_Localized: "\u041C\u043D\u043E\u0433\u043E \u0434\u043E\u0431\u0440\u0435!
      \u041F\u043E\u043D\u044F\u043A\u043E\u0433\u0430 \u0437\u0430\u0433\u043B\u0430\u0432\u0438\u044F\u0442\u0430
      \u043C\u043E\u0433\u0430\u0442 \u0434\u0430 \u0431\u044A\u0434\u0430\u0442
      \u043F\u043E\u0434\u0432\u0435\u0436\u0434\u0430\u0449\u0438 \u0438\u043B\u0438
      \u0441\u0435\u043D\u0437\u0430\u0446\u0438\u043E\u043D\u043D\u0438, \u0437\u0430
      \u0434\u0430 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435\u0442\u043E
      \u043D\u0438, \u0438 \u0434\u0430 \u043D\u0435 \u043E\u0442\u0440\u0430\u0437\u044F\u0432\u0430\u0442
      \u0434\u043E\u0431\u0440\u0435 \u0441\u044A\u0434\u044A\u0440\u0436\u0430\u043D\u0438\u0435\u0442\u043E
      \u043D\u0430 \u043D\u043E\u0432\u0438\u043D\u0430\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28213551991328768
    m_Localized: "\u0412\u043D\u0438\u043C\u0430\u043D\u0438\u0435! \u0422\u043E\u0432\u0430
      \u0435 \u0444\u0430\u043B\u0448\u0438\u0432\u0430 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F.
      \u041F\u043E\u043D\u044F\u043A\u043E\u0433\u0430 \u0437\u0430\u0433\u043B\u0430\u0432\u0438\u044F\u0442\u0430
      \u043C\u043E\u0433\u0430\u0442 \u0434\u0430 \u0431\u044A\u0434\u0430\u0442
      \u043F\u043E\u0434\u0432\u0435\u0436\u0434\u0430\u0449\u0438 \u0438\u043B\u0438
      \u0441\u0435\u043D\u0437\u0430\u0446\u0438\u043E\u043D\u043D\u0438, \u0437\u0430
      \u0434\u0430 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435\u0442\u043E
      \u043D\u0438, \u0438 \u0434\u0430 \u043D\u0435 \u043E\u0442\u0440\u0430\u0437\u044F\u0432\u0430\u0442
      \u0434\u043E\u0431\u0440\u0435 \u0441\u044A\u0434\u044A\u0440\u0436\u0430\u043D\u0438\u0435\u0442\u043E
      \u043D\u0430 \u043D\u043E\u0432\u0438\u043D\u0430\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552003911680
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u043D\u043E! \u0417\u0430
      \u0434\u0430 \u0441\u043C\u0435 \u0441\u0438\u0433\u0443\u0440\u043D\u0438
      \u0432 \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u043E\u0441\u0442\u0442\u0430
      \u043D\u0430 \u0435\u0434\u043D\u0430 \u043D\u043E\u0432\u0438\u043D\u0430,
      \u0435 \u0432\u0430\u0436\u043D\u043E \u0432\u0438\u043D\u0430\u0433\u0438
      \u0434\u0430 \u044F \u0447\u0435\u0442\u0435\u043C \u0446\u044F\u043B\u0430\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552008105984
    m_Localized: "\u041E\u043F\u0430! \u0422\u043E\u0432\u0430 \u0435 \u0444\u0430\u043B\u0448\u0438\u0432\u0430
      \u043D\u043E\u0432\u0438\u043D\u0430. \u041D\u0435 \u0437\u0430\u0431\u0440\u0430\u0432\u044F\u0439\u0442\u0435,
      \u0447\u0435 \u0437\u0430 \u0434\u0430 \u0441\u0442\u0435 \u0441\u0438\u0433\u0443\u0440\u043D\u0438
      \u0432 \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u043E\u0441\u0442\u0442\u0430
      \u043D\u0430 \u0434\u0430\u0434\u0435\u043D\u0430 \u043D\u043E\u0432\u0438\u043D\u0430,
      \u0435 \u0432\u0430\u0436\u043D\u043E \u0432\u0438\u043D\u0430\u0433\u0438
      \u0434\u0430 \u044F \u043F\u0440\u043E\u0447\u0435\u0442\u0435\u0442\u0435
      \u0446\u044F\u043B\u0430\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552016494592
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u043D\u043E! \u0427\u0435\u0442\u0435\u043D\u0435\u0442\u043E
