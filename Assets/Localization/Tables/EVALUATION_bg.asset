  - m_Id: 7138285730893824
    m_Localized: "\u0412\u044F\u0440\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285827362816
    m_Localized: "\u0413\u0440\u0435\u0448\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285827362817
    m_Localized: "\u041D\u043E\u0432\u0438\u043D\u0430\u0440\u0441\u043A\u0438\u0442\u0435
      \u0437\u0430\u0433\u043B\u0430\u0432\u0438\u044F \u0432\u0438\u043D\u0430\u0433\u0438
      \u0442\u043E\u0447\u043D\u043E \u043E\u0442\u0440\u0430\u0437\u044F\u0432\u0430\u0442
      \u0441\u044A\u0434\u044A\u0440\u0436\u0430\u043D\u0438\u0435\u0442\u043E \u043D\u0430
      \u043D\u043E\u0432\u0438\u043D\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285827362818
    m_Localized: "\u0421\u0430\u043C\u043E \u043F\u043E \u0437\u0430\u0433\u043B\u0430\u0432\u0438\u0435\u0442\u043E
      \u043C\u043E\u0433\u0430 \u0434\u0430 \u0440\u0430\u0437\u0431\u0435\u0440\u0430
      \u0434\u0430\u043B\u0438 \u0435\u0434\u043D\u0430 \u043D\u043E\u0432\u0438\u043D\u0430
      \u0435 \u0444\u0430\u043B\u0448\u0438\u0432\u0430 \u0438\u043B\u0438 \u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285827362819
    m_Localized: "\u0417\u0430 \u0434\u0430 \u043E\u0446\u0435\u043D\u0438\u043C
      \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u043E\u0441\u0442\u0442\u0430,
      \u0442\u0440\u044F\u0431\u0432\u0430 \u0432\u0438\u043D\u0430\u0433\u0438 \u0434\u0430
      \u0447\u0435\u0442\u0435\u043C \u0446\u044F\u043B\u0430\u0442\u0430 \u043D\u043E\u0432\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285827362820
    m_Localized: "\u0410\u043A\u043E \u043D\u043E\u0432\u0438\u043D\u0430\u0442\u0430
      \u0438\u0434\u0432\u0430 \u043E\u0442 \u0431\u043B\u0438\u0437\u044A\u043A
      \u0447\u043E\u0432\u0435\u043A, \u043D\u044F\u043C\u0430 \u043D\u0443\u0436\u0434\u0430
      \u0434\u0430 \u044F \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0432\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285827362821
    m_Localized: "\u0421\u0438\u043B\u043D\u043E\u0442\u043E, \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0447\u043D\u043E
      \u0437\u0430\u0433\u043B\u0430\u0432\u0438\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0432\u0430,
      \u0447\u0435 \u043D\u043E\u0432\u0438\u043D\u0430\u0442\u0430 \u0435 \u0432\u044F\u0440\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557120
    m_Localized: "\u041A\u043E\u0433\u0430\u0442\u043E \u043F\u0440\u043E\u0447\u0435\u0442\u0430
      \u0446\u044F\u043B\u0430\u0442\u0430 \u043D\u043E\u0432\u0438\u043D\u0430,
      \u043C\u043E\u0433\u0430 \u0434\u0430 \u0438\u0437\u043F\u043E\u043B\u0437\u0432\u0430\u043C
      \u0435\u0437\u0438\u043A\u0430, \u0437\u0430 \u0434\u0430 \u043E\u0446\u0435\u043D\u044F
      \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u043E\u0441\u0442\u0442\u0430
      \u045D"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557121
    m_Localized: "\u0417\u0430\u0433\u043B\u0430\u0432\u0438\u044F\u0442\u0430 \u043D\u0435
      \u0441\u0430 \u0434\u0435\u0437\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F,
      \u0442\u044A\u0439 \u043A\u0430\u0442\u043E \u0446\u0435\u043B\u0442\u0430
      \u0438\u043C \u0435 \u0434\u0430 \u0438\u043D\u0444\u043E\u0440\u043C\u0438\u0440\u0430\u0442
      \u0447\u0438\u0442\u0430\u0442\u0435\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557122
    m_Localized: "\u0412\u0441\u0438\u0447\u043A\u0438 \u043D\u043E\u0432\u0438\u043D\u0438
      \u0432 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442 \u0441\u0430 \u0444\u0430\u043B\u0448\u0438\u0432\u0438
      \u0438 \u043C\u043E\u0436\u0435\u043C \u0434\u0430 \u0432\u044F\u0440\u0432\u0430\u043C\u0435
      \u0441\u0430\u043C\u043E \u043D\u0430 \u043F\u0435\u0447\u0430\u0442\u043D\u0438
      \u043C\u0435\u0434\u0438\u0438 \u0438\u043B\u0438 \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u0438\u044F\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557123
    m_Localized: "\u0417\u0430\u0433\u043B\u0430\u0432\u0438\u0435\u0442\u043E \u0435
      \u0434\u043E\u0431\u0440\u043E \u0440\u0435\u0437\u044E\u043C\u0435 \u043D\u0430
      \u043D\u043E\u0432\u0438\u043D\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557124
    m_Localized: "\u0414\u0430\u0442\u0430\u0442\u0430 \u0432 \u0435\u0434\u043D\u0430
      \u043D\u043E\u0432\u0438\u043D\u0430 \u0435 \u0432\u0430\u0436\u0435\u043D
      \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B \u0437\u0430 \u043E\u0446\u0435\u043D\u043A\u0430
      \u043D\u0430 \u043D\u0435\u0439\u043D\u0430\u0442\u0430 \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u043E\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557125
    m_Localized: "\u041D\u043E\u0432\u0438\u043D\u0430, \u043A\u043E\u044F\u0442\u043E
      \u0441\u044A\u0434\u044A\u0440\u0436\u0430 \u0441\u0443\u0431\u0435\u043A\u0442\u0438\u0432\u043D\u0438
      \u043E\u0446\u0435\u043D\u043A\u0438 \u043A\u0430\u0442\u043E \u043E\u0431\u0438\u0434\u0438
      \u0438\u043B\u0438 \u0441\u0438\u043B\u043D\u043E \u043E\u0442\u0440\u0430\u0437\u044F\u0432\u0430
      \u043B\u0438\u0447\u043D\u043E\u0442\u043E \u043C\u043D\u0435\u043D\u0438\u0435
      \u043D\u0430 \u0430\u0432\u0442\u043E\u0440\u0430, \u043C\u043E\u0436\u0435
      \u0434\u0430 \u0435 \u043F\u043E-\u043C\u0430\u043B\u043A\u043E \u043D\u0430\u0434\u0435\u0436\u0434\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557126
    m_Localized: "\u0412\u0441\u0438\u0447\u043A\u0438 \u043D\u043E\u0432\u0438\u043D\u0438,
      \u043F\u0443\u0431\u043B\u0438\u043A\u0443\u0432\u0430\u043D\u0438 \u0432 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442,
      \u0441\u0430 \u043D\u0430\u0434\u0435\u0436\u0434\u043D\u0438, \u0437\u0430\u0449\u043E\u0442\u043E
      \u0432\u0441\u0438\u0447\u043A\u043E \u0441\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0432\u0430
      \u043F\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557127
    m_Localized: "\u0410\u043A\u043E \u043C\u043E\u0438 \u0440\u043E\u0434\u043D\u0438\u043D\u0438
      \u0438\u043B\u0438 \u043F\u0440\u0438\u044F\u0442\u0435\u043B\u0438 \u043C\u0438
      \u0438\u0437\u043F\u0440\u0430\u0442\u044F\u0442 \u043D\u043E\u0432\u0438\u043D\u0430,
      \u043D\u044F\u043C\u0430 \u043D\u0443\u0436\u0434\u0430 \u0434\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0432\u0430\u043C
      \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557128
    m_Localized: "\u0410\u043A\u043E \u043F\u0440\u0438\u044F\u0442\u0435\u043B \u0438\u043B\u0438
      \u0440\u043E\u0434\u043D\u0438\u043D\u0430 \u043C\u0438 \u0438\u0437\u043F\u0440\u0430\u0442\u0438
      \u043D\u043E\u0432\u0438\u043D\u0430 \u0431\u0435\u0437 \u043D\u0430\u0434\u0435\u0436\u0434\u0435\u043D
      \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u043A, \u0442\u0440\u044F\u0431\u0432\u0430
      \u0434\u0430 \u0441\u0435 \u0443\u0441\u044A\u043C\u043D\u044F \u0438 \u0434\u0430
      \u044F \u043F\u0440\u043E\u0432\u0435\u0440\u044F \u0432 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u043D\u0438
      \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u0446\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751424
    m_Localized: "\u041D\u0435 \u0435 \u043D\u0443\u0436\u043D\u043E \u0434\u0430
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0432\u0430\u043C \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u043A\u0430
      \u043D\u0430 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F,
      \u043A\u043E\u044F\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0430\u0432\u0430\u043C
      \u043F\u043E WhatsApp \u0438\u043B\u0438 \u0441\u044A\u043E\u0431\u0449\u0435\u043D\u0438\u0435
      \u2013 \u0442\u0435\u0437\u0438 \u043A\u0430\u043D\u0430\u043B\u0438 \u0432\u0438\u043D\u0430\u0433\u0438
      \u0441\u0430 \u043D\u0430\u0434\u0435\u0436\u0434\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751425
    m_Localized: "\u041A\u043E\u0439 \u043E\u0442 \u0441\u043B\u0435\u0434\u043D\u0438\u0442\u0435
      \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u0446\u0438 \u0435 \u043D\u0430\u0434\u0435\u0436\u0434\u0435\u043D,
      \u043A\u043E\u0433\u0430\u0442\u043E \u0441\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0438\u0440\u0430\u043C
      \u0437\u0430 \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u0438 \u0442\u0435\u043C\u0438?
      \u041E\u0442\u0431\u0435\u043B\u0435\u0436\u0438 \u0432\u0441\u0438\u0447\u043A\u0438,
      \u043A\u043E\u0438\u0442\u043E \u0441\u043C\u044F\u0442\u0430\u0448 \u0437\u0430
      \u043F\u0440\u0430\u0432\u0438\u043B\u043D\u0438:"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751426
    m_Localized: "\u041C\u043E\u044F\u0442\u0430 \u0431\u0430\u043D\u043A\u0430 "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751427
    m_Localized: "\u0418\u043D\u0442\u0435\u0440\u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751428
    m_Localized: "\u0420\u043E\u0434\u043D\u0438\u043D\u0438 \u0438/\u0438\u043B\u0438
      \u043F\u0440\u0438\u044F\u0442\u0435\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751429
    m_Localized: "\u041A\u0430\u043A\u0432\u043E \u0442\u0440\u044F\u0431\u0432\u0430
      \u0434\u0430 \u043D\u0430\u043F\u0440\u0430\u0432\u044F, \u043F\u0440\u0435\u0434\u0438
      \u0434\u0430 \u0441\u043F\u043E\u0434\u0435\u043B\u044F \u0435\u0434\u043D\u0430
      \u043D\u043E\u0432\u0438\u043D\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751430
    m_Localized: "\u0414\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u044F \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751431
    m_Localized: "\u0414\u0430 \u0432\u0438\u0434\u044F \u043A\u043E\u043B\u043A\u043E
      \u043F\u044A\u0442\u0438 \u0435 \u0431\u0438\u043B\u0430 \u0441\u043F\u043E\u0434\u0435\u043B\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751432
    m_Localized: "\u0414\u0430 \u0441\u0435 \u0443\u0432\u0435\u0440\u044F, \u0447\u0435
      \u0441\u044A\u0434\u044A\u0440\u0436\u0430 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751433
    m_Localized: "\u0412\u0441\u0438\u0447\u043A\u0438 \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u0446\u0438
      \u043D\u0430 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u0441\u0430
      \u0435\u0434\u043D\u0430\u043A\u0432\u043E \u043D\u0435\u043B\u043E\u044F\u043B\u043D\u0438,
      \u043D\u0435 \u043C\u043E\u0436\u0435 \u0434\u0430 \u0441\u0435 \u0432\u044F\u0440\u0432\u0430
      \u043D\u0430 \u043D\u0438\u0442\u043E \u0435\u0434\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751434
    m_Localized: "\u0412\u044A\u0437\u0440\u0430\u0441\u0442\u0442\u0430 \u043D\u0430
      \u0436\u0443\u0440\u043D\u0430\u043B\u0438\u0441\u0442\u0430 \u0435 \u0432\u0430\u0436\u0435\u043D
      \u0444\u0430\u043A\u0442\u043E\u0440 \u043F\u0440\u0438 \u043E\u0446\u0435\u043D\u043A\u0430
      \u043D\u0430 \u043D\u043E\u0432\u0438\u043D\u0430\u0442\u0430. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751435
    m_Localized: "\u041F\u043E\u043B\u044A\u0442 \u043D\u0430 \u0436\u0443\u0440\u043D\u0430\u043B\u0438\u0441\u0442\u0430
      \u0435 \u0432\u0430\u0436\u0435\u043D \u0444\u0430\u043A\u0442\u043E\u0440
      \u043F\u0440\u0438 \u043E\u0446\u0435\u043D\u043A\u0430 \u043D\u0430 \u043D\u043E\u0432\u0438\u043D\u0430\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751436
    m_Localized: "\u0410\u043A\u043E \u0431\u043B\u0438\u0437\u044A\u043A \u0447\u043E\u0432\u0435\u043A
      \u043C\u0438 \u0438\u0437\u043F\u0440\u0430\u0442\u0438 \u043D\u043E\u0432\u0438\u043D\u0430,
      \u043C\u043E\u0433\u0430 \u0434\u0430 \u0432\u044F\u0440\u0432\u0430\u043C,
      \u0447\u0435 \u0442\u044F \u0435 \u0432\u044F\u0440\u043D\u0430. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751437
    m_Localized: "\u041A\u043E\u0438 \u043E\u0442 \u0441\u043B\u0435\u0434\u043D\u0438\u0442\u0435
      \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u0446\u0438 \u0441\u0430 \u043F\u043E-\u043D\u0430\u0434\u0435\u0436\u0434\u043D\u0438:"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751438
