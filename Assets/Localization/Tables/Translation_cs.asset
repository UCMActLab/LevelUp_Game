%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Translation_cs
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: cs
  m_SharedData: {fileID: 11400000, guid: 30d8a1d14b5d94a45aae97ab03a40993, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 17797189632
    m_Localized: "PERFEKTN\xCD"
    m_Metadata:
      m_Items: []
  - m_Id: 17847521280
    m_Localized: "VYSOK\xDD"
    m_Metadata:
      m_Items: []
  - m_Id: 17847521281
    m_Localized: "ST\u0158EDN\xCD"
    m_Metadata:
      m_Items: []
  - m_Id: 17847521282
    m_Localized: "N\xCDZK\xDD"
    m_Metadata:
      m_Items: []
  - m_Id: 17847521283
    m_Localized: NULA
    m_Metadata:
      m_Items: []
  - m_Id: 9763233173504
    m_Localized: "P\u0159e\u010D\xEDst"
    m_Metadata:
      m_Items: []
  - m_Id: 9763237367808
    m_Localized: "Doporu\u010Dit"
    m_Metadata:
      m_Items: []
  - m_Id: 9763237367809
    m_Localized: Zahodit
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721479
    m_Localized: "Dobr\xFD den! Tato zpr\xE1va by byla reakc\xED na obsah, kter\xFD
      jste doporu\u010Dili."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721480
    m_Localized: "Jsem v\xE1\u0161 zn\xE1m\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721481
    m_Localized: "Ve skute\u010Dnosti neexistuji a nem\xE1m nic spole\u010Dn\xE9ho
      s \u017E\xE1dnou osobou se stejn\xFDm jm\xE9nem, kterou zn\xE1te mimo tuto
      hru."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721482
    m_Localized: "Dobr\xE9 r\xE1no! Jsem dal\u0161\xED z va\u0161ich zn\xE1m\xFDch."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721483
    m_Localized: "Tady v\xE1m budeme \u0159\xEDkat, co si mysl\xEDme o obsahu, kter\xFD
      n\xE1m doporu\u010D\xEDte."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721484
    m_Localized: "Zat\xEDm se vr\xE1t\xEDme na hlavn\xED str\xE1nku, kde jste byli
      p\u0159edt\xEDm."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721485
    m_Localized: "K tomu pot\u0159ebuji, abyste stiskli tla\u010D\xEDtko \u201EOK\"
      v doln\xED \u010D\xE1sti obrazovky."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721486
    m_Localized: "Vyzkou\u0161ejte to!"
    m_Metadata:
      m_Items: []
  - m_Id: 414618628841472
    m_Localized: ZDROJ
    m_Metadata:
      m_Items: []
  - m_Id: 414618674978816
    m_Localized: "DAL\u0160\xCD"
    m_Metadata:
      m_Items: []
  - m_Id: 414618674978817
    m_Localized: "Zaregistrujte se na webu profit365.cz, vlo\u017Ete po\u010D\xE1te\u010Dn\xED
      \u010D\xE1stku a sledujte, jak va\u0161e pen\xEDze rostou. Ka\u017Ed\xFD nov\xFD
      u\u017Eivatel z\xEDsk\xE1 bonus 250 K\u010D."
    m_Metadata:
      m_Items: []
  - m_Id: 414618674978818
    m_Localized: "Investujte bez rizika a z\xEDskejte jist\xFD v\xFDnos"
    m_Metadata:
      m_Items: []
  - m_Id: 426683309416448
    m_Localized: RODINA
    m_Metadata:
      m_Items: []
  - m_Id: 426683309416449
    m_Localized: "P\u0158\xC1TEL\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 426683309416450
    m_Localized: "SOUSED\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 427584111697920
    m_Localized: "Pod\xEDvejte se na toto:"
    m_Metadata:
      m_Items: []
  - m_Id: 1427335212883968
    m_Localized: "U\u017E jsem to vid\u011Bl, ale stejn\u011B d\u011Bkuji."
    m_Metadata:
      m_Items: []
  - m_Id: 1427335279992832
    m_Localized: "Josef mi to u\u017E poslal. Mysl\xEDm, \u017Ee m\xE1m p\xE1r dotaz\u016F,
      uvid\xEDme, jestli to funguje."
    m_Metadata:
      m_Items: []
  - m_Id: 1427335279992833
    m_Localized: "Ne, ne, pros\xEDm, nesd\xEDlejte to."
    m_Metadata:
      m_Items: []
  - m_Id: 1427335279992834
    m_Localized: "Toto je podvod! Pros\xEDm, m\u011Bjte se u takov\xFDchto zpr\xE1v
      na pozoru. Cht\u011Bj\xED jen va\u0161e \xFAdaje."
    m_Metadata:
      m_Items: []
  - m_Id: 1427335279992835
    m_Localized: "D\u011Bkujeme za sd\xEDlen\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 1427335279992836
    m_Localized: "D\xEDky! Zkazilo se n\xE1m j\xEDdlo v mraz\xE1ku, ty pen\xEDze
      se n\xE1m budou hodit."
    m_Metadata:
      m_Items: []
  - m_Id: 1449960068800512
    m_Localized: "Doporu\u010Dili jste ned\u016Fv\u011Bryhodn\xFD \u010Dl\xE1nek."
    m_Metadata:
      m_Items: []
  - m_Id: 1449960140103680
    m_Localized: "Zkuste si p\u0159\xED\u0161t\u011B polo\u017Eit ot\xE1zku: kdo
      to napsal a pro\u010D?"
    m_Metadata:
      m_Items: []
  - m_Id: 1449960140103681
    m_Localized: "\u010Cl\xE1nek jste ne\u010Detli, a p\u0159esto jste ho doporu\u010Dili
      d\xE1l. Zkuste si p\u0159\xED\u0161t\u011B obsah nejprve p\u0159e\u010D\xEDst."
    m_Metadata:
      m_Items: []
  - m_Id: 1449960140103682
    m_Localized: "Doporu\u010Dili jste d\u016Fv\u011Bryhodn\xFD \u010Dl\xE1nek."
    m_Metadata:
      m_Items: []
  - m_Id: 1449960140103683
    m_Localized: "Tentokr\xE1t to vy\u0161lo. Ale bez p\u0159e\u010Dten\xED je to
      v\u017Edy risk."
    m_Metadata:
      m_Items: []
  - m_Id: 1470815863758848
    m_Localized: "V\xEDtejte ve h\u0159e!"
    m_Metadata:
      m_Items: []
  - m_Id: 1470815909896192
    m_Localized: Vyberte si jazyk
    m_Metadata:
      m_Items: []
  - m_Id: 1470815909896193
    m_Localized: "V\xEDtejte ve h\u0159e!"
    m_Metadata:
      m_Items: []
  - m_Id: 1470815914090496
    m_Localized: "Ve h\u0159e se setk\xE1te s r\u016Fzn\xFDmi zpr\xE1vami a p\u0159\xEDsp\u011Bvky.
      M\u016F\u017Eete je doporu\u010Dit sv\xFDm bl\xEDzk\xFDm, nebo je zahodit.
      Uvid\xEDte, jak na va\u0161e rozhodnut\xED zareaguj\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 1470815914090497
    m_Localized: "Poj\u010Fme na to!"
    m_Metadata:
      m_Items: []
  - m_Id: 1470815914090498
    m_Localized: "Ovlivnil v\xE1s v\xFDpadek proudu? Zde v\xE1m vysv\u011Btl\xEDme,
      jak m\u016F\u017Eete z\xEDskat kompenzaci."
    m_Metadata:
      m_Items: []
  - m_Id: 1470815914090499
    m_Localized: "Pr\xE1v\u011B jste obdr\u017Eeli ozn\xE1men\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 1470815914090500
    m_Localized: "Otev\u0159i"
    m_Metadata:
      m_Items: []
  - m_Id: 1805145240690688
    m_Localized: "Va\u0161e sk\xF3re"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438567223296
    m_Localized: "Gratulujeme, pro\u0161li jste celou hrou!"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438634332160
    m_Localized: "Poj\u010Fme si shrnout, co jsme se nau\u010Dili."
    m_Metadata:
      m_Items: []
  - m_Id: 2909438634332161
    m_Localized: "Ov\u011B\u0159ujte zdroj"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438634332162
    m_Localized: "D\u016Fv\u011Bryhodn\xFD zdroj se za sv\xFDm obsahem podep\xED\u0161e.
      Uveden\xFD autor a redakce znamen\xE1, \u017Ee za informac\xED stoj\xED n\u011Bkdo,
      kdo za ni nese odpov\u011Bdnost."
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526464
    m_Localized: "V\u0161\xEDmejte si obsahu"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526465
    m_Localized: "D\u016Fv\u011Bryhodn\xFD obsah cituje konkr\xE9tn\xED zdroje a
      data, kter\xE9 si m\u016F\u017Eete sami ov\u011B\u0159it."
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526466
    m_Localized: "\u010Ct\u011Bte pozorn\u011B"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526467
    m_Localized: "V\u0161\xEDmejte si, zda text cituje zdroje, uv\xE1d\xED data a
      zda je naps\xE1n profesion\xE1ln\u011B. Pokud ne, bu\u010Fte obez\u0159etn\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526468
    m_Localized: Pozor na emoce
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526469
    m_Localized: "Pokud ve v\xE1s obsah vyvol\xE1v\xE1 siln\xE9 emoce, vztek nebo
      strach, m\u016F\u017Ee to b\xFDt z\xE1m\u011Br. D\xE1t si odstup je naprosto
      v po\u0159\xE1dku."
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526470
    m_Localized: Pozor na AI
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526471
    m_Localized: "Obr\xE1zky a videa mohou b\xFDt vytvo\u0159eny um\u011Blou inteligenc\xED.
      Hledejte chyby v obli\u010Dej\xEDch, rukou a pozad\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 2919120602107904
    m_Localized: "D\u011Bkujeme za v\xE1\u0161 \u010Das!"
    m_Metadata:
      m_Items: []
  - m_Id: 2919120602107905
    m_Localized: "Stiskn\u011Bte tla\u010D\xEDtko pro n\xE1vrat do hlavn\xEDho menu."
    m_Metadata:
      m_Items: []
  - m_Id: 8072467420995584
    m_Localized: "Zp\u011Bt"
    m_Metadata:
      m_Items: []
  - m_Id: 9056519614861312
    m_Localized: "Rozum\xEDm"
    m_Metadata:
      m_Items: []
  - m_Id: 9056519644221440
    m_Localized: "Ov\u011B\u0159it"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758147280896
    m_Localized: "V\xEDtejte!"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778368
    m_Localized: "Ka\u017Ed\xFD den n\xE1s obklopuj\xED zpr\xE1vy, p\u0159\xEDsp\u011Bvky
      a sd\xEDlen\xE9 informace. Nen\xED snadn\xE9 se v nich vyznat. A nen\xED to
      jen v\xE1\u0161 probl\xE9m, s t\xEDm se pot\xFDk\xE1 v\u011Bt\u0161ina z n\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778369
    m_Localized: "Pomozte bl\xEDzk\xFDm"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778370
    m_Localized: "Va\u0161i bl\xEDzc\xED se na v\xE1s obracej\xED, kdy\u017E si nejsou
      jist\xED, \u010Demu v\u011B\u0159it. V t\xE9to h\u0159e si vyzkou\u0161\xEDte,
      jak jim pomoct se v informac\xEDch zorientovat."
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778371
    m_Localized: "Pro\u010D na tom z\xE1le\u017E\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778372
    m_Localized: "Kvalitn\xED informace z ov\u011B\u0159en\xFDch zdroj\u016F pot\u0159ebujeme
      v\u0161ichni, abychom mohli dob\u0159e rozhodovat o sv\xFDch \u017Eivotech
      i o \u017Eivotech sv\xFDch bl\xEDzk\xFDch."
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778373
    m_Localized: Jak to bude fungovat?
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778374
    m_Localized: "Budete dost\xE1vat r\u016Fzn\xE9 zpr\xE1vy a p\u0159\xEDsp\u011Bvky.
      U ka\u017Ed\xE9ho se rozhodn\u011Bte: doporu\u010Dili byste ho sv\xFDm bl\xEDzk\xFDm?
      Nebo ho rad\u011Bji zahod\xEDte?"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778376
    m_Localized: "D\u016Fv\u011Bryhodn\xFD zdroj v\xE1m nab\xEDz\xED dost informac\xED,
      abyste si je mohli ov\u011B\u0159it: autora, redakci, konkr\xE9tn\xED data.
      Ned\u016Fv\u011Bryhodn\xFD zdroj naopak informace skr\xFDv\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 14472164729610240
    m_Localized: "P\u0159e\u010Dten\xE9 \u010Dl\xE1nky"
    m_Metadata:
      m_Items: []
  - m_Id: 14472164788330496
    m_Localized: "Doporu\u010Den\xE9 d\u016Fv\u011Bryhodn\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 14472164788330497
    m_Localized: "Doporu\u010Den\xE9 ned\u016Fv\u011Bryhodn\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 14487224642363392
    m_Localized: "Webov\xE1 str\xE1nka"
    m_Metadata:
      m_Items: []
  - m_Id: 14487224688500736
    m_Localized: "Soci\xE1ln\xED m\xE9dia"
    m_Metadata:
      m_Items: []
  - m_Id: 14487224688500737
    m_Localized: Noviny
    m_Metadata:
      m_Items: []
  - m_Id: 14487224688500738
    m_Localized: Blog
    m_Metadata:
      m_Items: []
  - m_Id: 14489832853528576
    m_Localized: "Nevad\xED! P\u0159\xED\u0161t\u011B to bude lep\u0161\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 14489832853528577
    m_Localized: "Dobr\xFD za\u010D\xE1tek! Jde v\xE1m to \u010D\xEDm d\xE1l l\xE9pe."
    m_Metadata:
      m_Items: []
  - m_Id: 14489832853528578
    m_Localized: "Um\xEDte rozli\u0161it d\u016Fv\u011Bryhodn\xE9 od pochybn\xE9ho."
    m_Metadata:
      m_Items: []
  - m_Id: 14489832857722880
    m_Localized: "V\xFDborn\u011B! D\u016Fv\u011B\u0159ujte sv\xE9mu \xFAsudku."
    m_Metadata:
      m_Items: []
  - m_Id: 14489832857722881
    m_Localized: "P\u0159e\u010Detli jste {0} z {1} \u010Dl\xE1nk\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 14489832857722882
    m_Localized: "Zahodili jste {0} ned\u016Fv\u011Bryhodn\xFDch \u010Dl\xE1nk\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 14489832857722883
    m_Localized: "Doporu\u010Dili jste {0} d\u016Fv\u011Bryhodn\xFDch \u010Dl\xE1nk\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 14494645209194496
    m_Localized: "Vypad\xE1 to manipulativn\u011B."
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137536
    m_Localized: "To je zaj\xEDmav\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137537
    m_Localized: "Nev\xEDm."
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137538
    m_Localized: "Ano, rozum\xEDm."
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137539
    m_Localized: Ne, zopakujte to.
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137540
    m_Localized: Je to pravda.
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137541
    m_Localized: "To nen\xED pravda."
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137542
    m_Localized: "Skupina p\u0159\xE1tel"
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137543
    m_Localized: "Rodinn\xE1 skupina"
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137544
    m_Localized: "Skupina soused\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137545
    m_Localized: "Dal\u0161\xED krok"
    m_Metadata:
      m_Items: []
  - m_Id: 14598736433614848
    m_Localized: "U d\u011Bt\xED, jejich\u017E matky se b\u011Bhem t\u011Bhotenstv\xED
      nakazily covidem, bylo zji\u0161t\u011Bno opo\u017Ed\u011Bn\xED v\xFDvoje mozku"
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140800
    m_Localized: "U p\u011Btilet\xFDch d\u011Bt\xED, kter\xE9 se nakazily virem COVID-19
      b\u011Bhem t\u011Bhotenstv\xED sv\xFDch matek (vrozen\u011B) a p\u0159ed zaveden\xEDm
      prvn\xEDch vakc\xEDn proti pandemii, byl zaznamen\xE1n o 10 procent vy\u0161\u0161\xED
      v\xFDskyt p\u0159\xEDpad\u016F opo\u017Ed\u011Bn\xE9ho kognitivn\xEDho v\xFDvoje,
      zejm\xE9na v oblastech u\u010Den\xED a pam\u011Bti. To je hlavn\xED z\xE1v\u011Br
      nov\xE9ho v\xFDzkumu o dopadech pandemie viru SARS-CoV-2 b\u011Bhem t\u011Bhotenstv\xED,
      kter\xFD vedl Institut neurov\u011Bd CSIC."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140801
    m_Localized: "Je\u0161t\u011B \u017Ee se tvoje sest\u0159enice nechala o\u010Dkovat."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140802
    m_Localized: "To rozhodn\u011B! S takov\xFDmi v\u011Bcmi je t\u0159eba b\xFDt
      opatrn\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140803
    m_Localized: "D\xEDky, \u017Ee jsi to sd\xEDlel."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140804
    m_Localized: "Jsem r\xE1da, \u017Ee o t\u011Bchto v\u011Bcech p\xED\u0161e\u0161."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140805
    m_Localized: "Hodn\u011B pro m\u011B znamen\xE1, \u017Ee v\xED\u0161, co se d\u011Bje."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140806
    m_Localized: Jo!
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140807
    m_Localized: "Nav\xEDc, kdy\u017E jsou t\xE9mata t\xFDkaj\xEDc\xED se o\u010Dkov\xE1n\xED
      tak d\u016Fle\u017Eit\xE1..."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140808
    m_Localized: "Je\u0161t\u011B jsme se z pandemie \xFApln\u011B nedostali..."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140809
    m_Localized: "Bylo to opravdu v\xE1\u017En\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140810
    m_Localized: "Mus\xEDme to v\u0161echno sledovat."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140811
    m_Localized: "D\xEDky za sd\xEDlen\xED t\xE9to zpr\xE1vy, je to velmi d\u016Fle\u017Eit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 15587561838448640
    m_Localized: Ano
    m_Metadata:
      m_Items: []
  - m_Id: 15587561892974592
    m_Localized: Ne
    m_Metadata:
      m_Items: []
  - m_Id: 15587561892974593
    m_Localized: Spustit hru?
    m_Metadata:
      m_Items: []
  - m_Id: 19989448721403904
    m_Localized: "Zahodili jste \u010Dl\xE1nek z d\u016Fv\u011Bryhodn\xE9ho zdroje.
      Uveden\xFD autor a zn\xE1m\xE1 redakce b\xFDvaj\xED dobr\xFDm znamen\xEDm."
    m_Metadata:
      m_Items: []
  - m_Id: 30210070742183936
    m_Localized: "Komu byste to cht\u011Bli doporu\u010Dit?"
    m_Metadata:
      m_Items: []
  - m_Id: 30210070788321281
    m_Localized: "Dobr\xE1 pr\xE1ce! Posuzujete informace pozorn\u011B."
    m_Metadata:
      m_Items: []
  - m_Id: 36341147694239744
    m_Localized: "Spr\xE1vn\xE9 odpov\u011Bdi"
    m_Metadata:
      m_Items: []
  - m_Id: 36341147752960000
    m_Localized: "Nesd\xEDlet"
    m_Metadata:
      m_Items: []
  - m_Id: 36644566015381504
    m_Localized: "Abychom mohli v budoucnu zlep\u0161it u\u017Eivatelsk\xFD z\xE1\u017Eitek,
      ukl\xE1d\xE1me \xFAdaje o pou\u017E\xEDv\xE1n\xED hry. Neukl\xE1d\xE1me \u017E\xE1dn\xE9
      osobn\xED \xFAdaje. Souhlas\xEDte s odesl\xE1n\xEDm t\u011Bchto \xFAdaj\u016F?"
    m_Metadata:
      m_Items: []
  - m_Id: 36647627920216064
    m_Localized: "Zv\u011Bt\u0161it velikost textu:"
    m_Metadata:
      m_Items: []
  - m_Id: 54790439025954816
    m_Localized: "PR\u016EB\u011AH HRY"
    m_Metadata:
      m_Items: []
  - m_Id: 55146829741477888
    m_Localized: "\xDArove\u0148 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 67369464486047744
    m_Localized: "Tentokr\xE1t to \xFApln\u011B nevy\u0161lo."
    m_Metadata:
      m_Items: []
  - m_Id: 67369464515407872
    m_Localized: "Abyste postoupili d\xE1l, zkuste spr\xE1vn\u011B vyhodnotit je\u0161t\u011B
      n\u011Bkolik \u010Dl\xE1nk\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 67787236466634752
    m_Localized: "Nezapome\u0148te si zkontrolovat c\xEDle \xFArovn\u011B."
    m_Metadata:
      m_Items: []
  - m_Id: 67787236470829056
    m_Localized: "Zkus\xEDme to znovu! To zvl\xE1dnete!"
    m_Metadata:
      m_Items: []
  - m_Id: 66697776865882112
    m_Localized: "Chcete si znovu poslechnout vysv\u011Btlen\xED \xFArovn\u011B?"
    m_Metadata:
      m_Items: []
  - m_Id: 67369464515407873
    m_Localized: "Spr\xE1vn\u011B rozpoznan\xE1 t\xE9mata"
    m_Metadata:
      m_Items: []
  - m_Id: 67405583462313984
    m_Localized: "Obecn\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 67405583491674112
    m_Localized: "Um\u011Bl\xE1 inteligence"
    m_Metadata:
      m_Items: []
  - m_Id: 67405583491674113
    m_Localized: "V\u011Bda"
    m_Metadata:
      m_Items: []
  - m_Id: 67405583491674114
    m_Localized: Podvody
    m_Metadata:
      m_Items: []
  - m_Id: 67405583491674115
    m_Localized: Konspirace
    m_Metadata:
      m_Items: []
  - m_Id: 67489570710278144
    m_Localized: "Dostali jste se na konec \xFArovn\u011B."
    m_Metadata:
      m_Items: []
  - m_Id: 67489570806747136
    m_Localized: "Pod\xEDv\xE1me se, jak jste si vedli."
    m_Metadata:
      m_Items: []
  - m_Id: 67495532485595136
    m_Localized: "Doporu\u010Deno skupin\u011B"
    m_Metadata:
      m_Items: []
  - m_Id: 67774421647372288
    m_Localized: "Zahozen\xE9 ned\u016Fv\u011Bryhodn\xE9 \u010Dl\xE1nky"
    m_Metadata:
      m_Items: []
  - m_Id: 67774421676732416
    m_Localized: "D\u016Fv\u011Bryhodn\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 67774421676732417
    m_Localized: "Ned\u016Fv\u011Bryhodn\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 67774421676732418
    m_Localized: "Spr\xE1vn\u011B vyhodno\u0165te alespo\u0148"
    m_Metadata:
      m_Items: []
  - m_Id: 67775455442644992
    m_Localized: Skupina
    m_Metadata:
      m_Items: []
  - m_Id: 67775455442644993
    m_Localized: "Po\u010Det \u010Dl\xE1nk\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 67775864878018560
    m_Localized: "T\xE9ma"
    m_Metadata:
      m_Items: []
  - m_Id: 67812858945482752
    m_Localized: "{0} \u010Dl\xE1nk\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 67955945450950656
    m_Localized: "Hra se spust\xED po na\u010Dten\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 76486106008662016
    m_Localized: "Ne ka\u017Ed\xFD \u010Dl\xE1nek si zaslou\u017E\xED va\u0161i pozornost.
      U t\u011Bch zaj\xEDmav\xFDch se vyplat\xED pod\xEDvat na zdroj."
    m_Metadata:
      m_Items: []
  - m_Id: 76486106121908226
    m_Localized: "Kdy\u017E v\xE1s \u010Dl\xE1nek roz\u010D\xEDl\xED nebo vystra\u0161\xED,
      d\xE1t si odstup je rozumn\xE9. Pocit nal\xE9havosti m\u016F\u017Ee b\xFDt
      z\xE1m\u011Brn\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 77953895227600896
    m_Localized: Obnovit
    m_Metadata:
      m_Items: []
  - m_Id: 77953895336652800
    m_Localized: "Zav\u0159\xEDt"
    m_Metadata:
      m_Items: []
  - m_Id: 82639330706378752
    m_Localized: "Zkuste si poka\u017Ed\xE9 polo\u017Eit ot\xE1zku: Kdo to napsal?
      Odkud to poch\xE1z\xED? Sna\u017E\xED se to vzbudit siln\xE9 emoce?"
    m_Metadata:
      m_Items: []
  - m_Id: 83333316941107200
    m_Localized: "St\xE1hnout certifik\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 82697429085507584
    m_Localized: "Gratulujeme! Pro\u0161li jste celou hrou."
    m_Metadata:
      m_Items: []
  - m_Id: 82697429261668352
    m_Localized: "Rozli\u0161it d\u016Fv\u011Bryhodn\xE9 od ned\u016Fv\u011Bryhodn\xE9ho
      nen\xED snadn\xE9. Ale zvl\xE1dli jste to."
    m_Metadata:
      m_Items: []
  - m_Id: 82697429261668353
    m_Localized: "Poj\u010Fme si shrnout, co jsme se nau\u010Dili..."
    m_Metadata:
      m_Items: []
  - m_Id: 82697429265862656
    m_Localized: "A p\u0159ed\xE1me v\xE1m v\xE1\u0161 odznak!"
    m_Metadata:
      m_Items: []
  - m_Id: 82697429265862657
    m_Localized: "A te\u010F si poj\u010Fme pro v\xE1\u0161 odznak!"
    m_Metadata:
      m_Items: []
  - m_Id: 76548751877353472
    m_Localized: "V t\xE9to \xFArovni..."
    m_Metadata:
      m_Items: []
  - m_Id: 90567018012135424
    m_Localized: EXTRA
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
