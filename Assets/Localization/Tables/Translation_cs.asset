  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Translation_cs
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: cs
  m_SharedData: {fileID: 11400000, guid: 30d8a1d14b5d94a45aae97ab03a40993, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 17797189632
    m_Localized: "PERFEKTN\xCD"
    m_Metadata:
      m_Items: []
  - m_Id: 17847521280
    m_Localized: "VYSOK\xDD"
    m_Metadata:
      m_Items: []
  - m_Id: 17847521281
    m_Localized: "ST\u0158EDN\xCD"
    m_Metadata:
      m_Items: []
  - m_Id: 17847521282
    m_Localized: "N\xCDZK\xDD"
    m_Metadata:
      m_Items: []
  - m_Id: 17847521283
    m_Localized: NULA
    m_Metadata:
      m_Items: []
  - m_Id: 9763233173504
    m_Localized: "\u010C\xCDST"
    m_Metadata:
      m_Items: []
  - m_Id: 9763237367808
    m_Localized: "SD\xCDLET"
    m_Metadata:
      m_Items: []
  - m_Id: 9763237367809
    m_Localized: "P\u0158ESKO\u010CIT"
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721479
    m_Localized: "Ahoj! Tato zpr\xE1va by byla reakc\xED na \u010Dl\xE1nek, kter\xFD
      jsi poslal(a)."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721480
    m_Localized: "Jsem tv\u016Fj zn\xE1m\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721481
    m_Localized: "Ve skute\u010Dnosti neexistuji a nem\xE1m nic spole\u010Dn\xE9ho
      s \u017E\xE1dnou osobou se stejn\xFDm jm\xE9nem, kterou zn\xE1\u0161 mimo tuto
      aplikaci."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721482
    m_Localized: "Dobr\xE9 r\xE1no! Jsem dal\u0161\xED z tv\xFDch zn\xE1m\xFDch."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721483
    m_Localized: "Tady ti budeme \u0159\xEDkat, co si mysl\xEDme o \u010Dl\xE1nc\xEDch,
      kter\xE9 n\xE1m pos\xEDl\xE1\u0161."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721484
    m_Localized: "Zat\xEDm se vr\xE1t\xEDme na hlavn\xED str\xE1nku, kde jsi byl(a)
      p\u0159edt\xEDm."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721485
    m_Localized: "K tomu pot\u0159ebuji, abyste stiskli tla\u010D\xEDtko \u201EOK\u201C
      v doln\xED \u010D\xE1sti obrazovky."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721486
    m_Localized: "Vyzkou\u0161ejte to! (Nyn\xED se to objevilo)"
    m_Metadata:
      m_Items: []
  - m_Id: 414618628841472
    m_Localized: ZDROJ
    m_Metadata:
      m_Items: []
  - m_Id: 414618674978816
    m_Localized: "DAL\u0160\xCD"
    m_Metadata:
      m_Items: []
  - m_Id: 414618674978817
    m_Localized: "Zaregistrujte se na webu profit365.cz, vlo\u017Ete po\u010D\xE1te\u010Dn\xED
      \u010D\xE1stku a sledujte, jak va\u0161e pen\xEDze rostou. Ka\u017Ed\xFD nov\xFD
      u\u017Eivatel z\xEDsk\xE1 bonus 250 K\u010D."
    m_Metadata:
      m_Items: []
  - m_Id: 414618674978818
    m_Localized: "Investujte bez rizika a z\xEDskejte jist\xFD v\xFDnos"
    m_Metadata:
      m_Items: []
  - m_Id: 426683309416448
    m_Localized: RODINA
    m_Metadata:
      m_Items: []
  - m_Id: 426683309416449
    m_Localized: "P\u0158\xC1TEL\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 426683309416450
    m_Localized: "SOUSED\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 427584111697920
    m_Localized: "Vid\u011Bli jste to?"
    m_Metadata:
      m_Items: []
  - m_Id: 1427335212883968
    m_Localized: "U\u017E jsem to vid\u011Bl, ale stejn\u011B d\u011Bkuji."
    m_Metadata:
      m_Items: []
  - m_Id: 1427335279992832
    m_Localized: "Juan mi to u\u017E poslal. Mysl\xEDm, \u017Ee si n\u011Bco objedn\xE1me,
      uvid\xEDme, jestli to projde."
    m_Metadata:
      m_Items: []
  - m_Id: 1427335279992833
    m_Localized: "Ne, ne, pros\xEDm, nesd\xEDlejte to."
    m_Metadata:
      m_Items: []
  - m_Id: 1427335279992834
    m_Localized: "Toto je podvod, pros\xEDm, nenalet\u011Bte na to. Cht\u011Bj\xED
      jen va\u0161e \xFAdaje. Vl\xE1da takov\xE9 dotace neposkytuje."
    m_Metadata:
      m_Items: []
  - m_Id: 1427335279992835
    m_Localized: "D\u011Bkujeme za sd\xEDlen\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 1427335279992836
    m_Localized: "D\xEDky! Zkazilo se n\xE1m j\xEDdlo v mraz\xE1ku v baru, ty pen\xEDze
      se n\xE1m budou hodit."
    m_Metadata:
      m_Items: []
  - m_Id: 1449960068800512
    m_Localized: "Sd\xEDlel jsi fale\u0161nou zpr\xE1vu."
    m_Metadata:
      m_Items: []
  - m_Id: 1449960140103680
    m_Localized: "Nev\u0161iml sis, jak je to napsan\xE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 1449960140103681
    m_Localized: "M\u011Bl by sis \u010Dl\xE1nky p\u0159ed odesl\xE1n\xEDm p\u0159e\u010D\xEDst;
      m\u016F\u017Ee to m\xEDt v\xE1\u017En\xE9 n\xE1sledky."
    m_Metadata:
      m_Items: []
  - m_Id: 1449960140103682
    m_Localized: "Sd\xEDlel jsi pravdivou zpr\xE1vu."
    m_Metadata:
      m_Items: []
  - m_Id: 1449960140103683
    m_Localized: "Ne\u010Detl jsi to, ale m\u011Bl jsi \u0161t\u011Bst\xED, \u017Ee
      to byla pravda. M\u011Bl by sis to p\u0159e\u010D\xEDst, ne\u017E to sd\xEDl\xED\u0161."
    m_Metadata:
      m_Items: []
  - m_Id: 1470815863758848
    m_Localized: "V\xEDtejte v Level UP!"
    m_Metadata:
      m_Items: []
  - m_Id: 1470815909896192
    m_Localized: Vyberte si jazyk
    m_Metadata:
      m_Items: []
  - m_Id: 1470815909896193
    m_Localized: Toto je Level UP!
    m_Metadata:
      m_Items: []
  - m_Id: 1470815914090496
    m_Localized: "Ve h\u0159e budete komunikovat s r\u016Fzn\xFDmi zpr\xE1vami. M\u016F\u017Eete
      s nimi komunikovat tak, \u017Ee je p\u0159epo\u0161lete zn\xE1m\xFDm (nebo
      tak\xE9 ne!) a sledovat, jak reaguj\xED na to, co jim pos\xEDl\xE1te."
    m_Metadata:
      m_Items: []
  - m_Id: 1470815914090497
    m_Localized: Do toho!
    m_Metadata:
      m_Items: []
  - m_Id: 1470815914090498
    m_Localized: "Ovlivnil v\xE1s v\xFDpadek proudu? Zde v\xE1m vysv\u011Btl\xEDme,
      jak m\u016F\u017Eete z\xEDskat kompenzaci."
    m_Metadata:
      m_Items: []
  - m_Id: 1470815914090499
    m_Localized: "Pr\xE1v\u011B jste obdr\u017Eeli ozn\xE1men\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 1470815914090500
    m_Localized: "Otev\u0159\xEDt"
    m_Metadata:
      m_Items: []
  - m_Id: 1805145240690688
    m_Localized: "Tv\u016Fj vliv"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438567223296
    m_Localized: "To je v\u0161e, dostali jste se a\u017E na konec hry!"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438634332160
    m_Localized: "Zopakujme si, co jsme se nau\u010Dili!"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438634332161
    m_Localized: "Co jsme se nau\u010Dili?"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438634332162
    m_Localized: "D\xEDky nov\xFDm technologi\xEDm jsou zpr\xE1vy na dosah ruky ka\u017Ed\xE9ho.
      Je d\u016Fle\u017Eit\xE9 nau\u010Dit se jim rozum\u011Bt a nenechat se zm\xE1st
      dezinformacemi."
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526464
    m_Localized: "Co jsme se nau\u010Dili?"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526465
    m_Localized: "Proto bychom se nem\u011Bli spokojit pouze s titulem, a\u0165 u\u017E
      je sebelep\u0161\xED..."
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526466
    m_Localized: "Informovanost je kl\xED\u010Dov\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526467
    m_Localized: "Mus\xEDme si zpr\xE1vy P\u0158E\u010C\xCDST, ne\u017E je s n\u011Bk\xFDm
      sd\xEDl\xEDme, proto\u017Ee nev\xEDme, jakou \u0161kodu t\xEDm m\u016F\u017Eeme
      zp\u016Fsobit."
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526468
    m_Localized: Zobrazit zdroj
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526469
    m_Localized: "Je d\u016Fle\u017Eit\xE9, abychom vid\u011Bli, KDO \u010Dl\xE1nek
      p\xED\u0161e, abychom v\u011Bd\u011Bli, zda m\u016F\u017Eeme obsahu v\xEDce
      d\u016Fv\u011B\u0159ovat, nebo ne."
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526470
    m_Localized: "V\u0161\xEDmat si p\xEDsma"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526471
    m_Localized: "Je tak\xE9 velmi d\u016Fle\u017Eit\xE9 v\u0161\xEDmat si, jak jsou
      informace naps\xE1ny. Fale\u0161n\xE9 \u010Dl\xE1nky \u010Dasto podn\u011Bcuj\xED
      nen\xE1vist nebo neuv\xE1d\u011Bj\xED skute\u010Dn\u011B spolehliv\xE9 zdroje."
    m_Metadata:
      m_Items: []
  - m_Id: 2919120602107904
    m_Localized: "Douf\xE1me, \u017Ee se v\xE1m to l\xEDbilo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2919120602107905
    m_Localized: "Stiskn\u011Bte tla\u010D\xEDtko pro n\xE1vrat do \xFAvodn\xEDho
      menu."
    m_Metadata:
      m_Items: []
  - m_Id: 8072467420995584
    m_Localized: "Zp\u011Bt"
    m_Metadata:
      m_Items: []
  - m_Id: 9056519614861312
    m_Localized: "Rozum\xEDm"
    m_Metadata:
      m_Items: []
  - m_Id: 9056519644221440
    m_Localized: "Ov\u011B\u0159it"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758147280896
    m_Localized: "V\xEDtejte u S.M.P.D.S"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778368
    m_Localized: "D\u011Bkujeme v\xE1m za \xFA\u010Dast v na\u0161em v\xFDcvikov\xE9m
      programu brig\xE1dy S.M.P.D.S (Sjednocen\xE1 Moudr\xE1 Proti\u2011Dezinforma\u010Dn\xED
      S\xEDla)"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778369
    m_Localized: "V\xEDtejte u S.M.P.D.S"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778370
    m_Localized: "Na\u0161\xEDm c\xEDlem je p\u0159ipravit vybran\xE9 skupiny k boji
      proti dezinformac\xEDm. Va\u0161e l\xE9ta a zku\u0161enosti z v\xE1s \u010Din\xED
      ide\xE1ln\xED osobu pro tuto misi."
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778371
    m_Localized: "V\xEDtejte u S.M.P.D.S"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778372
    m_Localized: "Prarodi\u010De jsou zdrojem pozn\xE1n\xED a v\u017Edy jsou ochotni
      pomoci sv\xFDm bl\xEDzk\xFDm v obt\xED\u017En\xFDch chv\xEDl\xEDch."
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778373
    m_Localized: "S.M.P.D.S v\xE1s pot\u0159ebuje"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778374
    m_Localized: "Nach\xE1z\xEDme se v krizov\xE9m obdob\xED a pot\u0159ebujeme va\u0161i
      pomoc. \u017Dijeme v dob\u011B rozd\u011Blen\xED a neshod a jedn\xEDm z hlavn\xEDch
      faktor\u016F je dezinformace."
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778375
    m_Localized: "S.M.P.D.S v\xE1s pot\u0159ebuje"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778376
    m_Localized: "Dezinformace se \u0161\xED\u0159\xED jako po\u017E\xE1r d\xEDky
      nov\xFDm technologi\xEDm, nap\u0159\xEDklad mobiln\xEDm telefon\u016Fm s p\u0159ipojen\xEDm
      k internetu."
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778377
    m_Localized: "S.M.P.D.S v\xE1s tr\xE9nuje"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758226972672
    m_Localized: "Va\u0161e moudrost m\u016F\u017Ee pomoci sv\u011Btu. S.M.P.D.S
      p\u0159ipravuje na\u0161e \u010Dleny, aby udr\u017Eeli obyvatelstvo dob\u0159e
      informovan\xE9 ov\u011B\u0159en\xFDmi a aktu\xE1ln\xEDmi \u010Dl\xE1nky."
    m_Metadata:
      m_Items: []
  - m_Id: 9858758226972673
    m_Localized: "S.M.P.D.S v\xE1s pot\u0159ebuje"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758226972674
    m_Localized: "Va\u0161\xEDm \xFAkolem je zpracovat \u010Dl\xE1nky, kter\xE9 obdr\u017E\xEDte,
      a posoudit, zda obsahuj\xED pravdiv\xE9 informace."
    m_Metadata:
      m_Items: []
  - m_Id: 9858758226972675
    m_Localized: "Za\u010D\xEDn\xE1me!"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758226972676
    m_Localized: "Vp\u0159ed, nov\xE1\u010Dku! V\xFDcvik za\u010D\xEDn\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 14472164729610240
    m_Localized: "\u010C\xEDst \u010Dl\xE1nky"
    m_Metadata:
      m_Items: []
  - m_Id: 14472164788330496
    m_Localized: "Sd\xEDlen\xE9 \u010Dl\xE1nky True"
    m_Metadata:
      m_Items: []
  - m_Id: 14472164788330497
    m_Localized: "Sd\xEDlen\xE9 nepravdiv\xE9 \u010Dl\xE1nky"
    m_Metadata:
      m_Items: []
  - m_Id: 14487224642363392
    m_Localized: "Webov\xE1 str\xE1nka"
    m_Metadata:
      m_Items: []
  - m_Id: 14487224688500736
    m_Localized: "Soci\xE1ln\xED m\xE9dia"
    m_Metadata:
      m_Items: []
  - m_Id: 14487224688500737
    m_Localized: Noviny
    m_Metadata:
      m_Items: []
  - m_Id: 14487224688500738
    m_Localized: "Internetov\xFD blog"
    m_Metadata:
      m_Items: []
  - m_Id: 14489832853528576
    m_Localized: "M\u011Bl byste to zkusit znovu..."
    m_Metadata:
      m_Items: []
  - m_Id: 14489832853528577
    m_Localized: "Pokra\u010Dujte!"
    m_Metadata:
      m_Items: []
  - m_Id: 14489832853528578
    m_Localized: "Dobr\xE1 pr\xE1ce! Ud\u011Blal jsi spr\xE1vnou v\u011Bc."
    m_Metadata:
      m_Items: []
  - m_Id: 14489832857722880
    m_Localized: "Gratulujeme! Dokon\u010Dili jste \u0161kolen\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 14489832857722881
    m_Localized: "P\u0159e\u010Detli jste {0}/{1} \u010Dl\xE1nk\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 14489832857722882
    m_Localized: "Sd\xEDleli jste {0} nepravdiv\xFDch \u010Dl\xE1nk\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 14489832857722883
    m_Localized: "Sd\xEDleli jste {0} pravdiv\xE9 \u010Dl\xE1nky"
    m_Metadata:
      m_Items: []
  - m_Id: 14494645209194496
    m_Localized: "Vypad\xE1 to manipulativn\u011B."
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137536
    m_Localized: "To je zaj\xEDmav\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137537
    m_Localized: "Nev\xEDm."
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137538
    m_Localized: "Ano, rozum\xEDm."
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137539
    m_Localized: Ne, zopakuj to.
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137540
    m_Localized: Je to pravda.
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137541
    m_Localized: "To nen\xED pravda."
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137542
    m_Localized: "Skupina P\u0159\xE1tel"
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137543
    m_Localized: "Rodinn\xE1 Skupina"
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137544
    m_Localized: "Skupina Soused\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137545
    m_Localized: "Dal\u0161\xED krok"
    m_Metadata:
      m_Items: []
  - m_Id: 14598736433614848
    m_Localized: "B\xEDl\xFD d\u016Fm se vysm\xEDv\xE1 deportovan\xE9mu imigrantovi
      t\xEDm, \u017Ee z n\u011Bj d\u011Bl\xE1 parodii na soci\xE1ln\xEDch s\xEDt\xEDch."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140800
    m_Localized: "B\xEDl\xFD d\u016Fm zve\u0159ejnil v pond\u011Bl\xED ve\u010Der
      na sv\xFDch soci\xE1ln\xEDch s\xEDt\xEDch, jak na Instagramu, tak na X, obr\xE1zek
      vytvo\u0159en\xFD um\u011Blou inteligenc\xED, na kter\xE9m je krabice napodobuj\xEDc\xED
      krabice panenek Labubu a uvnit\u0159 kresba mu\u017Ee v poutech spolu s t\xEDmto
      n\xE1pisem: \u201ENeleg\xE1ln\xED sexu\xE1ln\xED pred\xE1tor zat\u010Den ICE.
      Deportov\xE1n!\u201D."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140801
    m_Localized: "To je hr\u016Fza! Lidi z ICE jsou jako kozy."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140802
    m_Localized: "To je opravdu nevkusn\xE9..."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140803
    m_Localized: "D\u011Bkujeme za sd\xEDlen\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140804
    m_Localized: "Jsem r\xE1d, \u017Ee se o tyto v\u011Bci d\u011Bl\xED\u0161."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140805
    m_Localized: "Pro m\u011B je velmi d\u016Fle\u017Eit\xE9, \u017Ee jsi v obraze,
      co se d\u011Bje."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140806
    m_Localized: Ano!
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140807
    m_Localized: "Nav\xEDc, vzhledem k tomu, jak d\u016Fle\u017Eit\xE1 je ot\xE1zka
      ICE..."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140808
    m_Localized: "Ti z USA jsou docela zvl\xE1\u0161tn\xED..."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140809
    m_Localized: "V\xED\u0161, \u017Ee zve\u0159ej\u0148ovat fotky v\u011Bzn\u011B
      na ofici\xE1ln\xEDm \xFA\u010Dtu je nevkusn\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140810
    m_Localized: "No, m\u011B to bav\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140811
    m_Localized: "Pros\xEDm t\u011B!"
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140812
    m_Localized: "Jak ti to m\u016F\u017Ee p\u0159ij\xEDt vtipn\xE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140813
    m_Localized: "Hraj\xED si s \u017Eivoty lid\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140814
    m_Localized: "D\u011Bkujeme za sd\xEDlen\xED t\xE9to zpr\xE1vy, je to velmi d\u016Fle\u017Eit\xE9."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
