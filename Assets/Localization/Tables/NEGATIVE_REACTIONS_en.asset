  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: NEGATIVE_REACTIONS_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 6f40342b7faca6a41985092112ffbc7d, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16778715136
    m_Localized: Do you really believe this? What a shame.
    m_Metadata:
      m_Items: []
  - m_Id: 16803880960
    m_Localized: This makes no sense. Have you even read it?
    m_Metadata:
      m_Items: []
  - m_Id: 16803880961
    m_Localized: Don't send me this things.
    m_Metadata:
      m_Items: []
  - m_Id: 16803880962
    m_Localized: I'm keen to know when are you gonna send something useful. This
      makes no sense.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075264
    m_Localized: I don't believe it.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075265
    m_Localized: This is rubbish.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075266
    m_Localized: That's a lie. It's a lie. Don't share this.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075267
    m_Localized: This news bothers me; I don't believe it's true.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075268
    m_Localized: I don't like reading news like this.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075269
    m_Localized: This is wrong. I don't see it that way.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075270
    m_Localized: Don't send us this, we don't like it.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075271
    m_Localized: I disagree. This is wrong.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075272
    m_Localized: No, no, and no.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075273
    m_Localized: I dislike reading these things.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075274
    m_Localized: No, please don't share this.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075275
    m_Localized: I think this is fake. It's not true.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075276
    m_Localized: I have already received this and I think it's a lie.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075277
    m_Localized: This information is biased. I don't think I'm going to read it.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075278
    m_Localized: What a load of rubbish!
    m_Metadata:
      m_Items: []
  - m_Id: 16808075279
    m_Localized: This is nonsense; you only need to look at the headline.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075280
    m_Localized: Do you really read these things? You need to be more careful.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075281
    m_Localized: This has been proven to be false, please do not share it anymore.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075282
    m_Localized: This is pure manipulation!
    m_Metadata:
      m_Items: []
  - m_Id: 16808075283
    m_Localized: The things people come up with to go viral... Don't believe it.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075284
    m_Localized: This news makes me feel sick.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075285
    m_Localized: I don't like this article at all.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075286
    m_Localized: Why are you sending us this?
    m_Metadata:
      m_Items: []
  - m_Id: 16808075287
    m_Localized: I no longer know what to believe and what not to believe.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075288
    m_Localized: What kind of world are we living in?
    m_Metadata:
      m_Items: []
  - m_Id: 16808075289
    m_Localized: This is concerning.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075290
    m_Localized: Everything is so scary!
    m_Metadata:
      m_Items: []
  - m_Id: 16808075291
    m_Localized: I really don't know what to think anymore.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075292
    m_Localized: I'm not convinced by this.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075293
    m_Localized: I'm not really sure.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
