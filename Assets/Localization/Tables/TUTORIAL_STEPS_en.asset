  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TUTORIAL_STEPS_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 22cb33751284c934dbba25f1e0393930, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 11980431360
    m_Localized: Welcome to Level Up!
    m_Metadata:
      m_Items: []
  - m_Id: 12005597184
    m_Localized: In this section, we will give you INSTRUCTIONS on how to play.
    m_Metadata:
      m_Items: []
  - m_Id: 12005597185
    m_Localized: Here you can see multiple newspaper articles.
    m_Metadata:
      m_Items: []
  - m_Id: 12005597186
    m_Localized: You can see the title and a related image.
    m_Metadata:
      m_Items: []
  - m_Id: 12005597187
    m_Localized: Also, using your finger, you can move around this screen.
    m_Metadata:
      m_Items: []
  - m_Id: 12005597188
    m_Localized: Try it!
    m_Metadata:
      m_Items: []
  - m_Id: 12005597189
    m_Localized: Now we will show you the buttons for the articles.
    m_Metadata:
      m_Items: []
  - m_Id: 12005597190
    m_Localized: "The first one is at the top right, the \u201CSkip\u201D button."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597191
    m_Localized: By clicking this button, you are telling us that you are NOT interested
      in this article, so it will disappear from here.
    m_Metadata:
      m_Items: []
  - m_Id: 12005597192
    m_Localized: Try pressing it!
    m_Metadata:
      m_Items: []
  - m_Id: 12005597193
    m_Localized: "The next button is \u201CREAD.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597194
    m_Localized: By clicking this button, you will see more information about the
      article.
    m_Metadata:
      m_Items: []
  - m_Id: 12005597195
    m_Localized: Try it!
    m_Metadata:
      m_Items: []
  - m_Id: 12005597196
    m_Localized: Great!
    m_Metadata:
      m_Items: []
  - m_Id: 12005597197
    m_Localized: Now that you've read the article, you know what it's really about.
    m_Metadata:
      m_Items: []
  - m_Id: 12005597198
    m_Localized: We will then try to share it with your close groups.
    m_Metadata:
      m_Items: []
  - m_Id: 12005597199
    m_Localized: "The third and final button available is \u201CShare.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597200
    m_Localized: With this button, you will be able to share articles that you find
      relevant.
    m_Metadata:
      m_Items: []
  - m_Id: 12005597201
    m_Localized: It is important that you share those that impact you or interest
      you.
    m_Metadata:
      m_Items: []
  - m_Id: 12005597202
    m_Localized: Try it!
    m_Metadata:
      m_Items: []
  - m_Id: 12005597203
    m_Localized: Great! You're already doing great.
    m_Metadata:
      m_Items: []
  - m_Id: 12005597204
    m_Localized: Before we go, let's review the buttons for a moment.
    m_Metadata:
      m_Items: []
  - m_Id: 12009791488
    m_Localized: "Once you have selected the correct one, the \u201CNEXT\u201D button
      below will become active again."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791489
    m_Localized: Press the button to SKIP article.
    m_Metadata:
      m_Items: []
  - m_Id: 12009791490
    m_Localized: Great job!
    m_Metadata:
      m_Items: []
  - m_Id: 12009791491
    m_Localized: Now press the button to READ articles.
    m_Metadata:
      m_Items: []
  - m_Id: 12009791492
    m_Localized: Great! Now the last one...
    m_Metadata:
      m_Items: []
  - m_Id: 12009791493
    m_Localized: Click the share articles button.
    m_Metadata:
      m_Items: []
  - m_Id: 12009791494
    m_Localized: Perfect! It seems like you have everything figured out.
    m_Metadata:
      m_Items: []
  - m_Id: 12009791495
    m_Localized: We'll leave you to the game now...
    m_Metadata:
      m_Items: []
  - m_Id: 12009791496
    m_Localized: Remember, you can report any technical problems.
    m_Metadata:
      m_Items: []
  - m_Id: 12009791497
    m_Localized: Enjoy yourself!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
