  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: ASSISTANT_ADVICES_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: a2386069f033e25449721c41e84cb377, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 106963898368
    m_Localized: "Creo que no te est\xE1s fijando bien en lo que lees"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007232
    m_Localized: "Has compartido algunos bulos, a pesar de haber le\xEDdo los art\xEDculos"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007233
    m_Localized: "Intenta fijarte m\xE1s en si apelan a tus emociones"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007234
    m_Localized: "O si la redacci\xF3n parece profesional"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007235
    m_Localized: "\xA1Y no te olvides de revisar la fuente!"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007236
    m_Localized: "No est\xE1s leyendo las cosas antes de compartirlas..."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007237
    m_Localized: "Eso te hace difundir m\xE1s bulos"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007238
    m_Localized: "Tienes que leer m\xE1s los art\xEDculos"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007239
    m_Localized: "No est\xE1s leyendo las cosas antes de compartirlas..."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201536
    m_Localized: Tienes suerte de que algunos son ciertos
    m_Metadata:
      m_Items: []
  - m_Id: 107035201537
    m_Localized: "Pero esto no siempre es as\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 107035201538
    m_Localized: "Tienes que leer m\xE1s los art\xEDculos"
    m_Metadata:
      m_Items: []
  - m_Id: 107035201539
    m_Localized: "No est\xE1s leyendo las cosas antes de ignorarlas..."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201540
    m_Localized: "No puedes descartar las cosas tan r\xE1pido s\xF3lo con un titular"
    m_Metadata:
      m_Items: []
  - m_Id: 107035201541
    m_Localized: "Deber\xEDas pararte a leerlo y valorar su veracidad"
    m_Metadata:
      m_Items: []
  - m_Id: 18859510659207168
    m_Localized: "Ahora puedes compartir el art\xEDculo o puedes ignorarlo pulsando
      el bot\xF3n 'Ignorar'"
    m_Metadata:
      m_Items: []
  - m_Id: 18859510810202112
    m_Localized: "Puedes Leer el art\xEDculo pulsando el bot\xF3n 'Leer'. O puedes
      ignorarlo pulsando el bot\xF3n 'Ignorar'"
    m_Metadata:
      m_Items: []
  - m_Id: 18859510810202113
    m_Localized: "\xA1Recuerda! Puedes utilizar el dedo para deslizar la pantalla"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294825885696
    m_Localized: "\xA1Bienvenido al juego!"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023040
    m_Localized: Soy tu asistante personal
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023041
    m_Localized: "Si te veo atascado te dar\xE9 alg\xFAn consejo de c\xF3mo seguir"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023042
    m_Localized: "L\xE9eme y pulsa el bot\xF3n \"OK\" que est\xE1s pulsando ahora
      para quitar mi mensaje"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023043
    m_Localized: "En la carita verde de arriba a la derecha puedes ver c\xF3mo estoy"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023044
    m_Localized: "Si en alg\xFAn momento me ves amarillo..."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605952
    m_Localized: "\xA1Es que te tengo que dar alg\xFAn consejo!"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605953
    m_Localized: "\xA1Genial!"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605954
    m_Localized: Me has visto preocupado por ti y me has hecho caso jeje
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605955
    m_Localized: "Cuando esto suceda en el juego, te dar\xE9 alg\xFAn consejo"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605956
    m_Localized: "Porque habr\xE1 algo que podr\xEDas mejorar"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605957
    m_Localized: Vamos a probarlo
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605958
    m_Localized: "Dicho esto, \xA1espero no molestarte m\xE1s!"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605959
    m_Localized: "Porque eso significar\xE1 que lo haces bien"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605960
    m_Localized: "\xA1\xC1nimo con el juego!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
