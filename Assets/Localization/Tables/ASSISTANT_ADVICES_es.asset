  m_TableData:
  - m_Id: 106963898368
    m_Localized: "Creo que no te est\xE1s fijando bien en lo que lees"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007232
    m_Localized: "Has compartido algunos bulos, a pesar de haber le\xEDdo los art\xEDculos"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007233
    m_Localized: "Intenta fijarte m\xE1s en si apelan a tus emociones"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007234
    m_Localized: "O si la redacci\xF3n parece profesional"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007235
    m_Localized: "\xA1Y no te olvides de revisar la fuente!"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007236
    m_Localized: "No est\xE1s leyendo las cosas antes de compartirlas..."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007237
    m_Localized: "Eso te hace difundir m\xE1s bulos"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007238
    m_Localized: "Tienes que leer m\xE1s los art\xEDculos"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007239
    m_Localized: "No est\xE1s leyendo las cosas antes de compartirlas..."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201536
    m_Localized: Tienes suerte de que algunos son ciertos
    m_Metadata:
      m_Items: []
  - m_Id: 107035201537
    m_Localized: "Pero esto no siempre es as\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 107035201538
    m_Localized: "Tienes que leer m\xE1s los art\xEDculos"
    m_Metadata:
      m_Items: []
  - m_Id: 107035201539
    m_Localized: "No est\xE1s leyendo las cosas antes de salt\xE1rtelas..."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201540
    m_Localized: "No puedes descartar las cosas tan r\xE1pido s\xF3lo con un titular"
    m_Metadata:
      m_Items: []
  - m_Id: 107035201541
    m_Localized: "Deber\xEDas pararte a leerlo y valorar su veracidad"
    m_Metadata:
      m_Items: []
