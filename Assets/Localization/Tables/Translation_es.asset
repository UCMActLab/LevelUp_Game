    m_Metadata:
      m_Items: []
  - m_Id: 82639330706378752
    m_Localized: "\xA1Adelante! Comenzamos con el programa."
    m_Metadata:
      m_Items: []
  - m_Id: 82697429085507584
    m_Localized: "\xA1Enhorabuena! Has completado el programa V.E.R.I "
    m_Metadata:
      m_Items: []
  - m_Id: 82697429261668352
    m_Localized: "Detectar la desinformaci\xF3n no es tarea facil. Sin embargo, tu
      has sido capaz de hacerlo"
    m_Metadata:
      m_Items: []
  - m_Id: 82697429261668353
    m_Localized: 'Ahora veremos lo que hemos aprendido... '
    m_Metadata:
      m_Items: []
  - m_Id: 82697429265862656
    m_Localized: "<b>\xA1Y te daremos tu insignia de experto/a en verificaci\xF3n!</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 82697429265862657
    m_Localized: "Ahora s\xED... <b> \xA1\xA1VAMOS A POR TU INSIGNIA!! </b>"
