  m_TableData:
  - m_Id: 106963898368
    m_Localized: "\u041C\u0438\u0441\u043B\u044F, \u0447\u0435 \u043D\u0435 \u043E\u0431\u0440\u044A\u0449\u0430\u0448
      \u0434\u043E\u0441\u0442\u0430\u0442\u044A\u0447\u043D\u043E \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u043D\u0430 \u0442\u043E\u0432\u0430, \u043A\u043E\u0435\u0442\u043E \u0447\u0435\u0442\u0435\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007232
    m_Localized: "\u0421\u043F\u043E\u0434\u0435\u043B\u0438\u043B \u0441\u0438 \u043D\u044F\u043A\u043E\u0438
      \u0444\u0430\u043B\u0448\u0438\u0432\u0438 \u043D\u043E\u0432\u0438\u043D\u0438,
      \u0432\u044A\u043F\u0440\u0435\u043A\u0438 \u0447\u0435 \u0441\u0438 \u043F\u0440\u043E\u0447\u0435\u043B
      \u0441\u0442\u0430\u0442\u0438\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007233
    m_Localized: "\u041E\u043F\u0438\u0442\u0430\u0439\u0442\u0435 \u0441\u0435 \u0434\u0430
      \u043E\u0431\u044A\u0440\u043D\u0435\u0442\u0435 \u043F\u043E\u0432\u0435\u0447\u0435
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043D\u0430 \u0442\u043E\u0432\u0430
      \u0434\u0430\u043B\u0438 \u0442\u0435 \u0437\u0430\u0441\u044F\u0433\u0430\u0442
      \u0435\u043C\u043E\u0446\u0438\u0438\u0442\u0435 \u0432\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007234
    m_Localized: "\u0418\u043B\u0438 \u0430\u043A\u043E \u0442\u0435\u043A\u0441\u0442\u044A\u0442
      \u0438\u0437\u0433\u043B\u0435\u0436\u0434\u0430 \u043F\u0440\u043E\u0444\u0435\u0441\u0438\u043E\u043D\u0430\u043B\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007235
    m_Localized: "\u0418 \u043D\u0435 \u0437\u0430\u0431\u0440\u0430\u0432\u044F\u0439\u0442\u0435
      \u0434\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u0435 \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007236
    m_Localized: "\u041D\u0435 \u0447\u0435\u0442\u0435\u0448 \u043D\u0435\u0449\u0430\u0442\u0430,
      \u043F\u0440\u0435\u0434\u0438 \u0434\u0430 \u0433\u0438 \u0441\u043F\u043E\u0434\u0435\u043B\u0438\u0448..."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007237
    m_Localized: "\u0422\u043E\u0432\u0430 \u0442\u0435 \u043A\u0430\u0440\u0430
      \u0434\u0430 \u0440\u0430\u0437\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0432\u0430\u0448
      \u043F\u043E\u0432\u0435\u0447\u0435 \u0441\u043B\u0443\u0445\u043E\u0432\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 107031007238
    m_Localized: "\u0422\u0440\u044F\u0431\u0432\u0430 \u0434\u0430 \u043F\u0440\u043E\u0447\u0435\u0442\u0435\u0442\u0435
      \u043F\u043E\u0432\u0435\u0447\u0435 \u0441\u0442\u0430\u0442\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 107031007239
    m_Localized: "\u041D\u0435 \u0447\u0435\u0442\u0435\u0448 \u043D\u0435\u0449\u0430\u0442\u0430,
      \u043F\u0440\u0435\u0434\u0438 \u0434\u0430 \u0433\u0438 \u0441\u043F\u043E\u0434\u0435\u043B\u0438\u0448..."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201536
    m_Localized: "\u0418\u043C\u0430\u0448 \u043A\u044A\u0441\u043C\u0435\u0442,
      \u0447\u0435 \u043D\u044F\u043A\u043E\u0438 \u043E\u0442 \u0442\u044F\u0445
      \u0441\u0430 \u0432\u0435\u0440\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201537
    m_Localized: "\u041D\u043E \u0442\u043E\u0432\u0430 \u043D\u0435 \u0432\u0438\u043D\u0430\u0433\u0438
      \u0435 \u0442\u0430\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201538
    m_Localized: "\u0422\u0440\u044F\u0431\u0432\u0430 \u0434\u0430 \u043F\u0440\u043E\u0447\u0435\u0442\u0435\u0442\u0435
      \u043F\u043E\u0432\u0435\u0447\u0435 \u0441\u0442\u0430\u0442\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 107035201539
    m_Localized: "\u041D\u0435 \u0447\u0435\u0442\u0435\u0448 \u0441\u044A\u0434\u044A\u0440\u0436\u0430\u043D\u0438\u0435\u0442\u043E,
      \u043F\u0440\u0435\u0434\u0438 \u0434\u0430 \u0433\u043E \u043F\u0440\u0435\u043D\u0435\u0431\u0440\u0435\u0433\u043D\u0435\u0448..."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201540
    m_Localized: "\u041D\u0435 \u043C\u043E\u0436\u0435\u0448 \u0434\u0430 \u043E\u0442\u0445\u0432\u044A\u0440\u043B\u044F\u0448
      \u043D\u0435\u0449\u0430\u0442\u0430 \u0442\u043E\u043B\u043A\u043E\u0432\u0430
      \u0431\u044A\u0440\u0437\u043E \u0441\u0430\u043C\u043E \u0432\u044A\u0437
      \u043E\u0441\u043D\u043E\u0432\u0430 \u043D\u0430 \u0437\u0430\u0433\u043B\u0430\u0432\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 107035201541
    m_Localized: "\u0422\u0440\u044F\u0431\u0432\u0430 \u0434\u0430 \u0441\u043F\u0440\u0435\u0448,
      \u0437\u0430 \u0434\u0430 \u0433\u043E \u043F\u0440\u043E\u0447\u0435\u0442\u0435\u0448
      \u0438 \u0434\u0430 \u043E\u0446\u0435\u043D\u0438\u0448 \u043D\u0435\u0433\u043E\u0432\u0430\u0442\u0430
      \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u043E\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 18859510659207168
    m_Localized: "\u0421\u0435\u0433\u0430 \u043C\u043E\u0436\u0435\u0448 \u0434\u0430
      \u0441\u043F\u043E\u0434\u0435\u043B\u0438\u0448 \u0441\u0442\u0430\u0442\u0438\u044F\u0442\u0430
      \u0438\u043B\u0438 \u0434\u0430 \u044F \u043F\u0440\u0435\u043D\u0435\u0431\u0440\u0435\u0433\u043D\u0435\u0448,
      \u043A\u0430\u0442\u043E \u043D\u0430\u0442\u0438\u0441\u043D\u0435\u0448 \u0431\u0443\u0442\u043E\u043D\u0430
      \u201E\u041F\u0440\u0435\u043D\u0435\u0431\u0440\u0435\u0433\u043D\u0438\u201C"
    m_Metadata:
      m_Items: []
  - m_Id: 18859510810202112
    m_Localized: "\u041C\u043E\u0436\u0435\u0448 \u0434\u0430 \u043F\u0440\u043E\u0447\u0435\u0442\u0435\u0448
      \u0441\u0442\u0430\u0442\u0438\u044F\u0442\u0430, \u043A\u0430\u0442\u043E
      \u043D\u0430\u0442\u0438\u0441\u043D\u0435\u0448 \u0431\u0443\u0442\u043E\u043D\u0430
      \u201E\u041F\u0440\u043E\u0447\u0435\u0442\u0438\u201C. \u0418\u043B\u0438
      \u043C\u043E\u0436\u0435\u0448 \u0434\u0430 \u044F \u043F\u0440\u0435\u043D\u0435\u0431\u0440\u0435\u0433\u043D\u0435\u0448,
      \u043A\u0430\u0442\u043E \u043D\u0430\u0442\u0438\u0441\u043D\u0435\u0448 \u0431\u0443\u0442\u043E\u043D\u0430
      \u201E\u041F\u0440\u0435\u043D\u0435\u0431\u0440\u0435\u0433\u043D\u0438\u201C"
    m_Metadata:
      m_Items: []
  - m_Id: 18859510810202113
    m_Localized: "\u041D\u0435 \u0437\u0430\u0431\u0440\u0430\u0432\u044F\u0439!
      \u041C\u043E\u0436\u0435\u0448 \u0434\u0430 \u043F\u043B\u044A\u0437\u0433\u0430\u0448
      \u0435\u043A\u0440\u0430\u043D\u0430 \u0441 \u043F\u0440\u044A\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294825885696
    m_Localized: "\u0414\u043E\u0431\u0440\u0435 \u0434\u043E\u0448\u044A\u043B \u0432
      \u0438\u0433\u0440\u0430\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023040
    m_Localized: "\u0410\u0437 \u0441\u044A\u043C \u0442\u0432\u043E\u044F\u0442
      \u043B\u0438\u0447\u0435\u043D \u0430\u0441\u0438\u0441\u0442\u0435\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023041
    m_Localized: "\u0410\u043A\u043E \u0432\u0438\u0434\u044F, \u0447\u0435 \u0441\u0438
      \u0437\u0430\u0442\u0440\u0443\u0434\u043D\u0435\u043D, \u0449\u0435 \u0442\u0438
      \u0434\u0430\u043C \u0441\u044A\u0432\u0435\u0442 \u043A\u0430\u043A \u0434\u0430
      \u043F\u0440\u043E\u0434\u044A\u043B\u0436\u0438\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023042
    m_Localized: "\u041F\u0440\u043E\u0447\u0435\u0442\u0438 \u043C\u0435 \u0438
      \u043D\u0430\u0442\u0438\u0441\u043D\u0438 \u0431\u0443\u0442\u043E\u043D\u0430
      \u201EOK\u201C, \u043A\u043E\u0439\u0442\u043E \u043D\u0430\u0442\u0438\u0441\u043A\u0430\u0448
      \u0432 \u043C\u043E\u043C\u0435\u043D\u0442\u0430, \u0437\u0430 \u0434\u0430
      \u0441\u043A\u0440\u0438\u0435\u0448 \u0441\u044A\u043E\u0431\u0449\u0435\u043D\u0438\u0435\u0442\u043E
      \u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023043
    m_Localized: "\u041D\u0430 \u0437\u0435\u043B\u0435\u043D\u043E\u0442\u043E \u043B\u0438\u0447\u0438\u0446\u0435
      \u0432 \u0433\u043E\u0440\u043D\u0438\u044F \u0434\u0435\u0441\u0435\u043D
      \u044A\u0433\u044A\u043B \u043C\u043E\u0436\u0435\u0448 \u0434\u0430 \u0432\u0438\u0434\u0438\u0448
      \u043A\u0430\u043A \u0441\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294872023044
    m_Localized: "\u0410\u043A\u043E \u0432 \u043D\u044F\u043A\u0430\u043A\u044A\u0432
      \u043C\u043E\u043C\u0435\u043D\u0442 \u043C\u0435 \u0432\u0438\u0434\u0438\u0448
      \u0436\u044A\u043B\u0442..."
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605952
    m_Localized: "\u0422\u043E\u0432\u0430 \u043E\u0437\u043D\u0430\u0447\u0430\u0432\u0430,
      \u0447\u0435 \u0442\u0440\u044F\u0431\u0432\u0430 \u0434\u0430 \u0442\u0438
      \u0434\u0430\u043C \u0441\u044A\u0432\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605957
    m_Localized: "\u0414\u0430 \u043E\u043F\u0438\u0442\u0430\u043C\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605953
    m_Localized: "\u0421\u0442\u0440\u0430\u0445\u043E\u0442\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605954
    m_Localized: "\u0412\u0438\u0434\u044F, \u0447\u0435 \u0441\u0435 \u0442\u0440\u0435\u0432\u043E\u0436\u0430
      \u0437\u0430 \u0442\u0435\u0431, \u0438 \u043C\u0435 \u043F\u043E\u0441\u043B\u0443\u0448\u0430,
      \u0445\u0435-\u0445\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605955
    m_Localized: "\u041A\u043E\u0433\u0430\u0442\u043E \u0442\u043E\u0432\u0430 \u0441\u0435
      \u0441\u043B\u0443\u0447\u0438 \u0432 \u0438\u0433\u0440\u0430\u0442\u0430,
      \u0449\u0435 \u0442\u0438 \u0434\u0430\u043C \u0441\u044A\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605956
    m_Localized: "\u0417\u0430\u0449\u043E\u0442\u043E \u0441\u0438\u0433\u0443\u0440\u043D\u043E
      \u0438\u043C\u0430 \u043D\u0435\u0449\u043E, \u043A\u043E\u0435\u0442\u043E
      \u043C\u043E\u0436\u0435\u0448 \u0434\u0430 \u043F\u043E\u0434\u043E\u0431\u0440\u0438\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605958
    m_Localized: "\u041A\u0430\u0437\u0430\u043D\u043E \u0442\u043E\u0432\u0430,
      \u043D\u0430\u0434\u044F\u0432\u0430\u043C \u0441\u0435 \u0434\u0430 \u043D\u0435
      \u0442\u0435 \u043F\u0440\u0438\u0442\u0435\u0441\u043D\u044F\u0432\u0430\u043C
      \u043F\u043E\u0432\u0435\u0447\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605959
    m_Localized: "\u0417\u0430\u0449\u043E\u0442\u043E \u0442\u043E\u0432\u0430 \u0449\u0435
      \u043E\u0437\u043D\u0430\u0447\u0430\u0432\u0430, \u0447\u0435 \u0441\u0435
      \u0441\u043F\u0440\u0430\u0432\u044F\u0448 \u0434\u043E\u0431\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 19133294884605960
    m_Localized: "\u0423\u0441\u043F\u0435\u0445 \u0432 \u0438\u0433\u0440\u0430\u0442\u0430!"
    m_Metadata:
      m_Items: []
  references:
