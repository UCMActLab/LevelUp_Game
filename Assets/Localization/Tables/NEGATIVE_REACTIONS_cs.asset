  m_TableData:
  - m_Id: 16778715136
    m_Localized: "V\u011B\u0159\xED\u0161 t\u011Bmto v\u011Bcem? To je ostuda."
    m_Metadata:
      m_Items: []
  - m_Id: 16803880960
    m_Localized: "To ned\xE1v\xE1 smysl, \u010Detl jsi to v\u016Fbec?"
    m_Metadata:
      m_Items: []
  - m_Id: 16803880961
    m_Localized: "Nepos\xEDlej mi takov\xE9 v\u011Bci."
    m_Metadata:
      m_Items: []
  - m_Id: 16803880962
    m_Localized: "Po\u0161li n\u011Bkdy n\u011Bco, co stoj\xED za p\u0159e\u010Dten\xED,
      proto\u017Ee tohle ned\xE1v\xE1 \u017E\xE1dn\xFD smysl."
    m_Metadata:
      m_Items: []
