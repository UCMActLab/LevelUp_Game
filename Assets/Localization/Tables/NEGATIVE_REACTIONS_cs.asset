MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: NEGATIVE_REACTIONS_cs
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: cs
  m_SharedData: {fileID: 11400000, guid: 6f40342b7faca6a41985092112ffbc7d, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16778715136
    m_Localized: "V\u011B\u0159\xED\u0161 t\u011Bmto v\u011Bcem? To je ostuda."
    m_Metadata:
      m_Items: []
  - m_Id: 16803880960
    m_Localized: "To ned\xE1v\xE1 smysl, \u010Detl jsi to v\u016Fbec?"
    m_Metadata:
      m_Items: []
  - m_Id: 16803880961
    m_Localized: "Nepos\xEDlej mi takov\xE9 v\u011Bci."
    m_Metadata:
      m_Items: []
  - m_Id: 16803880962
    m_Localized: "Po\u0161li n\u011Bkdy n\u011Bco, co stoj\xED za p\u0159e\u010Dten\xED,
      proto\u017Ee tohle ned\xE1v\xE1 \u017E\xE1dn\xFD smysl."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075264
    m_Localized: "Tomu nev\u011B\u0159\xEDm."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075265
    m_Localized: To je nesmysl.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075266
    m_Localized: "Le\u017E. Je to le\u017E. Nesd\xEDlejte to."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075267
    m_Localized: "Tyto zpr\xE1vy m\u011B roz\u010Diluj\xED, nev\u011B\u0159\xEDm,
      \u017Ee jsou pravdiv\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075268
    m_Localized: "Nerad \u010Dtu takov\xE9 zpr\xE1vy."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075269
    m_Localized: "To je \u0161patn\xE9. J\xE1 to tak nevid\xEDm."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075270
    m_Localized: "Nepos\xEDlejte n\xE1m to, nel\xEDb\xED se n\xE1m to."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075271
    m_Localized: "Nesouhlas\xEDm. To je \u0161patn\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075272
    m_Localized: Ne, ne a ne.
    m_Metadata:
      m_Items: []
  - m_Id: 16808075273
    m_Localized: "Nerad \u010Dtu takov\xE9 v\u011Bci."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075274
    m_Localized: "Ne, ne, pros\xEDm, nesd\xEDlejte to."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075275
    m_Localized: "Mysl\xEDm, \u017Ee je to podvrh. Nen\xED to pravda."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075276
    m_Localized: "U\u017E jsem to dostal a mysl\xEDm, \u017Ee je to le\u017E."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075277
    m_Localized: "Tato informace je zaujat\xE1. Mysl\xEDm, \u017Ee to nebudu \u010D\xEDst."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075278
    m_Localized: "To je ale blb\xFD \u010Dl\xE1nek!"
    m_Metadata:
      m_Items: []
  - m_Id: 16808075279
    m_Localized: "To je nesmysl, sta\u010D\xED se pod\xEDvat na titulek."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075280
    m_Localized: "Opravdu \u010Dte\u0161 takov\xE9 v\u011Bci? Mus\xED\u0161 b\xFDt
      opatrn\u011Bj\u0161\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075281
    m_Localized: "Bylo prok\xE1z\xE1no, \u017Ee je to nepravda, pros\xEDm, d\xE1le
      to ne\u0161\xED\u0159te."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075282
    m_Localized: "To je \u010Dist\xE1 manipulace!"
    m_Metadata:
      m_Items: []
  - m_Id: 16808075283
    m_Localized: "V\u011Bci, kter\xE9 si lid\xE9 vym\xFD\u0161lej\xED, aby se staly
      vir\xE1ln\xEDmi... Nev\u011B\u0159te tomu."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075284
    m_Localized: "Tyto zpr\xE1vy mi zp\u016Fsobuj\xED \u0161patn\xFD pocit."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075285
    m_Localized: "Tento \u010Dl\xE1nek se mi v\u016Fbec nel\xEDb\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075286
    m_Localized: "Pro\u010D n\xE1m to pos\xEDl\xE1\u0161?"
    m_Metadata:
      m_Items: []
  - m_Id: 16808075287
    m_Localized: "U\u017E nev\xEDm, \u010Demu m\xE1m v\u011B\u0159it a \u010Demu
      ne."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075288
    m_Localized: "V jak\xE9m sv\u011Bt\u011B \u017Eijeme?"
    m_Metadata:
      m_Items: []
  - m_Id: 16808075289
    m_Localized: "To je znepokojuj\xEDc\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075290
    m_Localized: "To je ale stra\u0161ideln\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 16808075291
    m_Localized: "U\u017E opravdu nev\xEDm, co si m\xE1m myslet."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075292
    m_Localized: "To m\u011B nep\u0159esv\u011Bd\u010Duje."
    m_Metadata:
      m_Items: []
  - m_Id: 16808075293
    m_Localized: "Nejsem si t\xEDm \xFApln\u011B jist\xFD..."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
