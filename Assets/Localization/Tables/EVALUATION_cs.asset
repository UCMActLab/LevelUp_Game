%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: EVALUATION_cs
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: cs
  m_SharedData: {fileID: 11400000, guid: 88394cb8bd95fea42af63c537ab05d35, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 808531789459456
    m_Localized: "Spr\xE1vn\u011B!"
    m_Metadata:
      m_Items: []
  - m_Id: 808531818819584
    m_Localized: "Nespr\xE1vn\u011B!"
    m_Metadata:
      m_Items: []
  - m_Id: 808531818819585
    m_Localized: "Zadejte svou odpov\u011B\u010F..."
    m_Metadata:
      m_Items: []
  - m_Id: 810621471404032
    m_Localized: "Tvoje odpov\u011B\u010F je spr\xE1vn\xE1!"
    m_Metadata:
      m_Items: []
  - m_Id: 810621475598336
    m_Localized: "Spr\xE1vn\xE1 odpov\u011B\u010F:"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285730893824
    m_Localized: Pravda
    m_Metadata:
      m_Items: []
  - m_Id: 7138285827362816
    m_Localized: 'Nepravda '
    m_Metadata:
      m_Items: []
  - m_Id: 7138285827362817
    m_Localized: "Titulky zpr\xE1v v\u017Edy p\u0159esn\u011B odr\xE1\u017Eej\xED
      obsah \u010Dl\xE1nku"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285827362818
    m_Localized: "Pouh\xFDm p\u0159e\u010Dten\xEDm titulku pozn\xE1m, zda je zpr\xE1va
      fale\u0161n\xE1 nebo ne"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285827362819
    m_Localized: "Pro posouzen\xED pravdivosti bychom m\u011Bli v\u017Edy p\u0159e\u010D\xEDst
      cel\xFD \u010Dl\xE1nek"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285827362820
    m_Localized: "Kdy\u017E zpr\xE1va p\u0159ijde od n\u011Bkoho bl\xEDzk\xE9ho,
      nemus\xEDm ji ov\u011B\u0159ovat"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285827362821
    m_Localized: "Siln\xFD a \xFAdern\xFD titulek znamen\xE1, \u017Ee je zpr\xE1va
      pravdiv\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557120
    m_Localized: "Kdy\u017E \u010Dtu cel\xFD \u010Dl\xE1nek, mohu podle pou\u017Eit\xE9ho
      jazyka posoudit jeho v\u011Brohodnost"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557121
    m_Localized: "Titulky nejsou dezinformace, proto\u017Ee jejich \xFA\u010Delem
      je informovat \u010Dten\xE1\u0159e"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557122
    m_Localized: "V\u0161echny zpr\xE1vy na internetu jsou fale\u0161n\xE9 a m\u016F\u017Eeme
      v\u011B\u0159it jen ti\u0161t\u011Bn\xE9mu tisku nebo televizi"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557123
    m_Localized: "Titulek je dobr\xFDm shrnut\xEDm zpr\xE1vy"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557124
    m_Localized: "Datum uveden\xE9 ve zpr\xE1v\u011B je d\u016Fle\u017Eit\xFDm ukazatelem
      jej\xED d\u016Fv\u011Bryhodnosti"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557125
    m_Localized: "Zpr\xE1va, kter\xE1 pou\u017E\xEDv\xE1 subjektivn\xED hodnocen\xED,
      nap\u0159\xEDklad ur\xE1\u017Eky, nebo siln\u011B odr\xE1\u017E\xED n\xE1zor
      autora, m\u016F\u017Ee b\xFDt m\xE9n\u011B spolehliv\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557126
    m_Localized: "V\u0161echny zpr\xE1vy zve\u0159ejn\u011Bn\xE9 na internetu jsou
      spolehliv\xE9, proto\u017Ee v\u0161e je p\u0159edem zkontrolov\xE1no"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557127
    m_Localized: "Kdy\u017E mi zpr\xE1vu po\u0161lou rodinn\xED p\u0159\xEDslu\u0161n\xEDci
      nebo p\u0159\xE1tel\xE9, nemus\xEDm zdroj ov\u011B\u0159ovat"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285831557128
    m_Localized: "Po\u0161le-li mi p\u0159\xEDtel nebo p\u0159\xEDbuzn\xFD zpr\xE1vu
      bez d\u016Fv\u011Bryhodn\xE9ho zdroje, m\u011Bl/a bych o n\xED pochybovat a
      ov\u011B\u0159it ji v ofici\xE1ln\xEDch zdroj\xEDch"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751424
    m_Localized: "Zdroj informac\xED, kter\xE9 mi p\u0159ijdou p\u0159es WhatsApp
      nebo SMS, nemus\xEDm ov\u011B\u0159ovat \u2013 tyto kan\xE1ly jsou v\u017Edy
      spolehliv\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751425
    m_Localized: "Kter\xFD z n\xE1sleduj\xEDc\xEDch zdroj\u016F je spolehliv\xFD
      pro informace o finan\u010Dn\xEDch z\xE1le\u017Eitostech?"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751426
    m_Localized: Moje banka
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751427
    m_Localized: Internet
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751428
    m_Localized: "Rodinn\xED p\u0159\xEDslu\u0161n\xEDci a/nebo p\u0159\xE1tel\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751429
    m_Localized: "Co bych m\u011Bl/a ud\u011Blat, ne\u017E zpr\xE1vu nasd\xEDl\xEDm?"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751430
    m_Localized: "Ov\u011B\u0159it zdroj"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751431
    m_Localized: "Pod\xEDvat se, kolikr\xE1t byla zpr\xE1va sd\xEDlena"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751432
    m_Localized: "Ujistit se, \u017Ee obsahuje obr\xE1zky"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751433
    m_Localized: "V\u0161echny informa\u010Dn\xED zdroje jsou stejn\u011B nespolehliv\xE9,
      ned\xE1 se v\u011B\u0159it \u017E\xE1dn\xE9mu"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751434
    m_Localized: "V\u011Bk novin\xE1\u0159e je d\u016Fle\u017Eit\xFDm faktorem p\u0159i
      hodnocen\xED zpr\xE1vy. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751435
    m_Localized: "Pohlav\xED novin\xE1\u0159e je d\u016Fle\u017Eit\xFDm faktorem,
      kter\xFD je t\u0159eba vz\xEDt v \xFAvahu p\u0159i hodnocen\xED zpr\xE1vy. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751436
    m_Localized: "Pokud mi zpr\xE1vu po\u0161le n\u011Bkdo bl\xEDzk\xFD, mohu v\u011B\u0159it
      jej\xED pravdivosti. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751437
    m_Localized: "Kter\xE9 z n\xE1sleduj\xEDc\xEDch zdroj\u016F jsou nejspolehliv\u011Bj\u0161\xED
      v ot\xE1zk\xE1ch zdrav\xED:"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751438
    m_Localized: "Ministerstvo zdravotnictv\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751439
    m_Localized: "Internetov\xFD blog"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751440
    m_Localized: "Koment\xE1\u0159 pod zpr\xE1vou"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751441
    m_Localized: "Zpr\xE1va v zn\xE1m\xFDch novin\xE1ch"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751442
    m_Localized: "Video na soci\xE1ln\xED s\xEDti"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751443
    m_Localized: "Pokud informace odpov\xEDd\xE1 m\xFDm p\u0159edchoz\xEDm n\xE1zor\u016Fm,
      nemus\xEDm ji ov\u011B\u0159ovat. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751444
    m_Localized: "Vyvol\xE1v\xE1-li informace siln\xE9 emoce (strach, vztek\u2026),
      znamen\xE1 to, \u017Ee je spolehliv\xE1. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751445
    m_Localized: "Uv\xE1d\xED-li zpr\xE1va ofici\xE1ln\xED statistiky a citace zdroj\u016F,
      je informace spolehliv\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751446
    m_Localized: "Pokud v\xEDm, \u017Ee informace poch\xE1z\xED ze spolehliv\xE9ho
      zdroje..."
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751447
    m_Localized: "Sd\xEDl\xED-li n\u011Bco mnoho lid\xED na internetu, je to dobr\xFD
      d\u016Fkaz, \u017Ee je to pravda. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751448
    m_Localized: "Kdy\u017E pochybuji o pravdivosti zpr\xE1vy, m\u011Bl/a bych\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751449
    m_Localized: "Pro\u010D se fale\u0161n\xE9 zpr\xE1vy sna\u017E\xED lidi rozzlobit?"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751450
    m_Localized: "Proto\u017Ee ti, kdo je vytv\xE1\u0159ej\xED, jsou zl\xED a jejich
      jedin\xFDm c\xEDlem je, abychom nen\xE1vid\u011Bli ostatn\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 7138285835751451
    m_Localized: "Proto\u017Ee kdy\u017E jsme rozhn\u011Bvan\xED, je m\xE9n\u011B
      pravd\u011Bpodobn\xE9, \u017Ee budeme informace kriticky posuzovat."
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140032
    m_Localized: "V\u0161echny zpr\xE1vy, pravdiv\xE9 i fale\u0161n\xE9, se n\xE1s
      sna\u017E\xED roz\u010D\xEDlit. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140033
    m_Localized: "P\u0159ijde-li mi informace p\u0159es SMS, nen\xED t\u0159eba ji
      ov\u011B\u0159ovat, proto\u017Ee tento kan\xE1l je v\u017Edy spolehliv\xFD. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140034
    m_Localized: "Ukazuje-li zpr\xE1va, \u017Ee m\xE1m v n\u011B\u010Dem pravdu,
      mus\xED b\xFDt pravdiv\xE1. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140035
    m_Localized: "Lojalita k ur\u010Dit\xE9mu m\xE9diu (nap\u0159. k novin\xE1m)
      je d\u016Fle\u017Eit\u011Bj\u0161\xED ne\u017E ov\u011B\u0159ov\xE1n\xED informac\xED
      v jin\xFDch zdroj\xEDch. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140036
    m_Localized: "Kdy\u017E si nejsme jist\xED, zda je zpr\xE1va skute\u010Dn\xE1
      nebo ne, m\u011Bli bychom:"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140037
    m_Localized: "Zeptat se um\u011Bl\xE9 inteligence, nap\u0159\xEDklad ChatGPT,
      zda je pravdiv\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140038
    m_Localized: "Pod\xEDvat se, kolikr\xE1t byla zpr\xE1va sd\xEDlena"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140039
    m_Localized: "Ov\u011B\u0159it ji v dal\u0161\xEDch m\xE9di\xEDch a dohledat
      p\u016Fvodn\xED zdroje informac\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140040
    m_Localized: "Obsahuje-li zpr\xE1va obr\xE1zky, znamen\xE1 to, \u017Ee je spolehliv\xE1. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140041
    m_Localized: "Mohu v\u011B\u0159it v\u0161emu, co je na internetu zve\u0159ejn\u011Bno,
      proto\u017Ee je to nejprve ov\u011B\u0159eno. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140042
    m_Localized: "Zpr\xE1vy s obr\xE1zky jsou spolehliv\xE9, proto\u017Ee obr\xE1zky
      jsou spolehliv\xFDm d\u016Fkazem informac\xED. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140043
    m_Localized: "Kdy\u017E pochybuji o pravdivosti zpr\xE1vy, m\u011Bl/a bych\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140044
    m_Localized: "Sd\xEDlet ji s ostatn\xEDmi, abych zjistil/a jejich n\xE1zor"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140045
    m_Localized: "T\xE9to informaci se vyhnout, proto\u017Ee m\u016F\u017Ee b\xFDt
      fale\u0161n\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140046
    m_Localized: "Ov\u011B\u0159it ji u fact-checker\u016F (nap\u0159. Demagog.cz,
      agentura AFP, atd.) nebo v ofici\xE1ln\xEDch zdroj\xEDch"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140047
    m_Localized: "Ka\u017Ed\xE9 m\xE9dium m\xE1 ur\u010Dit\xE1 politick\xE1 zaujet\xED,
      kter\xE1 ovliv\u0148uj\xED, jak pod\xE1v\xE1 zpr\xE1vy a jak podrobn\u011B
      jednotliv\xE9 p\u0159\xEDb\u011Bhy rozpracuje."
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140050
    m_Localized: "Zjist\xEDm-li, \u017Ee mi n\u011Bkdo bl\xEDzk\xFD poslal fale\u0161nou
      zpr\xE1vu, je lep\u0161\xED nic ne\u0159\xEDkat, ne\u017E vyj\xE1d\u0159it
      sv\u016Fj n\xE1zor. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140051
    m_Localized: "Sly\u0161\xEDm-li n\u011Bjakou zpr\xE1vu v m\xE9di\xEDch velmi
      \u010Dasto, mus\xED to b\xFDt proto, \u017Ee je pravdiv\xE1. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140052
    m_Localized: "Obecn\u011B plat\xED, \u017Ee p\u0159i hodnocen\xED rozhovor\u016F
      jsou spolehliv\u011Bj\u0161\xED ty, kter\xE9 vedou s:"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140053
    m_Localized: "Odborn\xEDky / v\u011Bdci v dan\xE9 oblasti"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140054
    m_Localized: "Anonymn\xED rozhovor"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285844140055
    m_Localized: "N\xE1zorov\xE9 \u010Dl\xE1nky"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334336
    m_Localized: "Kdy\u017E p\u0159ijde nouzov\xE9 varov\xE1n\xED, m\u011Bli bychom
      ho v\u017Edy okam\u017Eit\u011B sd\xEDlet bez v\xE1h\xE1n\xED. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334337
    m_Localized: "Nen\xED nutn\xE9 \u010D\xEDst zpr\xE1vy z r\u016Fzn\xFDch zdroj\u016F,
      pokud jsou ty na\u0161e spolehliv\xE9. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334338
    m_Localized: "N\u011Bkte\u0159\xED lid\xE9 maj\xED v\u011Bt\u0161\xED tendenci
      ne\u017E jin\xED pos\xEDlat fale\u0161n\xE9 zpr\xE1vy. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334339
    m_Localized: "Je d\u016Fle\u017Eit\xE9 zn\xE1t a sledovat redak\u010Dn\xED linii
      m\xE9di\xED, ze kter\xFDch \u010Derp\xE1m informace. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334340
    m_Localized: "M\xE1m-li jedno d\u016Fv\u011Bryhodn\xE9 m\xE9dium, nen\xED t\u0159eba
      \u010D\xEDst dal\u0161\xED. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334341
    m_Localized: "Popisuje-li zpr\xE1va situaci, kter\xE1 ve mn\u011B vyvol\xE1v\xE1
      velk\xFD vztek nebo nesouhlas, je d\u016Fle\u017Eit\xE9 se p\u0159ed ov\u011B\u0159ov\xE1n\xEDm
      informac\xED uklidnit. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334342
    m_Localized: "Je d\u016Fle\u017Eit\xE9 ov\u011B\u0159ovat zpr\xE1vy v jin\xFDch
      zdroj\xEDch, kter\xE9 nemaj\xED stejnou politickou ideologii."
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334343
    m_Localized: "Chceme-li posoudit d\u016Fv\u011Bryhodnost informa\u010Dn\xEDho
      zdroje, je d\u016Fle\u017Eit\xE9 v\u011Bd\u011Bt, kdo jsou jeho hlavn\xED finan\u010Dn\xED
      podporovatel\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334344
    m_Localized: "D\xEDv\xE1me-li se na videa nebo obr\xE1zky ke zpr\xE1v\u011B,
      je d\u016Fle\u017Eit\xE9 hledat vodoznaky \u010Di jin\xE9 zn\xE1mky toho, \u017Ee
      mohly b\xFDt vytvo\u0159eny pomoc\xED AI. "
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334345
    m_Localized: "D\u016Fvody, pro\u010D n\u011Bkdo m\u016F\u017Ee vytv\xE1\u0159et
      fale\u0161n\xE9 zpr\xE1vy, mohou b\xFDt nap\u0159\xEDklad:"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334346
    m_Localized: "Politick\xE9 z\xE1jmy"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334347
    m_Localized: "Ekonomick\xE9 z\xE1jmy"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334348
    m_Localized: "Podn\u011Bcov\xE1n\xED nen\xE1visti, jedn\xE9 z emoc\xED, kter\xE9
      se nejrychleji \u0161\xED\u0159\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334349
    m_Localized: "Komick\xE9 \u010Di posm\u011B\u0161n\xE9 z\xE1m\u011Bry"
    m_Metadata:
      m_Items: []
  - m_Id: 7138285848334350
    m_Localized: "Kv\u016Fli zkreslen\xE9mu vn\xEDm\xE1n\xED reality"
    m_Metadata:
      m_Items: []
  - m_Id: 28213551790002176
    m_Localized: "V\xFDborn\u011B! N\u011Bkdy mohou b\xFDt titulky zav\xE1d\u011Bj\xEDc\xED
      nebo senza\u010Dn\xED, aby n\xE1s p\u0159il\xE1kaly, a neodr\xE1\u017Eej\xED
      dob\u0159e obsah zpr\xE1vy."
    m_Metadata:
      m_Items: []
  - m_Id: 28213551991328768
    m_Localized: "Pozor! To je nepravda. N\u011Bkdy mohou b\xFDt titulky zav\xE1d\u011Bj\xEDc\xED
      nebo senza\u010Dn\xED, aby n\xE1s p\u0159il\xE1kaly, a neodr\xE1\u017Eej\xED
      dob\u0159e obsah zpr\xE1vy."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552003911680
    m_Localized: "Spr\xE1vn\u011B! Abychom si mohli b\xFDt jisti pravdivost\xED zpr\xE1vy,
      je d\u016Fle\u017Eit\xE9 ji v\u017Edy p\u0159e\u010D\xEDst celou."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552008105984
    m_Localized: "Oops! To je nepravda. Pamatujte, \u017Ee abyste si mohli b\xFDt
      jisti pravdivost\xED zpr\xE1vy, je d\u016Fle\u017Eit\xE9 si ji v\u017Edy p\u0159e\u010D\xEDst
      celou."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552016494592
    m_Localized: "Spr\xE1vn\u011B! P\u0159e\u010Dten\xED cel\xE9 zpr\xE1vy n\xE1m
      pom\xE1h\xE1 posoudit jej\xED pravdivost, proto\u017Ee si m\u016F\u017Eeme
      v\u0161imnout v\u011Bc\xED, jako jsou uveden\xE9 \xFAdaje nebo pou\u017Eit\xFD
      jazyk. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552020688896
    m_Localized: "Pozor, tohle je pravda! P\u0159e\u010Dten\xED cel\xE9 zpr\xE1vy
      n\xE1m pom\xE1h\xE1 posoudit jej\xED pravdivost, proto\u017Ee si m\u016F\u017Eeme
      v\u0161imnout v\u011Bc\xED, jako jsou uveden\xE9 \xFAdaje nebo pou\u017Eit\xFD
      jazyk. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552024883200
    m_Localized: "P\u0159esn\u011B tak. V\u017Edy je d\u016Fle\u017Eit\xE9 informace
      ov\u011B\u0159ovat. N\u011Bkdy n\xE1m lid\xE9 mohou sd\xEDlet dezinformace,
      ani\u017E by si to uv\u011Bdomovali."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552033271808
    m_Localized: "Bu\u010Fte opatrn\xED, toto je nepravdiv\xE1 informace. V\u017Edy
      je d\u016Fle\u017Eit\xE9 informace ov\u011B\u0159ovat. N\u011Bkdy n\xE1m lid\xE9
      mohou sd\xEDlet nepravdiv\xE9 informace, ani\u017E by si to uv\u011Bdomovali."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552033271809
    m_Localized: "Spr\xE1vn\u011B! Titulky mohou b\xFDt senza\u010Dn\xED, aby n\xE1s
      p\u0159il\xE1kaly, ale to neznamen\xE1, \u017Ee informace jsou pravdiv\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552045854720
    m_Localized: "M\xFDl\xED\u0161 se, to nen\xED pravda. Titulky mohou b\xFDt senza\u010Dn\xED,
      aby n\xE1s p\u0159il\xE1kaly, ale to neznamen\xE1, \u017Ee informace jsou pravdiv\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552045854721
    m_Localized: "V\xFDborn\u011B! Jazyk m\u016F\u017Ee b\xFDt dobr\xFDm ukazatelem.
      Dezinformace obvykle pou\u017E\xEDvaj\xED emotivn\u011Bj\u0161\xED, alarmuj\xEDc\xED
      nebo senza\u010Dn\xED jazyk."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552054243328
    m_Localized: "Bu\u010Fte opatrn\xED! To je pravda. Jazyk m\u016F\u017Ee b\xFDt
      dobr\xFDm ukazatelem. Dezinformace obvykle pou\u017E\xEDvaj\xED emotivn\u011Bj\u0161\xED,
      alarmuj\xEDc\xED nebo senza\u010Dn\xED jazyk. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552066826240
    m_Localized: "Spr\xE1vn\u011B! Nadpisy mohou b\xFDt tak\xE9 manipulov\xE1ny tak,
      aby se n\xE1m zd\xE1ly atraktivn\u011Bj\u0161\xED, a proto mohou b\xFDt zav\xE1d\u011Bj\xEDc\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552071020544
    m_Localized: "To je nepravda. Pamatujte, \u017Ee nadpisy mohou b\xFDt tak\xE9
      manipulov\xE1ny tak, aby se n\xE1m zd\xE1ly atraktivn\u011Bj\u0161\xED, a proto
      mohou b\xFDt zav\xE1d\u011Bj\xEDc\xED. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552075214848
    m_Localized: "P\u0159esn\u011B tak! Na internetu tak\xE9 existuj\xED spolehliv\xE9
      zdroje. Nen\xED t\u0159eba se v\u0161emu ned\u016Fv\u011B\u0159ovat. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552079409152
    m_Localized: "Chyba! Na internetu tak\xE9 existuj\xED spolehliv\xE9 zdroje. Nen\xED
      t\u0159eba se v\u0161emu ned\u016Fv\u011B\u0159ovat. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552083603456
    m_Localized: "V\xFDborn\u011B! N\u011Bkdy mohou b\xFDt titulky zav\xE1d\u011Bj\xEDc\xED
      nebo senza\u010Dn\xED, aby n\xE1s p\u0159il\xE1kaly, a nemus\xED b\xFDt dobr\xFDm
      shrnut\xEDm zpr\xE1vy. Je t\u0159eba si p\u0159e\u010D\xEDst celou zpr\xE1vu."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552091992064
    m_Localized: "Pozor! To je nepravda. N\u011Bkdy mohou b\xFDt titulky zav\xE1d\u011Bj\xEDc\xED
      nebo senza\u010Dn\xED, aby n\xE1s p\u0159il\xE1kaly, a nemus\xED b\xFDt dobr\xFDm
      shrnut\xEDm zpr\xE1vy. Je t\u0159eba si p\u0159e\u010D\xEDst celou zpr\xE1vu."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552096186368
    m_Localized: "P\u0159esn\u011B tak! Data zve\u0159ejn\u011Bn\xED n\xE1m mohou
      pomoci zjistit, zda se jedn\xE1 o aktu\xE1ln\xED zpr\xE1vu, nebo o informaci
      vytr\u017Eenou z kontextu. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552100380672
    m_Localized: "Oops! To je nepravda. Data zve\u0159ejn\u011Bn\xED n\xE1m mohou
      pomoci zjistit, zda se jedn\xE1 o aktu\xE1ln\xED zpr\xE1vu, nebo o informaci
      vytr\u017Eenou z kontextu. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552108769280
    m_Localized: "To je pravda. Spolehliv\xE9 zpr\xE1vy se obvykle sna\u017E\xED
      o objektivitu a neutralitu."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552112963584
    m_Localized: "To je nepravda. Spolehliv\xE9 zpr\xE1vy se obvykle sna\u017E\xED
      o objektivitu a neutralitu."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552117157888
    m_Localized: "Spr\xE1vn\u011B!! NE v\u0161echno, co se publikuje na internetu,
      je pravda. Je velmi d\u016Fle\u017Eit\xE9 vyu\u017E\xEDvat spolehliv\xE9 a
      ofici\xE1ln\xED zdroje pro ov\u011B\u0159en\xED informac\xED. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552121352192
    m_Localized: "M\xFDl\xED\u0161 se, to nen\xED pravda. NE v\u0161echno, co se
      publikuje na internetu, je pravdiv\xE9. Je velmi d\u016Fle\u017Eit\xE9 vyu\u017E\xEDvat
      spolehliv\xE9 a ofici\xE1ln\xED zdroje, aby bylo mo\u017En\xE9 informace ov\u011B\u0159it."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552129740800
    m_Localized: "P\u0159esn\u011B tak. V\u017Edy je d\u016Fle\u017Eit\xE9 informace
      ov\u011B\u0159ovat. N\u011Bkdy n\xE1m lid\xE9 mohou sd\xEDlet dezinformace,
      ani\u017E by si to uv\u011Bdomovali."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552133935104
    m_Localized: "Bu\u010Fte opatrn\xED, toto je nepravdiv\xE1 informace. V\u017Edy
      je d\u016Fle\u017Eit\xE9 informace ov\u011B\u0159ovat. N\u011Bkdy n\xE1m lid\xE9
      mohou sd\xEDlet nepravdiv\xE9 informace, ani\u017E by si to uv\u011Bdomovali."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552133935105
    m_Localized: "V\xFDborn\u011B! Pokud je zdroj zpr\xE1vy nezn\xE1m\xFD, je V\u017DDY
      d\u016Fle\u017Eit\xE9 informace ov\u011B\u0159it. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552146518016
    m_Localized: "Bu\u010Fte opatrn\xED! To je pravda. Pokud je zdroj zpr\xE1vy nezn\xE1m\xFD,
      je V\u017DDY d\u016Fle\u017Eit\xE9 informace ov\u011B\u0159it. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552150712320
    m_Localized: "P\u0159esn\u011B tak. I kdy\u017E informace poch\xE1z\xED z d\u016Fv\u011Bryhodn\xE9ho
      zdroje, je v\u017Edy d\u016Fle\u017Eit\xE9 si ji ov\u011B\u0159it. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552154906624
    m_Localized: "Chyba. I kdy\u017E informace poch\xE1z\xED z rodinn\xE9ho zdroje,
      je v\u017Edy d\u016Fle\u017Eit\xE9 ji ov\u011B\u0159it."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552163295232
    m_Localized: "V\xFDborn\u011B! Kdy\u017E hled\xE1me finan\u010Dn\xED informace,
      je v\u017Edy nejlep\u0161\xED obr\xE1tit se na nej\xFA\u0159edn\u011Bj\u0161\xED
      zdroj, tedy banku. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552167489536
    m_Localized: "Bu\u010Fte opatrn\xED! Pamatujte, \u017Ee p\u0159i hled\xE1n\xED
      finan\u010Dn\xEDch informac\xED je v\u017Edy nejlep\u0161\xED obr\xE1tit se
      na nej\xFA\u0159edn\u011Bj\u0161\xED zdroj, tedy banku. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552171683840
    m_Localized: "Spr\xE1vn\u011B! V\u017Edy je d\u016Fle\u017Eit\xE9 ov\u011B\u0159it
      zdroj. Pokud je zdroj nezn\xE1m\xFD, rad\u011Bji si informace ov\u011B\u0159te,
      ne\u017E je budete sd\xEDlet. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552175878144
    m_Localized: "Chyba! V\u017Edy je d\u016Fle\u017Eit\xE9 ov\u011B\u0159it zdroj.
      Pokud je zdroj nezn\xE1m\xFD, je lep\u0161\xED informace p\u0159ed sd\xEDlen\xEDm
      ov\u011B\u0159it. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552188461056
    m_Localized: "V\xFDborn\u011B! To je nepravda. Existuj\xED spolehliv\xE9 zdroje
      a zdroje, kter\xE9 spolehliv\xE9 nejsou. V\u017Edy si ov\u011B\u0159ujte zdroj
      informac\xED. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552192655360
    m_Localized: "Pozor! To je nepravda. Existuj\xED spolehliv\xE9 zdroje a zdroje,
      kter\xE9 spolehliv\xE9 nejsou. V\u017Edy si ov\u011B\u0159te zdroj. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552196849664
    m_Localized: "Spr\xE1vn\u011B, toto nen\xED dobr\xFD ukazatel pravdivosti. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552201043968
    m_Localized: "Nespr\xE1vn\xE9, toto nen\xED dobr\xFD ukazatel pravdivosti. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552205238272
    m_Localized: "Spr\xE1vn\u011B, toto nen\xED dobr\xFD ukazatel pravdivosti. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552209432576
    m_Localized: "Nespr\xE1vn\xE9, toto nen\xED dobr\xFD ukazatel pravdivosti. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552217821184
    m_Localized: "P\u0159esn\u011B tak. V\u017Edy je d\u016Fle\u017Eit\xE9 informace
      ov\u011B\u0159ovat. N\u011Bkdy n\xE1m lid\xE9 mohou sd\xEDlet dezinformace,
      ani\u017E by si to uv\u011Bdomovali."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552217821185
    m_Localized: "Bu\u010Fte opatrn\xED, toto je nepravdiv\xE1 informace. V\u017Edy
      je d\u016Fle\u017Eit\xE9 informace ov\u011B\u0159ovat. N\u011Bkdy n\xE1m lid\xE9
      mohou sd\xEDlet nepravdiv\xE9 informace, ani\u017E by si to uv\u011Bdomovali."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552226209792
    m_Localized: "M\xE1\u0161 pravdu! N\u011Bkdy obsah potvrzuje m\xE9 p\u0159edchoz\xED
      p\u0159edstavy, ale to neznamen\xE1, \u017Ee je to pravda. V\u017Edy je d\u016Fle\u017Eit\xE9
      informace ov\u011B\u0159ovat."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552234598400
    m_Localized: "Spletl ses! N\u011Bkdy obsah potvrzuje m\xE9 p\u0159edchoz\xED
      p\u0159edstavy, ale to neznamen\xE1, \u017Ee je to pravda. V\u017Edy je d\u016Fle\u017Eit\xE9
      informace ov\u011B\u0159ovat."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552238792704
    m_Localized: "Spr\xE1vn\u011B! Dezinformace \u010Dasto vyu\u017E\xEDvaj\xED pr\xE1v\u011B
      tyto emoce, aby n\xE1s p\u0159il\xE1kaly."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552242987008
    m_Localized: "Nepravda! Dezinformace \u010Dasto vyu\u017E\xEDvaj\xED pr\xE1v\u011B
      tyto emoce, aby n\xE1s p\u0159il\xE1kaly."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552247181312
    m_Localized: "Ano! Pokud zpr\xE1va obsahuje ofici\xE1ln\xED zdroje nebo statistiky,
      je to obvykle zn\xE1mkou jej\xED pravdivosti."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552251375616
    m_Localized: "Pozor! To je pravda. Pokud zpr\xE1va obsahuje ofici\xE1ln\xED zdroje
      nebo statistiky, je to obvykle zn\xE1mkou pravdivosti."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552276541440
    m_Localized: "Spr\xE1vn\u011B. Ov\u011B\u0159ov\xE1n\xED informac\xED je v\u017Edy
      u\u017Eite\u010Dn\xE9. V tomto p\u0159\xEDpad\u011B n\xE1m to m\u016F\u017Ee
      pomoci z\xEDskat v\xEDce \xFAhl\u016F pohledu. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552284930048
    m_Localized: "Nespr\xE1vn\xE9. Ov\u011B\u0159ov\xE1n\xED informac\xED je v\u017Edy
      u\u017Eite\u010Dn\xE9. V tomto p\u0159\xEDpad\u011B n\xE1m to m\u016F\u017Ee
      pomoci z\xEDskat v\xEDce \xFAhl\u016F pohledu. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552289124352
    m_Localized: "Spr\xE1vn\u011B! Viralita nen\xED synonymem pravdivosti. Mnoho
      dezinformac\xED je na soci\xE1ln\xEDch s\xEDt\xEDch velmi popul\xE1rn\xEDch. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552289124353
    m_Localized: "Omyl! Viralita nen\xED synonymem pravdivosti. Mnoho dezinformac\xED
      je na soci\xE1ln\xEDch s\xEDt\xEDch velmi popul\xE1rn\xEDch. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552293318656
    m_Localized: "Sd\xEDlet ji s ostatn\xEDmi, abych zjistil/a jejich n\xE1zor"
    m_Metadata:
      m_Items: []
  - m_Id: 28213552293318657
    m_Localized: "T\xE9to informaci se rad\u011Bji vyhnout, proto\u017Ee m\u016F\u017Ee
      b\xFDt fale\u0161n\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 28213552293318658
    m_Localized: "Obr\xE1tit se na fact-checkingovou slu\u017Ebu (nap\u0159. demagog)
      nebo na ofici\xE1ln\xED zdroj"
    m_Metadata:
      m_Items: []
  - m_Id: 28213552297512960
    m_Localized: "V\xFDborn\u011B! Obr\xE1tit se na ov\u011B\u0159ovatele a ofici\xE1ln\xED
      zdroje je v\u017Edy nejlep\u0161\xED volbou. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552301707264
    m_Localized: "Chyba! Pamatujte, \u017Ee nejlep\u0161\xED volbou je v\u017Edy
      obr\xE1tit se na ov\u011B\u0159ovatele a ofici\xE1ln\xED zdroje. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552305901568
    m_Localized: "P\u0159esn\u011B tak! Psychologie prok\xE1zala, \u017Ee kdy\u017E
      jsme rozzloben\xED, jsme n\xE1chyln\u011Bj\u0161\xED k ovliv\u0148ov\xE1n\xED,
      p\u0159esv\u011Bd\u010Dov\xE1n\xED a dezinformac\xEDm. Pokud v\xE1s n\u011Bjak\xE1
      zpr\xE1va velmi rozzlob\xED, je dobr\xE9 si ji p\u0159ed sd\xEDlen\xEDm ov\u011B\u0159it. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552310095872
    m_Localized: "\u0160patn\u011B! Spr\xE1vn\xE1 odpov\u011B\u010F byla: \"Proto\u017Ee
      kdy\u017E jsme rozzloben\xED, je pravd\u011Bpodobn\u011Bj\u0161\xED, \u017Ee
      nebudeme kriti\u010Dt\xED k informac\xEDm.\u201C Psychologie prok\xE1zala,
      \u017Ee kdy\u017E jsme rozzloben\xED, jsme n\xE1chyln\u011Bj\u0161\xED k ovliv\u0148ov\xE1n\xED,
      p\u0159esv\u011Bd\u010Dov\xE1n\xED a dezinformac\xEDm. Pokud v\xE1s n\u011Bjak\xE1
      zpr\xE1va velmi rozzlob\xED, je dobr\xE9 ji p\u0159ed sd\xEDlen\xEDm ov\u011B\u0159it. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552314290176
    m_Localized: "Spr\xE1vn\u011B! Podvody a dezinformace mohou p\u0159ich\xE1zet
      tak\xE9 prost\u0159ednictv\xEDm SMS. Tomuto jevu se \u0159\xEDk\xE1 smishing."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552322678784
    m_Localized: "Chyba! Podvody a dezinformace mohou p\u0159ich\xE1zet tak\xE9 prost\u0159ednictv\xEDm
      SMS. Tomuto jevu se \u0159\xEDk\xE1 smishing."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552331067392
    m_Localized: "M\xE1\u0161 pravdu! N\u011Bkdy obsah potvrzuje m\xE9 p\u0159edchoz\xED
      p\u0159edstavy, ale to neznamen\xE1, \u017Ee je to pravda. V\u017Edy je d\u016Fle\u017Eit\xE9
      informace ov\u011B\u0159ovat."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552335261696
    m_Localized: "Spletl ses! N\u011Bkdy obsah potvrzuje m\xE9 p\u0159edchoz\xED
      p\u0159edstavy, ale to neznamen\xE1, \u017Ee je to pravda. V\u017Edy je d\u016Fle\u017Eit\xE9
      informace ov\u011B\u0159ovat."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552339456000
    m_Localized: "Skv\u011Bl\xE9! I kdy\u017E m\xE1me sv\xE9 obl\xEDben\xE9 m\xE9dium,
      je v\u017Edy dobr\xE9 porovnat informace a pod\xEDvat se na jin\xE9 \xFAhly
      pohledu. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552343650304
    m_Localized: "Pozor! I kdy\u017E m\xE1me obl\xEDben\xFD komunika\u010Dn\xED prost\u0159edek,
      je v\u017Edy dobr\xE9 porovnat informace a pod\xEDvat se na jin\xE9 \xFAhly
      pohledu. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552347844608
    m_Localized: "V\xFDborn\u011B! Ov\u011B\u0159ov\xE1n\xED informac\xED u spolehliv\xFDch
      zdroj\u016F je v\u017Edy dobr\xE1 volba. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552352038912
    m_Localized: "Spletl ses! Pamatuj, \u017Ee ov\u011B\u0159ov\xE1n\xED informac\xED
      u spolehliv\xFDch zdroj\u016F je v\u017Edy dobr\xE1 volba. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552356233216
    m_Localized: "Spr\xE1vn\u011B, to nen\xED dobr\xFD ukazatel pravdivosti. Dezinformace
      toti\u017E n\u011Bkdy pou\u017E\xEDvaj\xED manipulovan\xE9 nebo vytr\u017Een\xE9
      z kontextu obr\xE1zky, aby p\u016Fsobily d\u016Fv\u011Bryhodn\u011Bji."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552364621824
    m_Localized: "Nespr\xE1vn\xE9, toto nen\xED dobr\xFD ukazatel pravdivosti. Dezinformace
      toti\u017E n\u011Bkdy pou\u017E\xEDvaj\xED manipulovan\xE9 nebo vytr\u017Een\xE9
      z kontextu obr\xE1zky, aby p\u016Fsobily d\u016Fv\u011Bryhodn\u011Bji."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552368816128
    m_Localized: "Spr\xE1vn\u011B!! NE v\u0161echno, co se publikuje na internetu,
      je pravda. Je velmi d\u016Fle\u017Eit\xE9 vyu\u017E\xEDvat spolehliv\xE9 a
      ofici\xE1ln\xED zdroje pro ov\u011B\u0159en\xED informac\xED. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552373010432
    m_Localized: "M\xFDl\xED\u0161 se, to nen\xED pravda. NE v\u0161echno, co se
      publikuje na internetu, je pravdiv\xE9. Je velmi d\u016Fle\u017Eit\xE9 vyu\u017E\xEDvat
      spolehliv\xE9 a ofici\xE1ln\xED zdroje, aby bylo mo\u017En\xE9 informace ov\u011B\u0159it."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552381399040
    m_Localized: "Spr\xE1vn\u011B, to nen\xED dobr\xFD ukazatel pravdivosti. Dezinformace
      toti\u017E n\u011Bkdy pou\u017E\xEDvaj\xED manipulovan\xE9 nebo vytr\u017Een\xE9
      z kontextu obr\xE1zky, aby p\u016Fsobily d\u016Fv\u011Bryhodn\u011Bji."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552385593344
    m_Localized: "Nespr\xE1vn\xE9, toto nen\xED dobr\xFD ukazatel pravdivosti. Dezinformace
      toti\u017E n\u011Bkdy pou\u017E\xEDvaj\xED manipulovan\xE9 nebo vytr\u017Een\xE9
      z kontextu obr\xE1zky, aby p\u016Fsobily d\u016Fv\u011Bryhodn\u011Bji."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552389787648
    m_Localized: "V\xFDborn\u011B! Obr\xE1tit se na ov\u011B\u0159ovatele fakt\u016F
      a ofici\xE1ln\xED zdroje je v\u017Edy nejlep\u0161\xED volbou. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552393981952
    m_Localized: "Chyba! Nejlep\u0161\xED volbou je v\u017Edy obr\xE1tit se na ov\u011B\u0159ovatele
      fakt\u016F a ofici\xE1ln\xED zdroje. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552398176256
    m_Localized: "Dob\u0159e. I kdy\u017E je to n\u011Bkdy slo\u017Eit\xE9, vyvracen\xED
      dezinformac\xED je v\u017Edy dobr\xFD n\xE1pad, jak zastavit \u0161\xED\u0159en\xED
      f\xE1m. K tomu se sna\u017Ete pou\u017E\xEDvat spolehliv\xE9 zdroje, kter\xE9
      tyto informace vyvracej\xED!"
    m_Metadata:
      m_Items: []
  - m_Id: 28213552406564864
    m_Localized: "Selhal jsi. Pamatuj si, \u017Ee i kdy\u017E je to n\u011Bkdy slo\u017Eit\xE9,
      vyvracen\xED dezinformac\xED je v\u017Edy dobr\xFD n\xE1pad, jak zastavit \u0161\xED\u0159en\xED
      f\xE1m. K tomu se sna\u017E pou\u017E\xEDvat spolehliv\xE9 zdroje, kter\xE9
      tyto informace vyvracej\xED!"
    m_Metadata:
      m_Items: []
  - m_Id: 28213552410759168
    m_Localized: "Spr\xE1vn\u011B! Odborn\xE9 a ofici\xE1ln\xED zdroje jsou obvykle
      nejspolehliv\u011Bj\u0161\xED. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552414953472
    m_Localized: "\u0160patn\u011B! Pamatujte, \u017Ee odborn\xE9 a ofici\xE1ln\xED
      zdroje jsou obvykle nejspolehliv\u011Bj\u0161\xED. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552431730688
    m_Localized: "M\xE1\u0161 pravdu. Je d\u016Fle\u017Eit\xE9 zachovat klid a ov\u011B\u0159it,
      zda je v\xFDstraha ofici\xE1ln\xED. \u0160\xED\u0159en\xED nouzov\xE9 v\xFDstrahy
      bez p\u0159edchoz\xEDho ov\u011B\u0159en\xED m\u016F\u017Ee vyvolat chaos. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552435924992
    m_Localized: "Selhal jsi. Pamatuj, \u017Ee je d\u016Fle\u017Eit\xE9 zachovat
      klid a ov\u011B\u0159it, zda je v\xFDstraha ofici\xE1ln\xED. \u0160\xED\u0159en\xED
      nouzov\xE9 v\xFDstrahy bez p\u0159edchoz\xEDho ov\u011B\u0159en\xED m\u016F\u017Ee
      vyvolat chaos. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552440119296
    m_Localized: "Skv\u011Bl\xE9! Porovn\xE1vat informace, aby se zjistily jin\xE9
      \xFAhly pohledu, je v\u017Edy dobr\xFD n\xE1pad. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552444313600
    m_Localized: "Pozor! Porovnat informace a pod\xEDvat se na jin\xE9 \xFAhly pohledu
      je v\u017Edy dobr\xFD n\xE1pad. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552452702208
    m_Localized: "Ano, je to tak. Ur\u010Dit\xE9 vlastnosti n\xE1s mohou \u010Dinit
      n\xE1chyln\u011Bj\u0161\xEDmi k tomu, abychom podlehli dezinformac\xEDm. Proto
      je d\u016Fle\u017Eit\xE9 p\u0159edch\xE1zet tomu a dodr\u017Eovat bezpe\u010Dnostn\xED
      opat\u0159en\xED, jako je \u010Dten\xED cel\xFDch zpr\xE1v nebo ov\u011B\u0159ov\xE1n\xED
      informac\xED. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552461090816
    m_Localized: "Pozor, je to pravda. N\u011Bkter\xE9 vlastnosti n\xE1s mohou \u010Dinit
      n\xE1chyln\u011Bj\u0161\xEDmi k tomu, abychom podlehli dezinformac\xEDm. Proto
      je d\u016Fle\u017Eit\xE9 p\u0159edch\xE1zet tomu a dodr\u017Eovat bezpe\u010Dnostn\xED
      opat\u0159en\xED, jako je \u010Dten\xED cel\xFDch zpr\xE1v nebo ov\u011B\u0159ov\xE1n\xED
      informac\xED. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552461090817
    m_Localized: "Dob\u0159e. I kdy\u017E se jedn\xE1 o spolehliv\xE9 m\xE9dium,
      identifikace jeho redak\u010Dn\xED linie n\xE1m m\u016F\u017Ee pomoci odhalit
      zaujatost informac\xED. \u010Cten\xED m\xE9di\xED s r\u016Fzn\xFDmi redak\u010Dn\xEDmi
      liniemi pom\xE1h\xE1 utv\xE1\u0159et neutr\xE1ln\u011Bj\u0161\xED, objektivn\u011Bj\u0161\xED
      a pluralitn\u011Bj\u0161\xED n\xE1zor. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552469479424
    m_Localized: "Pozor. I kdy\u017E se jedn\xE1 o spolehliv\xE9 m\xE9dium, identifikace
      jeho redak\u010Dn\xED linie n\xE1m m\u016F\u017Ee pomoci odhalit zaujatost
      informac\xED. \u010Cten\xED m\xE9di\xED s r\u016Fzn\xFDmi redak\u010Dn\xEDmi
      liniemi pom\xE1h\xE1 utvo\u0159it si neutr\xE1ln\u011Bj\u0161\xED, objektivn\u011Bj\u0161\xED
      a pluralitn\u011Bj\u0161\xED n\xE1zor. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552473673728
    m_Localized: "Skv\u011Bl\xE9! I kdy\u017E m\xE1me sv\xE9 obl\xEDben\xE9 m\xE9dium,
      je v\u017Edy dobr\xE9 porovnat informace a pod\xEDvat se na jin\xE9 \xFAhly
      pohledu. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552477868032
    m_Localized: "Pozor! I kdy\u017E m\xE1me sv\xE9 obl\xEDben\xE9 m\xE9dium, je
      v\u017Edy dobr\xE9 porovnat informace a pod\xEDvat se na jin\xE9 \xFAhly pohledu. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552486256640
    m_Localized: "P\u0159esn\u011B tak! Psychologie prok\xE1zala, \u017Ee kdy\u017E
      jsme rozzloben\xED, jsme n\xE1chyln\u011Bj\u0161\xED k p\u0159esv\u011Bd\u010Dov\xE1n\xED,
      dezinformac\xEDm a hled\xE1n\xED obsahu, kter\xFD n\xE1s podpo\u0159\xED. Pokud
      v\xE1s n\u011Bjak\xE1 zpr\xE1va velmi rozzlob\xED, je dobr\xE9 se uklidnit
      a ov\u011B\u0159it si ji, ne\u017E ji budete sd\xEDlet. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552490450944
    m_Localized: "Nespr\xE1vn\xE9! Psychologie prok\xE1zala, \u017Ee kdy\u017E jsme
      rozzloben\xED, jsme n\xE1chyln\u011Bj\u0161\xED k p\u0159esv\u011Bd\u010Dov\xE1n\xED,
      dezinformac\xEDm a hled\xE1n\xED obsahu, kter\xFD n\xE1s podpo\u0159\xED. Pokud
      v\xE1s n\u011Bjak\xE1 zpr\xE1va velmi rozzlob\xED, je dobr\xE9 se uklidnit
      a ov\u011B\u0159it si ji, ne\u017E ji budete sd\xEDlet. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552498839552
    m_Localized: "Dob\u0159e. I kdy\u017E \u010Dteme spolehliv\xE1 m\xE9dia, je dobr\xE9
      \u010D\xEDst m\xE9dia s r\u016Fzn\xFDmi ideologiemi, proto\u017Ee n\xE1m to
      pom\xE1h\xE1 vytvo\u0159it si neutr\xE1ln\u011Bj\u0161\xED, objektivn\u011Bj\u0161\xED
      a pluralitn\u011Bj\u0161\xED n\xE1zor. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552503033856
    m_Localized: "Pozor. I kdy\u017E \u010Dteme spolehliv\xE1 m\xE9dia, je dobr\xE9
      \u010D\xEDst m\xE9dia s odli\u0161n\xFDmi ideologiemi, proto\u017Ee n\xE1m
      to pom\xE1h\xE1 vytvo\u0159it si neutr\xE1ln\u011Bj\u0161\xED, objektivn\u011Bj\u0161\xED
      a pluralitn\u011Bj\u0161\xED n\xE1zor. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552507228160
    m_Localized: "Spr\xE1vn\u011B. N\u011Bkdy m\u016F\u017Ee financov\xE1n\xED m\xE9di\xED
      ovlivnit informace, kter\xE9 \u0161\xED\u0159\xED. Znalost t\xE9to skute\u010Dnosti
      n\xE1s m\u016F\u017Ee chr\xE1nit p\u0159ed manipulac\xED. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552511422464
    m_Localized: "Selhal jsi, to je pravda. N\u011Bkdy m\u016F\u017Ee financov\xE1n\xED
      m\xE9di\xED ovlivnit informace, kter\xE9 \u0161\xED\u0159\xED. Znalost tohoto
      faktu n\xE1s m\u016F\u017Ee chr\xE1nit p\u0159ed manipulac\xED. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552515616768
    m_Localized: "Ano! Um\u011Bl\xE1 inteligence umo\u017E\u0148uje vytv\xE1\u0159et
      videa a obr\xE1zky, kter\xE9 vypadaj\xED jako skute\u010Dn\xE9, ale nejsou.
      Hled\xE1n\xED v\u011Bc\xED, jako jsou chyby v obli\u010Dej\xEDch, probl\xE9my
      s pozad\xEDm, nesrovnalosti b\u011Bhem videa nebo vodoznaky, n\xE1m m\u016F\u017Ee
      pomoci identifikovat um\u011Blou inteligenci. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552519811072
    m_Localized: "Bu\u010Fte opatrn\xED! Um\u011Bl\xE1 inteligence umo\u017E\u0148uje
      vytv\xE1\u0159et videa a obr\xE1zky, kter\xE9 vypadaj\xED jako skute\u010Dn\xE9,
      ale nejsou. Hled\xE1n\xED v\u011Bc\xED, jako jsou chyby v obli\u010Dej\xEDch,
      probl\xE9my s pozad\xEDm, nesrovnalosti ve videu nebo vodoznaky, n\xE1m m\u016F\u017Ee
      pomoci um\u011Blou inteligenci identifikovat. "
    m_Metadata:
      m_Items: []
  - m_Id: 28213552528199680
    m_Localized: "Skv\u011Bl\xE9! V\u0161echny mo\u017Enosti byly spr\xE1vn\xE9.
      Existuje mnoho d\u016Fvod\u016F, pro\u010D lid\xE9 vytv\xE1\u0159ej\xED a \u0161\xED\u0159\xED
      dezinformace. Proto je d\u016Fle\u017Eit\xE9 b\xFDt ostra\u017Eit\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552532393984
    m_Localized: "Spletl jste se! V\u0161echny mo\u017Enosti byly spr\xE1vn\xE9.
      Existuje mnoho d\u016Fvod\u016F, pro\u010D lid\xE9 vytv\xE1\u0159ej\xED a \u0161\xED\u0159\xED
      dezinformace. Proto je d\u016Fle\u017Eit\xE9 b\xFDt ostra\u017Eit\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552259764224
    m_Localized: "Nen\xED nutn\xE9 porovn\xE1vat s jin\xFDmi zdroji."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552268152832
    m_Localized: "Porovn\xE1n\xED informac\xED je dobr\xFD n\xE1pad, aby se zjistily
      jin\xE9 \xFAhly pohledu."
    m_Metadata:
      m_Items: []
  - m_Id: 28213552272347136
    m_Localized: "U\u017E neexistuj\xED \u017E\xE1dn\xE9 spolehliv\xE9 zdroje, proto\u017Ee
      v\u0161ichni novin\xE1\u0159i l\u017Eou."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
