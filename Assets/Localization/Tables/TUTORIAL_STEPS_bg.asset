  m_TableData:
  - m_Id: 11980431360
    m_Localized: "\u0414\u043E\u0431\u0440\u0435 \u0434\u043E\u0448\u043B\u0438 \u0432
      Level Up!"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597184
    m_Localized: "\u0412 \u0442\u0430\u0437\u0438 \u0441\u0435\u043A\u0446\u0438\u044F
      \u0449\u0435 \u0432\u0438 \u0434\u0430\u0434\u0435\u043C \u0418\u041D\u0421\u0422\u0420\u0423\u041A\u0426\u0418\u0418
      \u043A\u0430\u043A \u0434\u0430 \u0438\u0433\u0440\u0430\u0435\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597185
    m_Localized: "\u0429\u0435 \u0432\u0438 \u043F\u043E\u043A\u0430\u0436\u0435\u043C
      \u0437\u043E\u043D\u0430\u0442\u0430 \u0437\u0430 \u0441\u0442\u0430\u0442\u0438\u0438.
      \u0422\u0430\u043C \u0449\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u0434\u0430
      \u043D\u0430\u0443\u0447\u0438\u0442\u0435 \u043D\u043E\u0432\u0438\u0442\u0435
      \u043D\u043E\u0432\u0438\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597186
    m_Localized: "\u0422\u0443\u043A \u043C\u043E\u0436\u0435\u0442\u0435 \u0434\u0430
      \u0432\u0438\u0434\u0438\u0442\u0435 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E
      \u0432\u0435\u0441\u0442\u043D\u0438\u043A\u0430\u0440\u0441\u043A\u0438 \u0441\u0442\u0430\u0442\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597187
    m_Localized: "\u041C\u043E\u0436\u0435\u0442\u0435 \u0434\u0430 \u0432\u0438\u0434\u0438\u0442\u0435
      \u0437\u0430\u0433\u043B\u0430\u0432\u0438\u0435\u0442\u043E \u0438 \u0441\u0432\u044A\u0440\u0437\u0430\u043D\u0430
      \u0441 \u043D\u0435\u0433\u043E \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597188
    m_Localized: "\u0421\u044A\u0449\u043E \u0442\u0430\u043A\u0430, \u0441 \u043F\u043E\u043C\u043E\u0449\u0442\u0430
      \u043D\u0430 \u043F\u0440\u044A\u0441\u0442\u0430 \u0441\u0438, \u043C\u043E\u0436\u0435\u0442\u0435
      \u0434\u0430 \u0441\u0435 \u0434\u0432\u0438\u0436\u0438\u0442\u0435 \u043F\u043E
      \u0442\u043E\u0437\u0438 \u0435\u043A\u0440\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597189
    m_Localized: "\u0410\u043A\u043E \u0433\u043E \u043F\u043B\u044A\u0437\u043D\u0435\u0442\u0435
      \u043D\u0430\u0433\u043E\u0440\u0435, \u0449\u0435 \u0432\u0438\u0434\u0438\u0442\u0435
      \u043E\u0449\u0435 \u0441\u0442\u0430\u0442\u0438\u0438 \u0432 \u0434\u043E\u043B\u043D\u0430\u0442\u0430
      \u0447\u0430\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597190
    m_Localized: "\u0410\u043A\u043E \u043F\u043B\u044A\u0437\u043D\u0435\u0442\u0435
      \u043F\u0440\u044A\u0441\u0442\u0430 \u0441\u0438 \u043D\u0430\u0434\u043E\u043B\u0443,
      \u0449\u0435 \u0441\u0435 \u0432\u044A\u0440\u043D\u0435\u0442\u0435 \u043A\u044A\u043C
      \u043F\u0440\u0435\u0434\u0438\u0448\u043D\u0438\u0442\u0435 \u0441\u0442\u0430\u0442\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597191
    m_Localized: "\u041E\u043F\u0438\u0442\u0430\u0439\u0442\u0435 \u0433\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597192
    m_Localized: "\u0421\u0435\u0433\u0430 \u0449\u0435 \u0432\u0438 \u043F\u043E\u043A\u0430\u0436\u0435\u043C
      \u0431\u0443\u0442\u043E\u043D\u0438\u0442\u0435 \u043D\u0430 \u0441\u0442\u0430\u0442\u0438\u0438\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597193
    m_Localized: "\u0417\u0430 \u043C\u043E\u043C\u0435\u043D\u0442\u0430 \u043D\u0435
      \u043C\u043E\u0436\u0435\u0442\u0435 \u0434\u0430 \u0433\u0438 \u043D\u0430\u0442\u0438\u0441\u043A\u0430\u0442\u0435,
      \u043D\u043E \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u0449\u0435
      \u0432\u0438 \u0433\u0438 \u043F\u043E\u043A\u0430\u0437\u0432\u0430\u043C\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597194
    m_Localized: "\u041F\u044A\u0440\u0432\u0438\u044F\u0442 \u043E\u0442 \u0442\u044F\u0445
      \u0435 \u0442\u043E\u0437\u0438 \u0432 \u0433\u043E\u0440\u043D\u0438\u044F
      \u0434\u0435\u0441\u0435\u043D \u044A\u0433\u044A\u043B, \u0431\u0443\u0442\u043E\u043D\u044A\u0442
      \u201E\u0421\u043A\u043E\u0447\u0438\u201C"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597195
    m_Localized: "\u0421 \u0442\u043E\u0437\u0438 \u0431\u0443\u0442\u043E\u043D
      \u043D\u0438 \u043A\u0430\u0437\u0432\u0430\u0442\u0435, \u0447\u0435 \u0441\u0442\u0430\u0442\u0438\u044F\u0442\u0430
      \u041D\u0415 \u0432\u0438 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0432\u0430,
      \u0442\u0430\u043A\u0430 \u0447\u0435 \u0442\u044F \u0449\u0435 \u0438\u0437\u0447\u0435\u0437\u043D\u0435
      \u043E\u0442\u0442\u0443\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597196
    m_Localized: "\u041E\u043F\u0438\u0442\u0430\u0439\u0442\u0435 \u0434\u0430 \u0433\u043E
      \u043D\u0430\u0442\u0438\u0441\u043D\u0435\u0442\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597197
    m_Localized: "\u0421\u043B\u0435\u0434\u0432\u0430\u0449\u0438\u044F\u0442 \u0435
      \u0431\u0443\u0442\u043E\u043D\u044A\u0442 \u201E\u0427\u0415\u0422\u0418\u201C"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597198
    m_Localized: "\u041F\u0440\u0438 \u043D\u0430\u0442\u0438\u0441\u043A\u0430\u043D\u0435
      \u043D\u0430 \u0442\u043E\u0437\u0438 \u0431\u0443\u0442\u043E\u043D \u0449\u0435
      \u0441\u0435 \u043F\u043E\u043A\u0430\u0436\u0435 \u043F\u043E\u0432\u0435\u0447\u0435
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u0437\u0430 \u0430\u0440\u0442\u0438\u043A\u0443\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597199
    m_Localized: "\u041C\u043E\u0436\u0435\u0442\u0435 \u0434\u0430 \u044F \u043F\u0440\u043E\u0447\u0435\u0442\u0435\u0442\u0435,
      \u0437\u0430 \u0434\u0430 \u0441\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0438\u0440\u0430\u0442\u0435
      \u0434\u043E\u0431\u0440\u0435 \u043A\u0430\u043A\u0432\u043E \u043A\u0430\u0437\u0432\u0430
      \u0438 \u043E\u0442\u043A\u044A\u0434\u0435 \u0447\u0435\u0440\u043F\u0438
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430 \u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597200
    m_Localized: "\u041E\u043F\u0438\u0442\u0430\u0439\u0442\u0435 \u0433\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597201
    m_Localized: "\u0421\u0442\u0440\u0430\u0445\u043E\u0442\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 12005597202
    m_Localized: "\u0421\u0435\u0433\u0430, \u0441\u043B\u0435\u0434 \u043A\u0430\u0442\u043E
      \u043F\u0440\u043E\u0447\u0435\u0442\u043E\u0445\u0442\u0435 \u0441\u0442\u0430\u0442\u0438\u044F\u0442\u0430,
      \u0432\u0435\u0447\u0435 \u0437\u043D\u0430\u0435\u0442\u0435 \u0437\u0430
      \u043A\u0430\u043A\u0432\u043E \u0441\u0442\u0430\u0432\u0430 \u0432\u044A\u043F\u0440\u043E\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597203
    m_Localized: "\u0422\u043E\u0433\u0430\u0432\u0430 \u0449\u0435 \u043E\u043F\u0438\u0442\u0430\u043C\u0435
      \u0434\u0430 \u0433\u043E \u0441\u043F\u043E\u0434\u0435\u043B\u0438\u043C
      \u0441 \u0431\u043B\u0438\u0437\u043A\u0438\u0442\u0435 \u0442\u0438 \u0433\u0440\u0443\u043F\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 12005597204
    m_Localized: "\u0422\u0435\u0437\u0438 \u0433\u0440\u0443\u043F\u0438 \u041D\u0415
      \u0421\u0410 \u0420\u0415\u0410\u041B\u041D\u0418."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791488
    m_Localized: "\u0422\u0435 \u0441\u0430 \u0447\u0430\u0441\u0442 \u043E\u0442
      \u0438\u0433\u0440\u0430\u0442\u0430, \u0432 \u043A\u043E\u044F\u0442\u043E
      \u0441\u0435 \u043E\u043F\u0438\u0442\u0432\u0430\u043C\u0435 \u0434\u0430
      \u0441\u0438\u043C\u0443\u043B\u0438\u0440\u0430\u043C\u0435 \u0438\u0437\u043F\u043E\u043B\u0437\u0432\u0430\u043D\u0435\u0442\u043E
      \u043D\u0430 \u0441\u043E\u0446\u0438\u0430\u043B\u043D\u0438 \u043C\u0440\u0435\u0436\u0438
      \u043A\u0430\u0442\u043E WhatsApp."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791489
    m_Localized: "\u0422\u0440\u0435\u0442\u0438\u044F\u0442 \u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u0435\u043D
      \u0431\u0443\u0442\u043E\u043D, \u043A\u043E\u0439\u0442\u043E \u0438\u043C\u0430\u043C\u0435
      \u043D\u0430 \u0440\u0430\u0437\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435,
      \u0435 \u201E\u0421\u043F\u043E\u0434\u0435\u043B\u0438\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791490
    m_Localized: "\u0421 \u0442\u043E\u0437\u0438 \u0431\u0443\u0442\u043E\u043D
      \u0449\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u0434\u0430 \u0441\u043F\u043E\u0434\u0435\u043B\u044F\u0442\u0435
      \u0441\u0442\u0430\u0442\u0438\u0438\u0442\u0435, \u043A\u043E\u0438\u0442\u043E
      \u0441\u043C\u044F\u0442\u0430\u0442\u0435 \u0437\u0430 \u0432\u0430\u0436\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791491
    m_Localized: "\u0412\u0430\u0436\u043D\u043E \u0435 \u0434\u0430 \u0441\u043F\u043E\u0434\u0435\u043B\u044F\u0448
      \u0442\u0435\u0437\u0438, \u043A\u043E\u0438\u0442\u043E \u0442\u0435 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u044F\u0432\u0430\u0442
      \u0438\u043B\u0438 \u0442\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0432\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791492
    m_Localized: "\u0417\u0430 \u0434\u0430 \u0433\u043E \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u0435,
      \u0442\u0440\u044F\u0431\u0432\u0430 \u0434\u0430 \u043D\u0430\u0442\u0438\u0441\u043D\u0435\u0442\u0435
      \u0431\u0443\u0442\u043E\u043D\u0430 \u201E\u0421\u043F\u043E\u0434\u0435\u043B\u0438\u201C,
      \u043A\u0430\u043A\u0442\u043E \u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791493
    m_Localized: "\u041E\u043F\u0438\u0442\u0430\u0439\u0442\u0435 \u0433\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 12009791494
    m_Localized: "\u0421\u0442\u0440\u0430\u0445\u043E\u0442\u043D\u043E! \u0412\u0435\u0447\u0435
      \u0441\u0435 \u0441\u043F\u0440\u0430\u0432\u044F\u0448 \u043F\u0435\u0440\u0444\u0435\u043A\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791495
    m_Localized: "\u0412\u0438\u0434\u044F\u0445\u0442\u0435 \u043B\u0438 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u0438\u0442\u0435
      \u0444\u0443\u043D\u043A\u0446\u0438\u0438, \u043A\u043E\u0438\u0442\u043E
      \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u043C\u0435:"
    m_Metadata:
      m_Items: []
  - m_Id: 12009791496
    m_Localized: "\u0427\u0415\u0422\u0418 \u0441\u0442\u0430\u0442\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 12009791497
    m_Localized: "\u041F\u0420\u0415\u041C\u0418\u041D\u0415\u0422\u0415 \u0441\u0442\u0430\u0442\u0438\u0438,
      \u043A\u043E\u0438\u0442\u043E \u041D\u0415 \u0432\u0438 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0432\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 12009791498
    m_Localized: "\u0438 \u0421\u041F\u041E\u0414\u0415\u041B\u042F\u0419\u0422\u0415
      \u0441\u0442\u0430\u0442\u0438\u0438\u0442\u0435 \u0441 \u0431\u043B\u0438\u0437\u043A\u0438\u0442\u0435
      \u0441\u0438 \u043A\u0440\u044A\u0433\u043E\u0432\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 12009791499
    m_Localized: "\u041F\u0440\u0435\u0434\u0438 \u0434\u0430 \u0441\u0435 \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u043C,
      \u043D\u0435\u043A\u0430 \u0434\u0430 \u043F\u0440\u0435\u0433\u043B\u0435\u0434\u0430\u043C\u0435
      \u0431\u0443\u0442\u043E\u043D\u0438\u0442\u0435 \u0437\u0430 \u043C\u043E\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791500
    m_Localized: "\u041A\u043E\u0433\u0430\u0442\u043E \u043D\u0430\u0442\u0438\u0441\u043D\u0435\u0442\u0435
      \u043F\u0440\u0430\u0432\u0438\u043B\u043D\u0438\u044F, \u0431\u0443\u0442\u043E\u043D\u044A\u0442
      \u201E\u0421\u041B\u0415\u0414\u0412\u0410\u0429\u201C \u043E\u0442\u0434\u043E\u043B\u0443
      \u0449\u0435 \u0441\u0435 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0430
      \u043E\u0442\u043D\u043E\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791501
    m_Localized: "\u041A\u043E\u0433\u0430\u0442\u043E \u043D\u0430\u0442\u0438\u0441\u043D\u0435\u0442\u0435
      \u043F\u0440\u0430\u0432\u0438\u043B\u043D\u0438\u044F, \u0431\u0443\u0442\u043E\u043D\u044A\u0442
      \u201E\u0421\u041B\u0415\u0414\u0412\u0410\u0429\u201C \u043E\u0442\u0434\u043E\u043B\u0443
      \u0449\u0435 \u0441\u0435 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0430
      \u043E\u0442\u043D\u043E\u0432\u043E. \u041D\u0430\u0442\u0438\u0441\u043D\u0435\u0442\u0435
      \u0431\u0443\u0442\u043E\u043D\u0430, \u0437\u0430 \u0434\u0430 \u041F\u0420\u041E\u041F\u0423\u0421\u041D\u0415\u0422\u0415
      \u0430\u0440\u0442\u0438\u043A\u0443\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 12009791502
    m_Localized: "\u0411\u0440\u0430\u0432\u043E!"
    m_Metadata:
