  - m_Id: 17847521283
    m_Localized: "\u041D\u0423\u041B\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 9763233173504
    m_Localized: "\u041F\u0440\u043E\u0447\u0435\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 9763237367808
    m_Localized: "Odm\xEDtnout"
    m_Metadata:
      m_Items: []
  - m_Id: 9763237367809
    m_Localized: "\u041E\u0442\u0445\u0432\u044A\u0440\u043B\u044F\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721479
    m_Localized: "\u0417\u0434\u0440\u0430\u0432\u0435\u0439! \u0422\u043E\u0432\u0430
      \u0441\u044A\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u0431\u0438 \u0431\u0438\u043B\u043E
      \u0440\u0435\u0430\u043A\u0446\u0438\u044F \u043D\u0430 \u0441\u0442\u0430\u0442\u0438\u044F\u0442\u0430,
      \u043A\u043E\u044F\u0442\u043E \u0438\u0437\u043F\u0440\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721480
    m_Localized: "\u0410\u0437 \u0441\u044A\u043C \u0442\u0432\u043E\u0439 \u043F\u043E\u0437\u043D\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721481
    m_Localized: "\u0412\u0441\u044A\u0449\u043D\u043E\u0441\u0442 \u043D\u0435 \u0441\u044A\u0449\u0435\u0441\u0442\u0432\u0443\u0432\u0430\u043C
      \u0438 \u043D\u044F\u043C\u0430\u043C \u043D\u0438\u0449\u043E \u043E\u0431\u0449\u043E
      \u0441 \u043D\u0438\u043A\u043E\u0433\u043E \u0441\u044A\u0441 \u0441\u044A\u0449\u043E\u0442\u043E
      \u0438\u043C\u0435 \u0432 \u0440\u0435\u0430\u043B\u043D\u0438\u044F \u0436\u0438\u0432\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721482
    m_Localized: "\u0414\u043E\u0431\u0440\u043E \u0443\u0442\u0440\u043E! \u0410\u0437
      \u0441\u044A\u0449\u043E \u0441\u044A\u043C \u0442\u0432\u043E\u0439 \u043F\u043E\u0437\u043D\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721483
    m_Localized: "\u0422\u0443\u043A \u0449\u0435 \u0442\u0438 \u043A\u0430\u0437\u0432\u0430\u043C\u0435
      \u043A\u0430\u043A\u0432\u043E \u043C\u0438\u0441\u043B\u0438\u043C \u0437\u0430
      \u0441\u0442\u0430\u0442\u0438\u0438\u0442\u0435, \u043A\u043E\u0438\u0442\u043E
      \u043D\u0438 \u0438\u0437\u043F\u0440\u0430\u0449\u0430\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721484
    m_Localized: "\u0417\u0430\u0441\u0435\u0433\u0430 \u0449\u0435 \u0441\u0435
      \u0432\u044A\u0440\u043D\u0435\u043C \u043D\u0430 \u0433\u043B\u0430\u0432\u043D\u0430\u0442\u0430
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430, \u043A\u044A\u0434\u0435\u0442\u043E
      \u0431\u0435\u0448\u0435 \u043F\u0440\u0435\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721485
    m_Localized: "\u0417\u0430 \u0434\u0430 \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u0448
      \u0442\u043E\u0432\u0430, \u0442\u0440\u044F\u0431\u0432\u0430 \u0434\u0430
      \u043D\u0430\u0442\u0438\u0441\u043D\u0435\u0448 \u0431\u0443\u0442\u043E\u043D\u0430
      \u201EOK\u201C \u0432 \u0434\u043E\u043B\u043D\u0430\u0442\u0430 \u0447\u0430\u0441\u0442
      \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721486
    m_Localized: "\u041E\u043F\u0438\u0442\u0430\u0439 \u0433\u043E! (\u0412\u0435\u0447\u0435
      \u0441\u0435 \u043F\u043E\u044F\u0432\u0438)"
    m_Metadata:
      m_Items: []
  - m_Id: 414618628841472
    m_Localized: "\u0418\u0417\u0422\u041E\u0427\u041D\u0418\u041A"
    m_Metadata:
      m_Items: []
  - m_Id: 414618674978816
    m_Localized: "\u0421\u041B\u0415\u0414\u0412\u0410\u0429\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 414618674978817
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E \u043B\u0435\u043A\u0443\u0432\u0430
      \u0434\u0438\u0430\u0431\u0435\u0442\u0430 \u0437\u0430 17 \u0447\u0430\u0441\u0430!
      \u0417\u0430\u0434 \u043C\u0435\u0434\u0438\u043A\u0430\u043C\u0435\u043D\u0442\u044A\u0442
      \u0441\u0442\u043E\u0440\u0438 \u0434\u043E\u043A\u0442\u043E\u0440 \u0410\u043D\u0433\u0435\u043B
      \u041A\u0443\u043D\u0447\u0435\u0432, \u043A\u043E\u0439\u0442\u043E \u0435
      \u043E\u0442\u043A\u0440\u0438\u043B \u0440\u0435\u0448\u0435\u043D\u0438\u0435\u0442\u043E
      \u0438 \u0435 \u0441\u043F\u0430\u0441\u0438\u043B \u0436\u0438\u0432\u043E\u0442\u0430
      \u043D\u0430 \u043C\u0430\u0439\u043A\u0430 \u0441\u0438 \u0441 \u043F\u0440\u043E\u0441\u0442
      \u0434\u043E\u043C\u0430\u0448\u0435\u043D \u043C\u0435\u0442\u043E\u0434,
      \u0431\u0435\u0437 \u0438\u043D\u0441\u0443\u043B\u0438\u043D, \u0431\u0435\u0437
      \u0445\u0430\u043F\u0447\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 414618674978818
    m_Localized: "\u041B\u0435\u043A \u0437\u0430 \u0434\u0438\u0430\u0431\u0435\u0442!
      \u041D\u044F\u043C\u0430 \u0434\u0430 \u043F\u043E\u0432\u044F\u0440\u0432\u0430\u0442\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 426683309416448
    m_Localized: "\u0421\u0415\u041C\u0415\u0419\u0421\u0422\u0412\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 426683309416449
    m_Localized: "\u041F\u0420\u0418\u042F\u0422\u0415\u041B\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 426683309416450
    m_Localized: "\u0421\u042A\u0421\u0415\u0414\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 427584111697920
    m_Localized: "\u0412\u0438\u0436\u0434\u0430\u043B \u043B\u0438 \u0441\u0438
      \u0442\u043E\u0432\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 1427335212883968
    m_Localized: "\u0412\u0435\u0447\u0435 \u0433\u043E \u0432\u0438\u0434\u044F\u0445,
      \u043D\u043E \u0432\u0441\u0435 \u043F\u0430\u043A \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1427335279992832
    m_Localized: "\u0418\u0432\u0430\u043D \u0432\u0435\u0447\u0435 \u043C\u0438
      \u0433\u043E \u0431\u0435\u0448\u0435 \u0438\u0437\u043F\u0440\u0430\u0442\u0438\u043B.
      \u041C\u0438\u0441\u043B\u044F, \u0447\u0435 \u0449\u0435 \u043F\u043E\u0440\u044A\u0447\u0430\u043C\u0435
      \u043D\u0435\u0449\u043E, \u0434\u0430 \u0432\u0438\u0434\u0438\u043C \u0434\u0430\u043B\u0438
      \u0449\u0435 \u0441\u0435 \u043F\u043E\u043B\u0443\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1427335279992833
    m_Localized: "\u041D\u0435, \u043C\u043E\u043B\u044F \u0442\u0435, \u043D\u0435
      \u0441\u043F\u043E\u0434\u0435\u043B\u044F\u0439 \u0442\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1427335279992834
    m_Localized: "\u0422\u043E\u0432\u0430 \u0435 \u0438\u0437\u043C\u0430\u043C\u0430,
      \u043C\u043E\u043B\u044F, \u043D\u0435 \u0441\u0435 \u043F\u043E\u0434\u0434\u0430\u0432\u0430\u0439.
      \u0418\u0437\u043C\u0430\u043C\u043D\u0438\u0446\u0438\u0442\u0435 \u0438\u0441\u043A\u0430\u0442
      \u0441\u0430\u043C\u043E \u0434\u0430 \u0441\u0442\u0438\u0433\u043D\u0430\u0442
      \u0434\u043E \u0442\u0432\u043E\u0438\u0442\u0435 \u043B\u0438\u0447\u043D\u0438
      \u0434\u0430\u043D\u043D\u0438. \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u0441\u0442\u0432\u043E\u0442\u043E
      \u043D\u0435 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430 \u0442\u0430\u043A\u0438\u0432\u0430
      \u0441\u0443\u0431\u0441\u0438\u0434\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1427335279992835
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0437\u0430
      \u0441\u043F\u043E\u0434\u0435\u043B\u044F\u043D\u0435\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1427335279992836
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F! \u0418\u043C\u0430\u043C\u0435
      \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u0438 \u0442\u043E\u0437\u0438
      \u043C\u0435\u0441\u0435\u0446, \u0442\u0435\u0437\u0438 \u043F\u0430\u0440\u0438
      \u0449\u0435 \u043D\u0438 \u0431\u044A\u0434\u0430\u0442 \u043C\u043D\u043E\u0433\u043E
      \u043F\u043E\u043B\u0435\u0437\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1449960068800512
    m_Localized: "\u0421\u043F\u043E\u0434\u0435\u043B\u0438\u043B \u0441\u0438 \u043D\u0435\u0432\u044F\u0440\u043D\u0430
      \u043D\u043E\u0432\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1449960140103680
    m_Localized: "\u041D\u0435 \u0437\u0430\u0431\u0435\u043B\u044F\u0437\u0430 \u043B\u0438
      \u043A\u0430\u043A \u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 1449960140103681
    m_Localized: "\u0422\u0440\u044F\u0431\u0432\u0430 \u0434\u0430 \u043F\u0440\u043E\u0447\u0435\u0442\u0435\u0448
      \u0441\u0442\u0430\u0442\u0438\u0438\u0442\u0435, \u043F\u0440\u0435\u0434\u0438
      \u0434\u0430 \u0433\u0438 \u0438\u0437\u043F\u0440\u0430\u0442\u0438\u0442\u0435;
      \u043C\u043E\u0436\u0435 \u0434\u0430 \u0438\u043C\u0430 \u0441\u0435\u0440\u0438\u043E\u0437\u043D\u0438
      \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u044F \u0430\u043A\u043E
      \u0438\u0437\u043F\u0440\u0430\u0442\u0438\u0448 \u043D\u0435\u0449\u043E \u043D\u0435\u0432\u044F\u0440\u043D\u043E
      \u0438\u043B\u0438 \u043F\u043E\u0434\u0432\u0435\u0436\u0434\u0430\u0449\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1449960140103682
    m_Localized: "\u0421\u043F\u043E\u0434\u0435\u043B\u0438\u043B \u0441\u0438 \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u0430
      \u043D\u043E\u0432\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1449960140103683
    m_Localized: "\u041D\u0435 \u0441\u0438 \u044F \u043F\u0440\u043E\u0447\u0435\u043B,
      \u043D\u043E \u0441\u0438 \u0438\u043C\u0430\u043B \u043A\u044A\u0441\u043C\u0435\u0442,
      \u0447\u0435 \u0435 \u0431\u0438\u043B\u0430 \u0432\u044F\u0440\u043D\u0430.
      \u0422\u0440\u044F\u0431\u0432\u0430 \u0434\u0430 \u0447\u0435\u0442\u0435\u0448,
      \u043F\u0440\u0435\u0434\u0438 \u0434\u0430 \u0441\u043F\u043E\u0434\u0435\u043B\u044F\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 1470815863758848
    m_Localized: "\u0414\u043E\u0431\u0440\u0435 \u0434\u043E\u0448\u043B\u0438 \u0432\u044A\u0432
      VERI!"
    m_Metadata:
      m_Items: []
  - m_Id: 1470815909896192
    m_Localized: "\u0418\u0437\u0431\u0435\u0440\u0435\u0442\u0435 \u0435\u0437\u0438\u043A\u0430 "
    m_Metadata:
      m_Items: []
  - m_Id: 1470815909896193
    m_Localized: "\u0422\u043E\u0432\u0430 \u0435 VERI!"
    m_Metadata:
      m_Items: []
  - m_Id: 1470815914090496
    m_Localized: "\u0412 \u0438\u0433\u0440\u0430\u0442\u0430 \u0449\u0435 \u0441\u0435
      \u0441\u0431\u043B\u044A\u0441\u043A\u0430\u0448 \u0441 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u0438
      \u043D\u043E\u0432\u0438\u043D\u0438, \u0442\u043E\u0447\u043D\u043E \u043A\u0430\u043A\u0442\u043E
      \u0438 \u0432 \u0440\u0435\u0430\u043B\u043D\u043E\u0441\u0442\u0442\u0430.
      \u041C\u043E\u0436\u0435\u0448 \u0434\u0430 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0430\u0448
      \u0441 \u0442\u044F\u0445, \u043A\u0430\u0442\u043E \u0433\u0438 \u043F\u0440\u0435\u043F\u0440\u0430\u0449\u0430\u0448
      \u043D\u0430 \u043F\u043E\u0437\u043D\u0430\u0442\u0438 (\u0438\u043B\u0438
      \u043D\u0435!) \u0438 \u0434\u0430 \u0432\u0438\u0434\u0438\u0448 \u043A\u0430\u043A
      \u0440\u0435\u0430\u0433\u0438\u0440\u0430\u0442 \u043D\u0430 \u0442\u043E\u0432\u0430,
      \u043A\u043E\u0435\u0442\u043E \u0438\u043C \u0438\u0437\u043F\u0440\u0430\u0449\u0430\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 1470815914090497
    m_Localized: "\u041D\u0430\u043F\u0440\u0435\u0434!"
    m_Metadata:
      m_Items: []
  - m_Id: 1470815914090498
    m_Localized: "\u0417\u0430\u0441\u0435\u0433\u043D\u0430 \u043B\u0438 \u0432\u0438
      \u043F\u0440\u0435\u043A\u044A\u0441\u0432\u0430\u043D\u0435\u0442\u043E \u043D\u0430
      \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u0437\u0430\u0445\u0440\u0430\u043D\u0432\u0430\u043D\u0435\u0442\u043E?
      \u0422\u0443\u043A \u0432\u0438 \u043E\u0431\u044F\u0441\u043D\u044F\u0432\u0430\u043C\u0435
      \u043A\u0430\u043A \u043C\u043E\u0436\u0435\u0442\u0435 \u0434\u0430 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435
      \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1470815914090499
    m_Localized: "\u0422\u043E\u043A\u0443-\u0449\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0445\u0442\u0435
      \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1470815914090500
    m_Localized: "\u041E\u0442\u0432\u043E\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1805145240690688
    m_Localized: "\u0422\u0432\u043E\u0435\u0442\u043E \u0432\u043B\u0438\u044F\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438567223296
    m_Localized: "\u0422\u043E\u0432\u0430 \u0435 \u0432\u0441\u0438\u0447\u043A\u043E,
      \u0441\u0442\u0438\u0433\u043D\u0430 \u0434\u043E \u043A\u0440\u0430\u044F
      \u043D\u0430 \u0438\u0433\u0440\u0430\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438634332160
    m_Localized: "\u0414\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C \u043A\u0430\u043A\u0432\u043E
      \u0441\u043C\u0435 \u043D\u0430\u0443\u0447\u0438\u043B\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438634332161
    m_Localized: "\u041A\u0430\u043A\u0432\u043E \u043D\u0430\u0443\u0447\u0438\u0445\u043C\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438634332162
    m_Localized: "\u0421 \u043D\u043E\u0432\u0438\u0442\u0435 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438
      \u043D\u043E\u0432\u0438\u043D\u0438\u0442\u0435 \u0441\u0430 \u043D\u0430
      \u0440\u0430\u0437\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043D\u0430
      \u0432\u0441\u0435\u043A\u0438. \u0412\u0430\u0436\u043D\u043E \u0435 \u0434\u0430
      \u0441\u0435 \u043D\u0430\u0443\u0447\u0438\u043C \u0434\u0430 \u0433\u0438
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u043C\u0435 \u0438 \u0434\u0430
      \u043D\u0435 \u0441\u0435 \u043F\u043E\u0434\u0434\u0430\u0432\u0430\u043C\u0435
      \u043D\u0430 \u0434\u0435\u0437\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526464
    m_Localized: "\u041A\u0430\u043A\u0432\u043E \u043D\u0430\u0443\u0447\u0438\u0445\u043C\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526465
    m_Localized: "\u0415\u0442\u043E \u0437\u0430\u0449\u043E \u0442\u0440\u044F\u0431\u0432\u0430
      \u0434\u0430 \u0438\u0437\u0431\u044F\u0433\u0432\u0430\u043C\u0435 \u0434\u0430
      \u0441\u0435 \u0437\u0430\u0434\u043E\u0432\u043E\u043B\u044F\u0432\u0430\u043C\u0435
      \u0441\u0430\u043C\u043E \u0441 \u043D\u0435\u0447\u0438\u044F \u0442\u0438\u0442\u043B\u0430,
      \u043A\u043E\u043B\u043A\u043E\u0442\u043E \u0438 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u0435\u043B\u043D\u0430
      \u0434\u0430 \u0435 \u0442\u044F..."
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526466
    m_Localized: "\u0414\u0430 \u0441\u043C\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0438\u0440\u0430\u043D\u0438
      \u0435 \u043D\u0430\u0439-\u0432\u0430\u0436\u043D\u043E\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526467
    m_Localized: "\u0422\u0440\u044F\u0431\u0432\u0430 \u0434\u0430 \u0427\u0415\u0422\u0415\u041C
      \u043D\u043E\u0432\u0438\u043D\u0438\u0442\u0435, \u043F\u0440\u0435\u0434\u0438
      \u0434\u0430 \u0433\u0438 \u0441\u043F\u043E\u0434\u0435\u043B\u044F\u043C\u0435
      \u0441 \u043D\u044F\u043A\u043E\u0433\u043E, \u0437\u0430\u0449\u043E\u0442\u043E
      \u043D\u0435 \u0437\u043D\u0430\u0435\u043C \u043A\u0430\u043A\u0432\u0430
      \u0432\u0440\u0435\u0434\u0430 \u043C\u043E\u0436\u0435\u043C \u0434\u0430
      \u043F\u0440\u0438\u0447\u0438\u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526468
    m_Localized: "\u0412\u0438\u0436 \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526469
    m_Localized: "\u0412\u0430\u0436\u043D\u043E \u0435 \u0434\u0430 \u0432\u0438\u0434\u0438\u043C
      \u041A\u041E\u0419 \u043F\u0438\u0448\u0435 \u0441\u0442\u0430\u0442\u0438\u044F\u0442\u0430,
      \u0437\u0430 \u0434\u0430 \u0437\u043D\u0430\u0435\u043C \u0434\u0430\u043B\u0438
      \u043C\u043E\u0436\u0435\u043C \u0434\u0430 \u0441\u0435 \u0434\u043E\u0432\u0435\u0440\u0438\u043C
      \u043D\u0430 \u0441\u044A\u0434\u044A\u0440\u0436\u0430\u043D\u0438\u0435\u0442\u043E
      \u0439 \u0438\u043B\u0438 \u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526470
    m_Localized: "\u0414\u0430 \u043E\u0431\u044A\u0440\u043D\u0435\u043C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u043A\u0430\u043A \u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2909438638526471
    m_Localized: "\u041C\u043D\u043E\u0433\u043E \u0435 \u0432\u0430\u0436\u043D\u043E
      \u0441\u044A\u0449\u043E \u0434\u0430 \u043E\u0431\u044A\u0440\u043D\u0435\u043C
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043D\u0430 \u043D\u0430\u0447\u0438\u043D\u0430,
      \u043F\u043E \u043A\u043E\u0439\u0442\u043E \u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u043D
      \u0442\u0435\u043A\u0441\u0442\u044A\u0442. \u041D\u0435\u0432\u0435\u0440\u043D\u0438\u0442\u0435
      \u0441\u0442\u0430\u0442\u0438\u0438 \u0447\u0435\u0441\u0442\u043E \u043F\u043E\u0434\u0431\u0443\u0436\u0434\u0430\u0442
      \u043E\u043C\u0440\u0430\u0437\u0430 \u0438\u043B\u0438 \u043D\u0435 \u0446\u0438\u0442\u0438\u0440\u0430\u0442
      \u043D\u0430\u0438\u0441\u0442\u0438\u043D\u0430 \u043D\u0430\u0434\u0435\u0436\u0434\u043D\u0438
      \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u0446\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2919120602107904
    m_Localized: "\u041D\u0430\u0434\u044F\u0432\u0430\u043C\u0435 \u0441\u0435,
      \u0447\u0435 \u0442\u0438 \u0435 \u0445\u0430\u0440\u0435\u0441\u0430\u043B\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2919120602107905
    m_Localized: "\u041D\u0430\u0442\u0438\u0441\u043D\u0435\u0442\u0435 \u0431\u0443\u0442\u043E\u043D\u0430,
      \u0437\u0430 \u0434\u0430 \u0441\u0435 \u0432\u044A\u0440\u043D\u0435\u0442\u0435
      \u043A\u044A\u043C \u043D\u0430\u0447\u0430\u043B\u043D\u043E\u0442\u043E \u043C\u0435\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 8072467420995584
    m_Localized: "\u041D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 9056519614861312
    m_Localized: "\u0420\u0430\u0437\u0431\u0440\u0430\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 9056519644221440
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758147280896
    m_Localized: "\u0414\u043E\u0431\u0440\u0435 \u0434\u043E\u0448\u043B\u0438 \u0432
      \u041E.\u0410.\u0414.\u0421"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778368
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0432\u0438,
      \u0447\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u0430\u0442\u0435 \u0432
      \u043D\u0430\u0448\u0430\u0442\u0430 \u043E\u0431\u0443\u0447\u0438\u0442\u0435\u043B\u043D\u0430
      \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u0430 \u0437\u0430 \u0431\u0440\u0438\u0433\u0430\u0434\u0430\u0442\u0430
      \u041E.\u0410.\u0414.\u0421 (\u041E\u0431\u0435\u0434\u0438\u043D\u0435\u043D\u0430
      \u0410\u043D\u0442\u0438\u2011\u0414\u0435\u0437\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438\u043E\u043D\u043D\u0430
      \u0421\u0438\u043B\u0430)"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778369
    m_Localized: "\u041E.\u0410.\u0414.\u0421 \u0441\u0435 \u043D\u0443\u0436\u0434\u0430\u0435
      \u043E\u0442 \u0432\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778370
    m_Localized: "\u041D\u0430\u0448\u0430\u0442\u0430 \u0446\u0435\u043B \u0435
      \u0434\u0430 \u043F\u043E\u0434\u0433\u043E\u0442\u0432\u0438\u043C \u043F\u043E\u0434\u0431\u0440\u0430\u043D\u0438
      \u0433\u0440\u0443\u043F\u0438 \u0434\u0430 \u0441\u0435 \u0431\u043E\u0440\u044F\u0442
      \u0441 \u0434\u0435\u0437\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430.
      \u0412\u0430\u0448\u0438\u0442\u0435 \u0433\u043E\u0434\u0438\u043D\u0438 \u0438
      \u043E\u043F\u0438\u0442 \u0432\u0438 \u043F\u0440\u0430\u0432\u044F\u0442
      \u0438\u0434\u0435\u0430\u043B\u043D\u0438\u044F \u0447\u043E\u0432\u0435\u043A
      \u0437\u0430 \u0442\u0430\u0437\u0438 \u043C\u0438\u0441\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778371
    m_Localized: "\u041E.\u0410.\u0414.\u0421 \u0432\u0438 \u043E\u0431\u0443\u0447\u0430\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778372
    m_Localized: "\u0412\u044A\u0437\u0440\u0430\u0441\u0442\u043D\u0438\u0442\u0435
      \u0445\u043E\u0440\u0430 \u0441\u0430 \u0438\u0437\u0442\u043E\u0447\u043D\u0438\u043A
      \u043D\u0430 \u0437\u043D\u0430\u043D\u0438\u044F \u0438 \u0432\u0438\u043D\u0430\u0433\u0438
      \u0441\u0430 \u0433\u043E\u0442\u043E\u0432\u0438 \u0434\u0430 \u043F\u043E\u043C\u043E\u0433\u043D\u0430\u0442
      \u043D\u0430 \u0431\u043B\u0438\u0437\u043A\u0438\u0442\u0435 \u0441\u0438
      \u0432 \u0442\u0440\u0443\u0434\u043D\u0438 \u043C\u043E\u043C\u0435\u043D\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778373
    m_Localized: "\u0417\u0430\u043F\u043E\u0447\u0432\u0430\u043C\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778374
    m_Localized: "\u041D\u0430\u043C\u0438\u0440\u0430\u043C\u0435 \u0441\u0435 \u0432
      \u043C\u043E\u043C\u0435\u043D\u0442 \u043D\u0430 \u043A\u0440\u0438\u0437\u0430
      \u0438 \u0438\u043C\u0430\u043C\u0435 \u043D\u0443\u0436\u0434\u0430 \u043E\u0442
      \u0432\u0430\u0448\u0430\u0442\u0430 \u043F\u043E\u043C\u043E\u0449. \u0416\u0438\u0432\u0435\u0435\u043C
      \u0432\u044A\u0432 \u0432\u0440\u0435\u043C\u0435\u043D\u0430 \u043D\u0430
      \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u0438 \u0440\u0430\u0437\u043D\u043E\u0433\u043B\u0430\u0441\u0438\u044F,
      \u0430 \u0435\u0434\u0438\u043D \u043E\u0442 \u043E\u0441\u043D\u043E\u0432\u043D\u0438\u0442\u0435
      \u0444\u0430\u043A\u0442\u043E\u0440\u0438 \u0435 \u0434\u0435\u0437\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 9858758222778376
    m_Localized: "\u0414\u0435\u0437\u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F\u0442\u0430
      \u0441\u0435 \u0440\u0430\u0437\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0432\u0430
      \u043A\u0430\u0442\u043E \u043F\u043E\u0436\u0430\u0440 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0435\u043D\u0438\u0435
      \u043D\u0430 \u043D\u043E\u0432\u0438\u0442\u0435 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438,
      \u043A\u0430\u0442\u043E \u043C\u043E\u0431\u0438\u043B\u043D\u0438\u0442\u0435
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0438 \u0441 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442
      \u0434\u043E\u0441\u0442\u044A\u043F."
    m_Metadata:
      m_Items: []
