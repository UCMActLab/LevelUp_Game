  - m_Id: 9763233173504
    m_Localized: "\u0427\u0415\u0422\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 9763237367808
    m_Localized: "\u0421\u041F\u041E\u0414\u0415\u041B\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 9763237367809
    m_Localized: "\u041F\u0420\u0415\u0421\u041A\u041E\u0427\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 410822712418304
    m_Localized: "\u0410\u041D\u0422\u041E\u041D\u0418\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 410822779527168
    m_Localized: "\u041A\u0410\u0420\u041B\u041E\u0421"
    m_Metadata:
      m_Items: []
  - m_Id: 410822779527169
    m_Localized: "\u041F\u0415\u0414\u0420\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 410822779527170
    m_Localized: "\u0425\u041E\u0420\u0425\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 410822779527171
    m_Localized: "\u041C\u0418\u0413\u0415\u041B"
    m_Metadata:
      m_Items: []
  - m_Id: 410822779527172
    m_Localized: "\u0418\u0421\u041C\u0410\u0415\u041B"
    m_Metadata:
      m_Items: []
  - m_Id: 410822779527173
    m_Localized: "\u0424\u0415\u0414\u0415\u0420\u0418\u041A\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 410822779527174
    m_Localized: "\u0414\u0410\u0412\u0418\u0414"
    m_Metadata:
      m_Items: []
  - m_Id: 410822779527175
    m_Localized: "\u041C\u0410\u0420\u0418\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 410822779527176
    m_Localized: "\u041C\u0410\u0420\u0422\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 410822779527177
    m_Localized: "\u041A\u0410\u0420\u041B\u041E\u0422\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 410822779527178
    m_Localized: "\u0410\u041B\u0418\u0421\u0418\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 410822779527179
    m_Localized: "\u0410\u041D\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 410822779527180
    m_Localized: "\u0418\u041D\u041C\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 410822779527181
    m_Localized: "\u0418\u0421\u0410\u0411\u0415\u041B"
    m_Metadata:
      m_Items: []
  - m_Id: 410822779527182
    m_Localized: "\u041A\u0410\u0420\u041B\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 410822779527183
    m_Localized: "\u0412\u044F\u0440\u0432\u0430\u0448 \u043B\u0438 \u0432 \u0442\u0435\u0437\u0438
      \u043D\u0435\u0449\u0430? \u041A\u0430\u043A\u044A\u0432 \u0441\u0440\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721472
    m_Localized: "\u0422\u043E\u0432\u0430 \u043D\u044F\u043C\u0430 \u0441\u043C\u0438\u0441\u044A\u043B,
      \u043F\u0440\u043E\u0447\u0435\u0442\u0435 \u043B\u0438 \u0433\u043E \u0438\u0437\u043E\u0431\u0449\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721473
    m_Localized: "\u041D\u0435 \u043C\u0438 \u0438\u0437\u043F\u0440\u0430\u0449\u0430\u0439
      \u0442\u0430\u043A\u0438\u0432\u0430 \u043D\u0435\u0449\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721474
    m_Localized: "\u0418\u0437\u043F\u0440\u0430\u0442\u0438 \u043D\u0435\u0449\u043E,
      \u043A\u043E\u0435\u0442\u043E \u0441\u0438 \u0441\u0442\u0440\u0443\u0432\u0430
      \u0434\u0430 \u0441\u0435 \u043F\u0440\u043E\u0447\u0435\u0442\u0435, \u0437\u0430\u0449\u043E\u0442\u043E
      \u0442\u043E\u0432\u0430 \u043D\u044F\u043C\u0430 \u043D\u0438\u043A\u0430\u043A\u044A\u0432
      \u0441\u043C\u0438\u0441\u044A\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721475
    m_Localized: "\u041D\u0430\u043C\u0438\u0440\u0430\u043C \u0442\u0430\u0437\u0438
      \u0441\u0442\u0430\u0442\u0438\u044F \u0437\u0430 \u043E\u0441\u043E\u0431\u0435\u043D\u043E
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721476
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u043C\u043D\u043E\u0433\u043E,
      \u0447\u0435 \u044F \u0441\u043F\u043E\u0434\u0435\u043B\u0438, \u0442\u0440\u044F\u0431\u0432\u0430
      \u0434\u0430 \u0432\u043D\u0438\u043C\u0430\u0432\u0430\u043C\u0435 \u0437\u0430
      \u0442\u0430\u043A\u0438\u0432\u0430 \u043D\u0435\u0449\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721477
    m_Localized: "\u041A\u043E\u043B\u043A\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E!
      \u0412\u0438\u043D\u0430\u0433\u0438 \u0441\u0438 \u043D\u0430\u0449\u0440\u0435\u043A
      \u0437\u0430 \u0442\u0430\u043A\u0438\u0432\u0430 \u043D\u0435\u0449\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721478
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F, \u0447\u0435
      \u0433\u043E \u0438\u0437\u043F\u0440\u0430\u0442\u0438, \u043D\u044F\u043C\u0430\u0445
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721479
    m_Localized: "\u0417\u0434\u0440\u0430\u0432\u0435\u0439! \u0422\u043E\u0432\u0430
      \u0441\u044A\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u0431\u0438 \u0431\u0438\u043B\u043E
      \u0440\u0435\u0430\u043A\u0446\u0438\u044F \u043D\u0430 \u0441\u0442\u0430\u0442\u0438\u044F\u0442\u0430,
      \u043A\u043E\u044F\u0442\u043E \u0438\u0437\u043F\u0440\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721480
    m_Localized: "\u0410\u0437 \u0441\u044A\u043C \u0442\u0432\u043E\u0439 \u043F\u043E\u0437\u043D\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721481
    m_Localized: "\u0412\u0441\u044A\u0449\u043D\u043E\u0441\u0442 \u043D\u0435 \u0441\u044A\u0449\u0435\u0441\u0442\u0432\u0443\u0432\u0430\u043C
      \u0438 \u043D\u044F\u043C\u0430\u043C \u043D\u0438\u0449\u043E \u043E\u0431\u0449\u043E
      \u0441 \u043D\u0438\u043A\u043E\u0433\u043E \u0441\u044A\u0441 \u0441\u044A\u0449\u043E\u0442\u043E
      \u0438\u043C\u0435 \u0438\u0437\u0432\u044A\u043D \u0442\u043E\u0432\u0430
      \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721482
    m_Localized: "\u0414\u043E\u0431\u0440\u043E \u0443\u0442\u0440\u043E! \u0410\u0437
      \u0441\u044A\u043C \u043E\u0449\u0435 \u0435\u0434\u043D\u0430 \u043E\u0442
      \u0442\u0432\u043E\u0438\u0442\u0435 \u043F\u043E\u0437\u043D\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721483
    m_Localized: "\u0422\u0443\u043A \u0449\u0435 \u0442\u0438 \u043A\u0430\u0437\u0432\u0430\u043C\u0435
      \u043A\u0430\u043A\u0432\u043E \u043C\u0438\u0441\u043B\u0438\u043C \u0437\u0430
      \u0441\u0442\u0430\u0442\u0438\u0438\u0442\u0435, \u043A\u043E\u0438\u0442\u043E
      \u043D\u0438 \u0438\u0437\u043F\u0440\u0430\u0449\u0430\u0448."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721484
    m_Localized: "\u0417\u0430\u0441\u0435\u0433\u0430 \u0449\u0435 \u0441\u0435
      \u0432\u044A\u0440\u043D\u0435\u043C \u043D\u0430 \u0433\u043B\u0430\u0432\u043D\u0430\u0442\u0430
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430, \u043A\u044A\u0434\u0435\u0442\u043E
      \u0431\u0435\u0448\u0435 \u043F\u0440\u0435\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721485
    m_Localized: "\u0417\u0430 \u0434\u0430 \u0433\u043E \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u0448,
      \u043D\u0430\u0442\u0438\u0441\u043D\u0438 \u0431\u0443\u0442\u043E\u043D\u0430
      \u201E\u041D\u0410\u0417\u0410\u0414\u201C \u0432 \u0433\u043E\u0440\u043D\u0430\u0442\u0430
      \u0447\u0430\u0441\u0442 \u043D\u0430 \u0442\u043E\u0437\u0438 \u0447\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 410822783721486
    m_Localized: "\u041E\u043F\u0438\u0442\u0430\u0439!"
    m_Metadata:
      m_Items: []
