  - m_Id: 14494645251137544
    m_Localized: "\u0413\u0440\u0443\u043F\u0430 \u0441\u044A\u0441\u0435\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 14494645251137545
    m_Localized: "\u0421\u043B\u0435\u0434\u0432\u0430\u0449\u0430 \u0441\u0442\u044A\u043F\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 14598736433614848
    m_Localized: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0435\u043D\u0438 \u0441\u0430
      \u0437\u0430\u0431\u0430\u0432\u044F\u043D\u0438\u044F \u0432 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\u0442\u043E
      \u043D\u0430 \u043C\u043E\u0437\u044A\u043A\u0430 \u043F\u0440\u0438 \u0434\u0435\u0446\u0430,
      \u0447\u0438\u0438\u0442\u043E \u043C\u0430\u0439\u043A\u0438 \u0441\u0430
      \u0431\u0438\u043B\u0438 \u0437\u0430\u0440\u0430\u0437\u0435\u043D\u0438 \u0441
      COVID-19 \u043F\u043E \u0432\u0440\u0435\u043C\u0435 \u043D\u0430 \u0431\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0441\u0442\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140800
    m_Localized: "\u041F\u0440\u0438 5-\u0433\u043E\u0434\u0438\u0448\u043D\u0438\u0442\u0435
      \u0434\u0435\u0446\u0430, \u043A\u043E\u0438\u0442\u043E \u0441\u0430 \u0441\u0435
      \u0437\u0430\u0440\u0430\u0437\u0438\u043B\u0438 \u0441 \u0432\u0438\u0440\u0443\u0441\u0430
      \u043D\u0430 COVID-19 \u043F\u043E \u0432\u0440\u0435\u043C\u0435 \u043D\u0430
      \u0431\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0441\u0442\u0442\u0430 \u043D\u0430
      \u043C\u0430\u0439\u043A\u0438\u0442\u0435 \u0441\u0438 (\u043F\u043E \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u0435)
      \u0438 \u043F\u0440\u0435\u0434\u0438 \u043F\u044A\u0440\u0432\u0438\u0442\u0435
      \u0432\u0430\u043A\u0441\u0438\u043D\u0430\u0446\u0438\u0438 \u043F\u043E \u0432\u0440\u0435\u043C\u0435
      \u043D\u0430 \u043F\u0430\u043D\u0434\u0435\u043C\u0438\u044F\u0442\u0430,
      \u0441\u0435 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0432\u0430 10-\u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043D\u043E
      \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u043D\u0430 \u0441\u043B\u0443\u0447\u0430\u0438\u0442\u0435
      \u043D\u0430 \u0437\u0430\u0431\u0430\u0432\u044F\u043D\u0435 \u0432 \u043A\u043E\u0433\u043D\u0438\u0442\u0438\u0432\u043D\u043E\u0442\u043E
      \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435, \u0433\u043B\u0430\u0432\u043D\u043E
      \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0442\u0430 \u043D\u0430 \u0443\u0447\u0435\u043D\u0435\u0442\u043E
      \u0438 \u043F\u0430\u043C\u0435\u0442\u0442\u0430. \u0422\u043E\u0432\u0430
      \u0435 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0442\u043E \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
      \u043E\u0442 \u043D\u043E\u0432\u0430\u0442\u043E\u0440\u0441\u043A\u043E \u043F\u0440\u043E\u0443\u0447\u0432\u0430\u043D\u0435
      \u043E\u0442\u043D\u043E\u0441\u043D\u043E \u0435\u0444\u0435\u043A\u0442\u0438\u0442\u0435
      \u043E\u0442 \u043F\u0430\u043D\u0434\u0435\u043C\u0438\u044F\u0442\u0430 \u043D\u0430
      \u0432\u0438\u0440\u0443\u0441\u0430 SARS-CoV-2 \u043F\u043E \u0432\u0440\u0435\u043C\u0435
      \u043D\u0430 \u0431\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0441\u0442\u0442\u0430,
      \u043A\u043E\u0435\u0442\u043E \u0435 \u0440\u044A\u043A\u043E\u0432\u043E\u0434\u0435\u043D\u043E
      \u043E\u0442 \u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u0430 \u043F\u043E
      \u043D\u0435\u0432\u0440\u043E\u043D\u0430\u0443\u043A\u0438 \u043A\u044A\u043C
      CSIC."
    m_Metadata:
      m_Items: []
  - m_Id: 14598736488140801
    m_Localized: "\u0414\u043E\u0431\u0440\u0435, \u0447\u0435 \u0431\u0440\u0430\u0442\u043E\u0432\u0447\u0435\u0434\u043A\u0430\u0442\u0430
      \u0442\u0438 \u0441\u0435 \u0435 \u0432\u0430\u043A\u0441\u0438\u043D\u0438\u0440\u0430\u043B\u0430."
