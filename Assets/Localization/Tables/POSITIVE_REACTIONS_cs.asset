  m_TableData:
  - m_Id: 20960436224
    m_Localized: "Tento \u010Dl\xE1nek mi p\u0159ipad\xE1 obzvl\xE1\u0161\u0165 zaj\xEDmav\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796352
    m_Localized: "D\u011Bkuji moc za sd\xEDlen\xED, na takov\xE9 v\u011Bci je t\u0159eba
      d\xE1vat pozor."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796353
    m_Localized: "Jak zaj\xEDmav\xE9! V\u017Edycky jsi pozorn\xFD k t\u011Bmto v\u011Bcem."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796354
    m_Localized: "D\u011Bkuji, \u017Ee jsi to poslal, v\u016Fbec jsem o tom nev\u011Bd\u011Bl(a)."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796355
    m_Localized: PLEASE FILL
