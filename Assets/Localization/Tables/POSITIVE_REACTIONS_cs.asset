--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: POSITIVE_REACTIONS_cs
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: cs
  m_SharedData: {fileID: 11400000, guid: 43fb5ec62adf86d46892bb303e4d54a3, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 20960436224
    m_Localized: "Tento \u010Dl\xE1nek mi p\u0159ipad\xE1 obzvl\xE1\u0161\u0165 zaj\xEDmav\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796352
    m_Localized: "D\u011Bkuji moc za sd\xEDlen\xED, na takov\xE9 v\u011Bci je t\u0159eba
      d\xE1vat pozor."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796353
    m_Localized: "Jak zaj\xEDmav\xE9! V\u017Edycky jsi pozorn\xFD k t\u011Bmto v\u011Bcem."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796354
    m_Localized: "D\u011Bkuji, \u017Ee jsi to poslal, v\u016Fbec jsem o tom nev\u011Bd\u011Bl(a)."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796355
    m_Localized: "Ah, to je to, co chci vid\u011Bt."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796356
    m_Localized: "U\u017E jsem to vid\u011Bl, ale stejn\u011B d\u011Bkuji."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796357
    m_Localized: "Tak to se mi l\xEDb\xED, lidi, co mysl\xED stejn\u011B jako j\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796358
    m_Localized: "To je pravda, a\u0165 se to v\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796359
    m_Localized: "To potvrzuje to, co jsem ji\u017E tu\u0161il."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796360
    m_Localized: "D\u011Bkujeme za zasl\xE1n\xED, po\u0161lete n\xE1m dal\u0161\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796361
    m_Localized: "O tom jsem nev\u011Bd\u011Bl, ale je dobr\xE9 b\xFDt informov\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796362
    m_Localized: "D\u011Bkuji za sd\xEDlen\xED, vezmu to v \xFAvahu."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796363
    m_Localized: "D\u011Bkujeme za informace, je s tebou radost spolupracovat."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796364
    m_Localized: "Dob\u0159e, jsem r\xE1d, \u017Ee je v\xEDc lid\xED, kte\u0159\xED
      to vid\xED stejn\u011B jako j\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796365
    m_Localized: "Ano, d\u011Bkuji."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796366
    m_Localized: "Jsem r\xE1d, \u017Ee jsi v obraze, co se t\xFD\u010De novinek."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796367
    m_Localized: "U\u017E jsem to vid\u011Bl, ale nen\xED na \u0161kodu to d\xE1l
      sd\xEDlet."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796368
    m_Localized: "Vid\u011Bl jsem n\u011Bco podobn\xE9ho, d\xEDky za p\u0159ipomenut\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796369
    m_Localized: "Moji p\u0159\xE1tel\xE9 o tom mluvili, tento \u010Dl\xE1nek to
      potvrzuje."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796370
    m_Localized: "D\xEDky za sd\xEDlen\xED. Je hezk\xE9 vid\u011Bt, \u017Ee se zaj\xEDm\xE1\u0161
      o novinky."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796371
    m_Localized: "Skv\u011Bl\xE9, d\u011Bkuji."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796372
    m_Localized: "D\u011Bkujeme za informace."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796373
    m_Localized: "U\u017E jsem to \u010Detl, ale je dobr\xE9, aby se to d\xE1l \u0161\xED\u0159ilo."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796374
    m_Localized: "D\u011Bkuji za informaci."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796375
    m_Localized: "Moc d\u011Bkuji!"
    m_Metadata:
      m_Items: []
  - m_Id: 20989796376
    m_Localized: "To je zaj\xEDmav\xE9! D\u011Bkuji."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796377
    m_Localized: "No, to jsem nev\u011Bd\u011Bl."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796378
    m_Localized: "Nech\xE1m si to na pozd\u011Bji."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796379
    m_Localized: "Hele, cht\u011Bl bych se o tom dozv\u011Bd\u011Bt v\xEDc, d\xEDky."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796380
    m_Localized: "Ano, n\u011Bco jsem o tom sly\u0161el."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796381
    m_Localized: "D\u011Bkujeme za sd\xEDlen\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796382
    m_Localized: "Dob\u0159e, d\u011Bkuji."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796383
    m_Localized: "To je ale n\xE1hoda! D\u011Bkuji."
    m_Metadata:
      m_Items: []
  - m_Id: 20989796384
    m_Localized: "To je k zamy\u0161len\xED, d\u011Bkuji ti za to."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
